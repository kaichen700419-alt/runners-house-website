{
  "$comment": "Lighthouse CI 設定。本地預設不執行（無 Chrome 環境），主要供 GitHub Actions 跑。執行：npm run test:perf",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/rooms/index.html",
        "http://localhost/rooms/standard-double/index.html",
        "http://localhost/rooms/standard-quad/index.html",
        "http://localhost/rooms/backpack-4/index.html",
        "http://localhost/rooms/backpack-6/index.html",
        "http://localhost/rooms/sea-suite/index.html",
        "http://localhost/runners/index.html",
        "http://localhost/charging/index.html",
        "http://localhost/nearby/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/en/index.html",
        "http://localhost/en/contact/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "uses-http2": "off",
        "is-on-https": "off",
        "redirects-http": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
