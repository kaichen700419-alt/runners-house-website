---
/**
 * SectionHeading 元件 v3 — Editorial
 *
 * 區塊主標 + 副標 + 銅金細線視覺錨點。
 *
 * 與 v2 差異：
 *   - 移除舊版「左側 4px 垂直色帶 / 水平 3px 漸層色條」（過於 cookie-cutter）
 *   - 改為精品民宿風的「銅金細線 1px + 大字距小寫 eyebrow（可選）」
 *   - 標題襯線體 + 寬字距，:lang(en) 自動切換 Cormorant Garamond italic
 *   - 副標 italic display 字、line-height 2.0 散文感
 */
interface Props {
  /** 主標題文字 */
  title: string;
  /** 副標題（lead）文字；可省略 */
  subtitle?: string;
  /** 標題語意層級（h2 / h3）；預設 h2 */
  level?: 'h2' | 'h3';
  /** 對齊方式；預設 left */
  align?: 'left' | 'center';
  /** 主題色彩變體；保留以兼容舊呼叫端，但 v3 視覺上幾乎無差 */
  variant?: 'ocean' | 'wabi';
  /** 主標題 id，供外層 section 以 aria-labelledby 串接 a11y 名稱 */
  id?: string;
  /** 上方 eyebrow 文字（可選，常為 mono caps） */
  eyebrow?: string;
}

const {
  title,
  subtitle,
  level = 'h2',
  align = 'left',
  variant: _variant = 'wabi',
  id,
  eyebrow,
} = Astro.props;

const HeadingTag = level;
---

<header class:list={['section-heading', `align-${align}`]}>
  {eyebrow ? <span class="eyebrow">{eyebrow}</span> : null}
  {align === 'center' && !eyebrow ? <span class="rule-gold rule-gold-center" aria-hidden="true"></span> : null}
  <HeadingTag class="title" id={id}>{title}</HeadingTag>
  {subtitle ? <p class="subtitle">{subtitle}</p> : null}
  {align === 'left' && !eyebrow ? <span class="rule-gold under" aria-hidden="true"></span> : null}
</header>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-block: 0 2.75rem;
  }
  .align-left { text-align: left; align-items: flex-start; }
  .align-center { text-align: center; align-items: center; }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    color: var(--color-ink-900);
    line-height: 1.18;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 500;
  }
  .subtitle {
    margin: 0;
    max-width: 46rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--color-ink-600);
    line-height: 2;
    font-style: italic;
    font-weight: 300;
    letter-spacing: 0.015em;
  }
  .align-center .subtitle {
    margin-inline: auto;
  }
  /* eyebrow 細字大字距 */
  .section-heading .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
    font-weight: 500;
  }
  /* 左對齊時，標題下方放一條短銅金線當錨點 */
  .rule-gold.under {
    margin-top: 0.4rem;
  }
</style>
