---
/**
 * ImagePlaceholder 元件 v3
 *
 * 業主未提供實景照片，全站圖片改用此元件渲染。
 * 設計語言更新（v3）：
 *   - 拋棄漸層 + 點狀紋理的「色塊感」
 *   - 改為精品民宿風的「米色 + 銅金細線描邊」幾何
 *   - 中央 minimal 符號（圓 / 方 / 線）+ 小字「PHOTO COMING SOON」
 *   - 配上極細的銅金內框，呼應 Aman / Hoshinoya 的留白語彙
 *
 * variant 參數仍保留以兼容呼叫端，但視覺差異已收斂為微妙的色相層次，
 * 不再是強烈飽和色塊；避免「每張卡片大色塊強搶版面」的失衡感。
 */
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
  /** 圖片 alt 文字（用於 aria-label 與中央 caption） */
  alt: string;
  /** 寬高比；預設 16:9 */
  ratio?: '1:1' | '4:3' | '16:9' | '21:9' | '3:4';
  /** 主題色相變體；預設 ocean。v3 改為極微差色相，視覺上接近一致 */
  variant?: 'ocean' | 'sand' | 'timber' | 'ink';
  /** 是否顯示「PHOTO COMING SOON」標籤；預設 true */
  showBadge?: boolean;
}

const {
  locale,
  alt,
  ratio = '16:9',
  variant = 'ocean',
  showBadge = true,
} = Astro.props;
const t = useTranslations(locale);

const ratioMap: Record<NonNullable<Props['ratio']>, string> = {
  '1:1': '1 / 1',
  '4:3': '4 / 3',
  '16:9': '16 / 9',
  '21:9': '21 / 9',
  '3:4': '3 / 4',
};
const aspectRatio = ratioMap[ratio];
const badgeText = t('common.photoComingSoon');

/**
 * variant 對應幾何符號：
 *   ocean   → 雙圓（海平面 + 太陽）
 *   sand    → 單水平線（沙岸）
 *   timber  → 細直線格（木紋）
 *   ink     → 細十字（指北）
 * 全部以單色銅金描繪，不填色，呼應「線稿筆記本」的精品手稿感
 */
const symbol = variant;
---

<figure
  class:list={['placeholder', `variant-${variant}`]}
  style={`--placeholder-aspect: ${aspectRatio};`}
  role="img"
  aria-label={alt}
>
  {/* 背景：純色米底（依 variant 微調，不再用漸層） */}
  <div class="bg" aria-hidden="true"></div>

  {/* 銅金內框：1px 細線，內縮 12px，呼應藝廊裝裱感 */}
  <div class="frame" aria-hidden="true"></div>

  {/* 中央 minimal 幾何符號 */}
  <svg class="symbol" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    {symbol === 'ocean' && (
      <>
        <line x1="20" y1="62" x2="80" y2="62" stroke="currentColor" stroke-width="0.6" />
        <circle cx="50" cy="44" r="9" fill="none" stroke="currentColor" stroke-width="0.6" />
      </>
    )}
    {symbol === 'sand' && (
      <>
        <line x1="20" y1="55" x2="80" y2="55" stroke="currentColor" stroke-width="0.6" />
        <line x1="30" y1="62" x2="70" y2="62" stroke="currentColor" stroke-width="0.6" opacity="0.5" />
      </>
    )}
    {symbol === 'timber' && (
      <>
        <line x1="40" y1="30" x2="40" y2="70" stroke="currentColor" stroke-width="0.6" />
        <line x1="50" y1="32" x2="50" y2="68" stroke="currentColor" stroke-width="0.6" opacity="0.7" />
        <line x1="60" y1="34" x2="60" y2="66" stroke="currentColor" stroke-width="0.6" opacity="0.5" />
      </>
    )}
    {symbol === 'ink' && (
      <>
        <line x1="50" y1="35" x2="50" y2="65" stroke="currentColor" stroke-width="0.6" />
        <line x1="35" y1="50" x2="65" y2="50" stroke="currentColor" stroke-width="0.6" />
        <circle cx="50" cy="50" r="14" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.6" />
      </>
    )}
  </svg>

  {/* 中央 caption：小字 + 寬字距，僅作為說明而非搶眼 */}
  <figcaption class="caption">
    <span class="caption-text">{alt}</span>
  </figcaption>

  {showBadge ? <span class="badge">{badgeText}</span> : null}
</figure>

<style>
  .placeholder {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: var(--placeholder-aspect);
    overflow: hidden;
    isolation: isolate;
    /* 不再 round 大圓角，改為 4px 收斂感 */
    border-radius: 2px;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 各 variant 用米色系微差，整體視覺一致；避免色塊堆疊 */
  .variant-ocean .bg { background-color: #e8e2d3; }
  .variant-sand .bg { background-color: #ede5d2; }
  .variant-timber .bg { background-color: #dfd5c0; }
  .variant-ink .bg { background-color: #2a2722; }

  .frame {
    position: absolute;
    inset: 12px;
    border: 1px solid var(--color-copper-500);
    pointer-events: none;
  }
  .variant-ink .frame {
    border-color: var(--color-copper-400);
    opacity: 0.65;
  }

  .symbol {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -56%);
    width: 64px;
    height: 64px;
    color: var(--color-copper-500);
    opacity: 0.85;
  }
  .variant-ink .symbol {
    color: var(--color-copper-400);
    opacity: 0.75;
  }

  .caption {
    position: absolute;
    inset: auto 0 22%;
    padding: 0 2rem;
    text-align: center;
  }
  .caption-text {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    color: var(--color-ink-700);
    line-height: 1.5;
    max-width: 32ch;
    letter-spacing: 0.04em;
  }
  .variant-ink .caption-text {
    color: var(--color-bone-200);
  }

  .badge {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
  }
  .variant-ink .badge {
    color: var(--color-copper-300);
  }
</style>
