---
/**
 * ImagePlaceholder v5 — 「精品民宿等待照片框」
 *
 * 業主強烈反饋：v4 的「線稿圖示 / 火柴人」看起來像兒童畫、placeholder 不像 placeholder。
 * v5 重做策略（依精品民宿（Aman / Hoshinoya）真實官網的「無照片占位」做法）：
 *   1. 拋棄所有 SVG 場景線稿（晨曦圓 / 海浪 / 跑者 stick figure / 米倉屋頂等）
 *   2. 改成「真正像 placeholder 的 placeholder」：
 *      - 大色塊主背景（米色 / 海洋藍 / 深炭灰可選 variant）
 *      - 內縮細邊框 1px（精品手稿感）
 *      - 中央顯示「具體尺寸（依比例計算）」+ 一行中文 caption + 一個極小的相機 SVG（24px）
 *      - 角落顯示極小的「PHOTO COMING SOON」標籤
 *      - 對角細線（Photo crop guide 風格）做為視覺定位
 *   3. 一看就懂「這裡將要放真實照片」，不會被誤認成插畫
 *
 * 設計重點：
 *   - 不再用 line-art SVG 場景，避免兒童畫感
 *   - caption 顯示「即將呈現的內容（alt）」+ 「實景照片即將更新」+ 尺寸像素標示
 *   - hover 略微增亮邊框，給互動回饋
 *   - 嚴格遵守研究報告 E 禁忌：無圓角、無 box-shadow、無漸層
 */
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
  alt: string;
  ratio?: '1:1' | '4:3' | '16:9' | '21:9' | '3:4';
  /** variant：sand 米色 / ocean 海藍 / timber 沙金 / ink 深炭（hero 用） */
  variant?: 'ocean' | 'sand' | 'timber' | 'ink';
  showBadge?: boolean;
}

const {
  locale,
  alt,
  ratio = '16:9',
  variant = 'sand',
  showBadge = true,
} = Astro.props;
const t = useTranslations(locale);

// === 比例 → CSS aspect-ratio 字串 + 對應「假想實景照尺寸」 ===
// 顯示在 placeholder 中央的 px 規格，模擬「等待中的照片框」的真實感
const ratioMap: Record<NonNullable<Props['ratio']>, { aspect: string; px: string }> = {
  '1:1':  { aspect: '1 / 1',   px: '1200 × 1200' },
  '4:3':  { aspect: '4 / 3',   px: '1600 × 1200' },
  '16:9': { aspect: '16 / 9',  px: '1920 × 1080' },
  '21:9': { aspect: '21 / 9',  px: '2520 × 1080' },
  '3:4':  { aspect: '3 / 4',   px: '1200 × 1600' },
};
const { aspect, px } = ratioMap[ratio];

// 「實景陸續更新」字串（中英共用 i18n key common.photoComingSoon）
const badgeText = t('common.photoComingSoon');
// 角落英文小標 — 不入 i18n，純視覺裝飾
const cornerLabel = 'PHOTO · COMING SOON';
---

<figure
  class:list={['placeholder', `variant-${variant}`]}
  style={`--placeholder-aspect: ${aspect};`}
  role="img"
  aria-label={alt}
>
  {/* 純色主背景 */}
  <div class="bg" aria-hidden="true"></div>

  {/* 細邊框（內縮 12px，精品手稿感） */}
  <div class="frame" aria-hidden="true"></div>

  {/* 對角線細線（攝影 crop guide 風格）— 兩條極淡的對角，給「等待中構圖」的感覺 */}
  <svg class="crop-guide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <line x1="0" y1="0" x2="100" y2="100" />
    <line x1="100" y1="0" x2="0" y2="100" />
  </svg>

  {/* 四個角落的 L 型 corner mark（攝影對焦框風格） */}
  <span class="corner corner-tl" aria-hidden="true"></span>
  <span class="corner corner-tr" aria-hidden="true"></span>
  <span class="corner corner-bl" aria-hidden="true"></span>
  <span class="corner corner-br" aria-hidden="true"></span>

  {/* === 中央資訊區 === */}
  <div class="center" aria-hidden="true">
    {/* 極小相機 icon（24px） */}
    <svg class="cam-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false">
      <rect x="2.5" y="6.5" width="19" height="13" rx="0.5" />
      <path d="M8.5 6.5 L9.8 4.5 L14.2 4.5 L15.5 6.5" stroke-linejoin="round" />
      <circle cx="12" cy="13" r="3.5" />
      <circle cx="12" cy="13" r="1" fill="currentColor" />
      <line x1="18" y1="9" x2="19.5" y2="9" stroke-linecap="round" />
    </svg>
    {/* 尺寸像素標示（mono 字體） */}
    <span class="size-text">{px}</span>
    {/* 中文 caption（即將呈現的內容） */}
    <figcaption class="caption">{alt}</figcaption>
    {/* 「實景陸續更新」副標 */}
    {showBadge ? <span class="hint">{badgeText}</span> : null}
  </div>

  {/* 角落極小標籤（mono caps） */}
  <span class="corner-label" aria-hidden="true">{cornerLabel}</span>
</figure>

<style>
  .placeholder {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: var(--placeholder-aspect);
    overflow: hidden;
    isolation: isolate;
    border-radius: 0;
  }

  /* === 主背景（各 variant 微差色相，避開色塊堆疊） === */
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .variant-sand   .bg { background-color: #ece6d8; }
  .variant-ocean  .bg { background-color: #d8dee0; }   /* 海洋灰藍 placeholder */
  .variant-timber .bg { background-color: #e2dac3; }
  .variant-ink    .bg { background-color: #1f1f1b; }

  /* === 內縮細邊框（精品裝裱框） === */
  .frame {
    position: absolute;
    inset: 12px;
    border: 1px solid var(--color-sea-500);
    pointer-events: none;
    opacity: 0.45;
  }
  .variant-ink .frame {
    border-color: var(--color-sun-400);
    opacity: 0.4;
  }

  /* === 對角線 crop guide（攝影構圖輔助線） === */
  .crop-guide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--color-sea-500);
    stroke-width: 0.15;
    opacity: 0.18;
    pointer-events: none;
  }
  .variant-ink .crop-guide {
    stroke: var(--color-sun-400);
    opacity: 0.18;
  }

  /* === 四角 L 型對焦框 === */
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    pointer-events: none;
  }
  .corner::before,
  .corner::after {
    content: '';
    position: absolute;
    background-color: var(--color-sea-500);
    opacity: 0.7;
  }
  .corner::before { width: 100%; height: 1px; }
  .corner::after  { height: 100%; width: 1px; }
  .corner-tl { top: 22px; left: 22px; }
  .corner-tl::before { top: 0; left: 0; }
  .corner-tl::after  { top: 0; left: 0; }
  .corner-tr { top: 22px; right: 22px; }
  .corner-tr::before { top: 0; right: 0; }
  .corner-tr::after  { top: 0; right: 0; }
  .corner-bl { bottom: 22px; left: 22px; }
  .corner-bl::before { bottom: 0; left: 0; }
  .corner-bl::after  { bottom: 0; left: 0; }
  .corner-br { bottom: 22px; right: 22px; }
  .corner-br::before { bottom: 0; right: 0; }
  .corner-br::after  { bottom: 0; right: 0; }
  .variant-ink .corner::before,
  .variant-ink .corner::after {
    background-color: var(--color-sun-400);
    opacity: 0.65;
  }

  /* === 中央資訊區 === */
  .center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 1.5rem 2rem;
    text-align: center;
    color: var(--color-ink-700);
  }
  .variant-ink .center { color: var(--color-sand-200); }

  /* 相機 icon */
  .cam-icon {
    width: 26px;
    height: 26px;
    color: var(--color-sea-500);
    opacity: 0.7;
    margin-bottom: 0.2rem;
  }
  .variant-ink .cam-icon {
    color: var(--color-sun-300);
    opacity: 0.85;
  }

  /* 尺寸像素 — JetBrains Mono 強化「規格框」感 */
  .size-text {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--color-sea-500);
    opacity: 0.85;
    font-weight: 500;
    line-height: 1;
  }
  .variant-ink .size-text {
    color: var(--color-sun-300);
    opacity: 0.95;
  }

  /* 中文 caption（要呈現的場景描述） */
  .caption {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    color: var(--color-ink-800);
    line-height: 1.5;
    max-width: 28ch;
    letter-spacing: 0.02em;
    font-weight: 500;
  }
  :lang(en) .caption {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .variant-ink .caption {
    color: var(--color-sand-100);
  }

  /* 「實景陸續更新」 hint */
  .hint {
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--color-ink-500);
    letter-spacing: 0.04em;
    font-style: italic;
  }
  :lang(en) .hint {
    font-family: var(--font-display-en);
  }
  .variant-ink .hint {
    color: var(--color-sand-300);
  }

  /* 角落極小英文標籤 */
  .corner-label {
    position: absolute;
    bottom: 14px;
    right: 14px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.32em;
    color: var(--color-sun-500);
    text-transform: uppercase;
    opacity: 0.85;
  }
  .variant-ink .corner-label {
    color: var(--color-sun-300);
  }
</style>
