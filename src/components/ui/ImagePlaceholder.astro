---
/**
 * ImagePlaceholder v4 — 海風礦物 / 無照片視覺策略 D2
 *
 * 業主未提供實景照片，全站圖片改用此元件渲染。
 * 設計依據：研究報告 D2 無攝影視覺策略 1+4
 *   - 拋棄漸層 + 點狀紋理
 *   - 改為「沙白紙質 + 線稿幾何 + 細邊海洋灰藍框」精品手稿感
 *   - 中央 SVG 線稿符號（依 variant 切換）
 *   - 底部 PHOTO COMING SOON 小字（mono 字距 0.36em）
 *   - 全部用配色 A 海洋灰藍細線 + 晨曦橘小符號
 *   - 拋棄 box-shadow，遵守研究報告 E 禁忌 3
 */
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
  alt: string;
  ratio?: '1:1' | '4:3' | '16:9' | '21:9' | '3:4';
  variant?: 'ocean' | 'sand' | 'timber' | 'ink';
  showBadge?: boolean;
}

const {
  locale,
  alt,
  ratio = '16:9',
  variant = 'ocean',
  showBadge = true,
} = Astro.props;
const t = useTranslations(locale);

const ratioMap: Record<NonNullable<Props['ratio']>, string> = {
  '1:1': '1 / 1',
  '4:3': '4 / 3',
  '16:9': '16 / 9',
  '21:9': '21 / 9',
  '3:4': '3 / 4',
};
const aspectRatio = ratioMap[ratio];
const badgeText = t('common.photoComingSoon');

/**
 * variant 對應 SVG 線稿主題：
 *   ocean   → 海平線 + 晨曦圓（呼應海岸）
 *   sand    → 雙重水平線（沙岸層次）
 *   timber  → 米倉木紋直線格 + 屋簷三角
 *   ink     → 跑者剪影（hero 二級用）
 */
const symbol = variant;
---

<figure
  class:list={['placeholder', `variant-${variant}`]}
  style={`--placeholder-aspect: ${aspectRatio};`}
  role="img"
  aria-label={alt}
>
  {/* 紙質底色 */}
  <div class="bg" aria-hidden="true"></div>

  {/* 細邊海洋灰藍裝裱框（內縮 14px） */}
  <div class="frame" aria-hidden="true"></div>

  {/* 中央 SVG 線稿 */}
  <svg class="symbol" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    {symbol === 'ocean' && (
      <>
        {/* 晨曦圓 + 海平線 + 海浪柔線 */}
        <circle cx="100" cy="78" r="22" fill="none" stroke="currentColor" stroke-width="0.7" />
        <line x1="40" y1="116" x2="160" y2="116" stroke="currentColor" stroke-width="0.6" />
        <path d="M40,132 C70,124 100,140 130,132 C150,127 160,138 160,134"
              fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.7" />
        <path d="M40,148 C75,140 105,154 135,148 C150,144 160,152 160,150"
              fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
      </>
    )}
    {symbol === 'sand' && (
      <>
        {/* 沙岸層次 — 三條漸近水平線 */}
        <line x1="44" y1="100" x2="156" y2="100" stroke="currentColor" stroke-width="0.6" />
        <line x1="56" y1="116" x2="144" y2="116" stroke="currentColor" stroke-width="0.5" opacity="0.7" />
        <line x1="68" y1="130" x2="132" y2="130" stroke="currentColor" stroke-width="0.4" opacity="0.5" />
        {/* 一個小石點 */}
        <circle cx="128" cy="100" r="1.4" fill="currentColor" opacity="0.6" />
      </>
    )}
    {symbol === 'timber' && (
      <>
        {/* 米倉屋頂三角 + 木紋直線 */}
        <path d="M55,100 L100,60 L145,100 L145,150 L55,150 Z" fill="none" stroke="currentColor" stroke-width="0.7" />
        <line x1="80" y1="100" x2="80" y2="150" stroke="currentColor" stroke-width="0.5" opacity="0.7" />
        <line x1="100" y1="100" x2="100" y2="150" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
        <line x1="120" y1="100" x2="120" y2="150" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
      </>
    )}
    {symbol === 'ink' && (
      <>
        {/* 跑者線稿 stick figure（hero 用） */}
        <g transform="translate(95, 70)" stroke="currentColor" stroke-width="1" stroke-linecap="round" fill="none">
          <circle cx="0" cy="0" r="9" />
          <line x1="0" y1="9" x2="-3" y2="42" />
          <line x1="-3" y1="42" x2="14" y2="64" />
          <line x1="-3" y1="42" x2="-18" y2="62" />
          <line x1="0" y1="18" x2="14" y2="30" />
          <line x1="0" y1="18" x2="-14" y2="32" />
        </g>
        {/* 海平線 */}
        <line x1="40" y1="160" x2="160" y2="160" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
      </>
    )}
  </svg>

  {/* 中央 caption */}
  <figcaption class="caption">
    <span class="caption-text">{alt}</span>
  </figcaption>

  {showBadge ? <span class="badge">{badgeText}</span> : null}
</figure>

<style>
  .placeholder {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: var(--placeholder-aspect);
    overflow: hidden;
    isolation: isolate;
    border-radius: 0;        /* 嚴格遵守研究報告 C 章節 4px / 0px 一致性 */
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* 各 variant 沙白系微差色相，避免色塊堆疊（E 禁忌 2） */
  .variant-ocean .bg { background-color: #ece6d8; }
  .variant-sand .bg { background-color: #efe8d6; }
  .variant-timber .bg { background-color: #e2dac3; }
  .variant-ink .bg { background-color: #1f1f1b; }

  .frame {
    position: absolute;
    inset: 14px;
    border: 1px solid var(--color-sea-500);
    pointer-events: none;
    opacity: 0.55;
  }
  .variant-ink .frame {
    border-color: var(--color-sun-400);
    opacity: 0.45;
  }

  .symbol {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -56%);
    width: 56%;
    height: auto;
    color: var(--color-sea-500);
    opacity: 0.85;
  }
  .variant-ink .symbol {
    color: var(--color-sun-400);
    opacity: 0.85;
  }

  .caption {
    position: absolute;
    inset: auto 0 22%;
    padding: 0 2rem;
    text-align: center;
  }
  .caption-text {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    color: var(--color-ink-700);
    line-height: 1.5;
    max-width: 32ch;
    letter-spacing: 0.04em;
  }
  :lang(en) .caption-text {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .variant-ink .caption-text {
    color: var(--color-sand-200);
  }

  .badge {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.36em;
    color: var(--color-sun-500);
    text-transform: uppercase;
  }
  .variant-ink .badge {
    color: var(--color-sun-300);
  }
</style>
