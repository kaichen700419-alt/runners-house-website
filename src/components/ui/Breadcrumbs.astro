---
/**
 * Breadcrumbs v4 — Mineral Coast
 *
 * 顯示視覺化麵包屑；Schema.org BreadcrumbList JSON-LD 由 BaseLayout
 * 透過 props.breadcrumbs 自動產生，避免兩處重複。
 *
 * v4：海洋灰藍分隔符 + 晨曦橘 hover line + mono caps 字距
 */
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

export interface BreadcrumbLink {
  label: string;
  href?: string;
}

interface Props {
  locale: Locale;
  items: ReadonlyArray<BreadcrumbLink>;
}

const { locale, items } = Astro.props;
const t = useTranslations(locale);
const homeHref = getLocalizedPath('/', locale);
const separator = t('ui.breadcrumbSeparator');
---

<nav class="breadcrumbs" aria-label="breadcrumb">
  <ol>
    <li>
      <a href={homeHref}>{t('ui.breadcrumbHome')}</a>
      <span class="sep" aria-hidden="true">{separator}</span>
    </li>
    {
      items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        const href = item.href ? getLocalizedPath(item.href, locale) : undefined;
        return (
          <li>
            {isLast || !href ? (
              <span aria-current="page" class="current">{item.label}</span>
            ) : (
              <>
                <a href={href}>{item.label}</a>
                <span class="sep" aria-hidden="true">{separator}</span>
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    padding-block: 1.5rem;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  a {
    color: var(--color-ink-500);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 0.1rem;
    transition: color 280ms var(--ease-editorial), border-color 280ms var(--ease-editorial);
  }
  a:hover {
    color: var(--color-sun-500);
    border-bottom-color: var(--color-sun-400);
  }
  .current {
    color: var(--color-sea-500);
  }
  .sep {
    color: var(--color-sun-400);
    user-select: none;
    font-family: var(--font-display);
  }
</style>
