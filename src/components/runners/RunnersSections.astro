---
/**
 * RunnersSections — Editorial v3
 *
 * 跑者主場頁主體：簡介 + 賽事 + 路線 + 公共設施。
 * 視覺改為 Editorial（沉穩 charcoal + 銅金細線 + 大量留白），
 * 不再 cookie-cutter ocean/sand 區塊堆疊。
 *
 * 內容真值：services array 改為 3 項真實公共設施
 *   serviceLaundry / serviceKitchen / serviceParking
 * （業主已將舊 6 項假承諾從字典中移除）
 */
import { getCollection } from 'astro:content';
import { useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const racesAll = await getCollection('races');
const routesAll = await getCollection('routes');
if (!racesAll.length) {
  throw new Error('[content] races collection 為空');
}
if (!routesAll.length) {
  throw new Error('[content] routes collection 為空');
}
const races = racesAll
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.id.localeCompare(b.data.id));
const routes = routesAll
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.id.localeCompare(b.data.id));

// 公共設施：洗衣 / 廚房 / 停車（業主確認的真實項目）
const services = [
  { titleKey: 'runners.serviceLaundryTitle', bodyKey: 'runners.serviceLaundryBody' },
  { titleKey: 'runners.serviceKitchenTitle', bodyKey: 'runners.serviceKitchenBody' },
  { titleKey: 'runners.serviceParkingTitle', bodyKey: 'runners.serviceParkingBody' },
];

const difficultyLabel = {
  easy: t('runners.difficultyEasy'),
  moderate: t('runners.difficultyMedium'),
  hard: t('runners.difficultyHard'),
} as const;

const monthUnit = t('runners.monthUnit');

/**
 * 月份顯示：中文「5 月」、英文用月份縮寫「May」。
 * 修法依據：全站健檢發現英文版 monthUnit 為單一空格，
 * 造成賽事月份顯示成孤兒數字「5 」缺乏語意。
 */
const MONTH_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] as const;
function formatMonth(month: number): string {
  if (locale === 'en') {
    return MONTH_EN[month - 1] ?? String(month);
  }
  return `${month}${monthUnit}`;
}
---

<article class="runners" aria-labelledby="runners-page-heading">
  <header class="page-header container-wide reveal">
    <div class="chapter-mark">
      <span class="num">III</span>
      <span class="label">{locale === 'en' ? 'CHAPTER · A RUNNER’S HOME' : 'CHAPTER · 跑者主場'}</span>
    </div>
    <h1 id="runners-page-heading" class="page-title">{t('runners.pageTitle')}</h1>
    <p class="page-lead">{t('runners.pageLead')}</p>
    <span class="brand-statement">{t('runners.eyebrow')}</span>
  </header>

  <section class="intro" aria-labelledby="runners-intro-heading">
    <div class="container-wide intro-grid">
      <div class="visual">
        <ImagePlaceholder locale={locale} alt={t('runners.introHeading')} ratio="3:4" variant="ocean" />
      </div>
      <div class="content">
        <SectionHeading id="runners-intro-heading" title={t('runners.introHeading')} variant="wabi" />
        <p>{t('runners.introBody')}</p>
      </div>
    </div>
  </section>

  <section class="events" aria-labelledby="runners-events-heading">
    <div class="container-wide">
      <SectionHeading
        id="runners-events-heading"
        title={t('runners.eventsHeading')}
        subtitle={t('runners.eventsLead')}
        align="center"
        variant="wabi"
      />
      <ul class="event-rows">
        {
          races.map((race, idx) => {
            const name = locale === 'en' ? race.data.name_en : race.data.name_zh;
            const desc = locale === 'en' ? race.data.description_en : race.data.description_zh;
            const num = String(idx + 1).padStart(2, '0');
            return (
              <li class="event-row">
                <span class="event-num" aria-hidden="true">{num}</span>
                <div class="event-meta-col">
                  <span class="event-month">{formatMonth(race.data.month)}</span>
                  <h3 class="event-name">{name}</h3>
                  <p class="event-distance">{race.data.distance}</p>
                </div>
                <div class="event-body">
                  <p class="event-desc">{desc}</p>
                  <a class="event-link" href={race.data.registrationUrl} target="_blank" rel="noopener noreferrer">
                    {t('ui.moreInfo')}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="routes" aria-labelledby="runners-routes-heading">
    <div class="container-wide">
      <SectionHeading
        id="runners-routes-heading"
        title={t('runners.routesHeading')}
        subtitle={t('runners.routesLead')}
        align="center"
        variant="wabi"
      />
      <ul class="route-grid">
        {
          routes.map((route) => {
            const name = locale === 'en' ? route.data.name_en : route.data.name_zh;
            const desc = locale === 'en' ? route.data.description_en : route.data.description_zh;
            return (
              <li class={`route-card diff-${route.data.difficulty}`}>
                <h3 class="route-name">{name}</h3>
                <span class="rule-gold" aria-hidden="true"></span>
                <dl class="route-meta">
                  <div>
                    <dt>{t('runners.routesDistanceLabel')}</dt>
                    <dd>{route.data.distance}</dd>
                  </div>
                  <div>
                    <dt>{t('runners.routesElevationLabel')}</dt>
                    <dd>{route.data.elevation}</dd>
                  </div>
                  <div>
                    <dt>{t('runners.routesDifficultyLabel')}</dt>
                    <dd>{difficultyLabel[route.data.difficulty]}</dd>
                  </div>
                </dl>
                <p class="route-desc">{desc}</p>
                <a class="route-link" href={route.data.mapUrl} target="_blank" rel="noopener noreferrer">
                  {t('runners.routesMapCta')}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="services" aria-labelledby="runners-services-heading">
    <div class="container-wide">
      <SectionHeading id="runners-services-heading" title={t('runners.servicesHeading')} align="center" variant="wabi" />
      <ul class="service-grid">
        {
          services.map((s, i) => {
            const num = String(i + 1).padStart(2, '0');
            return (
              <li class="service-card">
                <span class="service-num" aria-hidden="true">{num}</span>
                <h3 class="service-name">{t(s.titleKey)}</h3>
                <p class="service-body">{t(s.bodyKey)}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</article>

<style>
  .runners {
    background-color: var(--color-sand-50);
    padding-bottom: 8rem;
  }
  .page-header {
    padding-block: 5rem 4rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 1024px) {
    .page-header { padding-block: 6.5rem 5rem; }
  }
  .page-header .chapter-mark {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .page-header .chapter-mark .num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-sun-400);
    letter-spacing: -0.02em;
    line-height: 0.9;
    font-weight: 400;
  }
  .page-header .chapter-mark .label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    font-weight: 500;
    line-height: 1.05;
  }
  :lang(en) .page-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .page-lead {
    margin: 0;
    max-width: 36rem;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.85;
    font-style: italic;
    font-weight: 300;
  }
  :lang(en) .page-lead { font-family: var(--font-display-en); }
  .brand-statement {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-sun-500);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    border-top: 1px solid var(--color-sun-400);
    padding-top: 1rem;
    width: fit-content;
  }

  section { padding-block: 4rem; }
  section + section {
    border-top: 1px solid rgb(213 207 194 / 0.15);
  }

  /* === intro === */
  .intro { background-color: var(--color-bone-100); }
  .intro-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 768px) {
    .intro-grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 5rem;
    }
  }
  .visual { overflow: hidden; }
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-ink-700);
    font-size: 1.02rem;
    line-height: 2;
  }
  .content p { margin: 0; max-width: 38rem; }

  /* === events: editorial horizontal rows === */
  .event-rows {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .event-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 3rem 0;
    border-top: 1px solid rgb(213 207 194 / 0.2);
    align-items: start;
  }
  .event-row:last-child {
    border-bottom: 1px solid rgb(213 207 194 / 0.2);
  }
  @media (min-width: 768px) {
    .event-row {
      grid-template-columns: 80px 280px 1fr;
      gap: 3rem;
      padding: 4rem 0;
    }
  }
  .event-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-copper-500);
    line-height: 1;
    font-weight: 300;
    letter-spacing: 0.02em;
  }
  .event-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .event-month {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-copper-600);
  }
  .event-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    line-height: 1.25;
    font-weight: 400;
  }
  :lang(en) .event-name {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .event-distance {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }
  .event-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .event-desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.98rem;
    line-height: 1.95;
    max-width: 36rem;
  }
  .event-link {
    align-self: flex-start;
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
    transition: color 280ms var(--ease-editorial);
  }
  .event-link:hover { color: var(--color-ink-900); }

  /* === routes === */
  .routes { background-color: var(--color-bone-100); }
  .route-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) { .route-grid { grid-template-columns: repeat(3, 1fr); } }
  .route-card {
    padding: 2.5rem 2rem;
    background-color: var(--color-bone-50);
    border-top: 2px solid;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .diff-easy { border-color: var(--color-difficulty-easy); }
  .diff-moderate { border-color: var(--color-difficulty-medium); }
  .diff-hard { border-color: var(--color-difficulty-hard); }
  .route-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .route-name {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .route-meta {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    grid-template-columns: repeat(3, 1fr);
    font-size: 0.78rem;
  }
  .route-meta div { display: flex; flex-direction: column; gap: 0.2rem; }
  .route-meta dt {
    color: var(--color-ink-500);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.6rem;
  }
  .route-meta dd { margin: 0; color: var(--color-ink-800); font-weight: 500; font-size: 0.85rem; }
  .route-desc {
    margin: 0;
    color: var(--color-ink-600);
    font-size: 0.93rem;
    line-height: 1.95;
  }
  .route-link {
    align-self: flex-start;
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
  }
  .route-link:hover { color: var(--color-ink-900); }

  /* === services (3-up minimal cards with editorial number) === */
  .service-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) { .service-grid { grid-template-columns: repeat(3, 1fr); } }
  .service-card {
    padding: 2.5rem 2rem;
    background-color: var(--color-bone-50);
    border: 1px solid rgb(213 207 194 / 0.18);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .service-num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-copper-500);
    font-weight: 300;
    letter-spacing: 0.04em;
  }
  .service-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 500;
  }
  :lang(en) .service-name {
    font-family: var(--font-display-en);
  }
  .service-body {
    margin: 0;
    color: var(--color-ink-600);
    font-size: 0.93rem;
    line-height: 1.95;
  }
</style>
