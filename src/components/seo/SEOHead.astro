---
/**
 * SEOHead 元件
 *
 * 集中管理：
 *  - title / meta description / canonical
 *  - Open Graph、Twitter Card
 *  - hreflang（zh-TW / en / x-default）
 *  - robots、theme-color、預設 favicon
 *
 * BaseLayout 會把當前語系與路徑透過 props 傳入；本元件不直接讀取 Astro.url 之外的全域狀態。
 */
import { SITE } from '@/lib/site';
import { getAlternateLocaleUrl } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  /** 完整 <title>（包含品牌） */
  title: string;
  /** meta description */
  description: string;
  /** 當前頁面相對路徑（例：/about、/en/about） */
  pathname: string;
  /** 當前語系 */
  locale: Locale;
  /** OG 圖片相對或絕對 URL；未提供／空字串時 fallback 至 SITE.defaultOgImage */
  image?: string;
  /**
   * robots meta 指令（純字串）。
   * 例：`'index, follow'`、`'noindex, nofollow'`、`'index, follow, max-image-preview:large'`
   * 維持為 string 而非 union literal 是為了支援 Google 不時新增的指令（max-snippet 等）。
   */
  robots?: string;
  /** OG 類型；預設 website */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  pathname,
  locale,
  image,
  robots = 'index, follow, max-image-preview:large',
  ogType = 'website',
} = Astro.props;

// 計算 canonical 與雙語對等網址
const canonicalUrl = new URL(pathname, SITE.url).toString();
const zhUrl = new URL(getAlternateLocaleUrl(pathname, 'zh-TW'), SITE.url).toString();
const enUrl = new URL(getAlternateLocaleUrl(pathname, 'en'), SITE.url).toString();
// 空字串 / 全空白要視為「未提供」，否則會產出 og:image="" 這種對 Facebook/Slack 等 unfurler 致命的標籤。
const resolvedImage = image && image.trim() ? image : SITE.defaultOgImage;
// 重要：相對路徑必須補上 import.meta.env.BASE_URL 子路徑前綴
// （否則 GitHub Pages 部署時 og:image 會掉到 https://...github.io/og/... 而非 .../runners-house-website/og/...）
const baseUrlRaw = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const imageWithBase = resolvedImage.startsWith('http')
  ? resolvedImage
  : `${baseUrlRaw}${resolvedImage.startsWith('/') ? '' : '/'}${resolvedImage}`;
const ogImageUrl = imageWithBase.startsWith('http')
  ? imageWithBase
  : new URL(imageWithBase, SITE.url).toString();
const ogLocale = locale === 'en' ? SITE.ogLocaleEn : SITE.ogLocaleZh;
const ogLocaleAlternate = locale === 'en' ? SITE.ogLocaleZh : SITE.ogLocaleEn;
const siteName = locale === 'en' ? SITE.nameEn : SITE.nameZh;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{/* theme-color 必須為 plain 色值，無法引用 CSS 變數；此值需與 global.css --color-ocean-900 同步 */}
<meta name="theme-color" content="#0c4a6e" />

<link rel="canonical" href={canonicalUrl} />
{/* favicon 必須含 base 子路徑（GitHub Pages 部署於 /runners-house-website/ 子路徑下）— MiniMax 健檢 #5 修復 */}
<link rel="icon" type="image/svg+xml" href={`${baseUrlRaw}/favicon.svg`} />
{/* apple-touch-icon 暫不輸出：未提供 180x180 PNG；用 SVG 會在 iOS 顯示異常，待業主提供圖檔後補上 */}

{/* hreflang：zh-TW、en、x-default */}
<link rel="alternate" hreflang="zh-Hant-TW" href={zhUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={zhUrl} />

{/* Open Graph */}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
{/* og:image 規格：1200×630 為 Facebook / LinkedIn / Slack 共同建議；
    若日後設計團隊提供其他尺寸圖檔，需同步更新此處與 SITE.defaultOgImage 來源。 */}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />
