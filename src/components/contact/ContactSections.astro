---
/**
 * ContactSections
 *
 * 聯絡頁主體：CtaTrio → ContactForm → 完整聯絡資訊 → Google Maps。
 *
 * 表單採 client-side 驗證（contact-validators 純函式）+ AJAX POST 至 Web3Forms。
 * 提交按鈕滾動位置：CTA 按鈕「Email 表單」用 anchor `#contact-form`。
 *
 * 重點：
 *  - access_key 透過 PUBLIC_WEB3FORMS_KEY 環境變數注入；本地預設 placeholder，
 *    PROD build 時若仍為 placeholder 會 console.warn（不阻擋 build，因業主可能還在開發）
 *  - 所有欄位錯誤訊息 inline 渲染於對應欄位下方，aria-describedby 串連 a11y
 *  - submit 成功 / 失敗皆 inline 顯示，失敗附「重試」按鈕；不使用 alert
 *  - 蜂蜜罐 botcheck 加 tabindex="-1" + aria-hidden 確保鍵盤與 AT 跳過
 *  - 預留 captcha 欄位註解（業主未來啟用 hCaptcha / Turnstile 時填入 sitekey 即可）
 *  - check_in 動態調整 check_out.min（隔日起跳）
 */
import { useTranslations } from '@/i18n/utils';
import { CONTACT, GEO } from '@/lib/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lineUrl = CONTACT.lineUrl;
const phone = CONTACT.phonePrimary;
const phoneTel = CONTACT.phonePrimaryTel;
const phone2 = CONTACT.phoneSecondary;
const phone2Tel = CONTACT.phoneSecondaryTel;
const lineId = CONTACT.lineId;
const mapQuery = encodeURIComponent(`${GEO.latitude},${GEO.longitude}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${locale === 'en' ? 'en' : 'zh-TW'}&z=14&output=embed`;

// 今日日期字串（本地時區 yyyy-mm-dd），用於 date input min 屬性，避免使用者選到過去日期
const now = new Date();
const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;

// 電話 HTML5 pattern：與 contact-validators.ts 的 phone regex 完全一致。
// 用 const 變數 + 雙反斜線確保 build 後輸出 HTML attribute 仍保留 `\d`，
// 避免 Astro / esbuild 將 attribute 字面值的 `\d` 在編譯期間吞掉。
const phonePattern = '^(09\\d{8}|0[1-8]\\d{7,8}|\\+886\\d{9})$';

// Web3Forms access_key：透過環境變數覆蓋，業主上線前必須設定 PUBLIC_WEB3FORMS_KEY
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? 'YOUR_WEB3FORMS_KEY';
if (import.meta.env.PROD && web3formsKey === 'YOUR_WEB3FORMS_KEY') {
  // 不阻擋 build；業主可能仍在預覽開發版本
  // 真正的告警會出現在伺服器/CI 構建記錄中
  console.warn('[contact] PUBLIC_WEB3FORMS_KEY 仍為 placeholder，表單提交將失敗');
}

const roomOptions: Array<{ value: string; key: string }> = [
  { value: '', key: 'contact.formRoomOptionAny' },
  { value: 'standard-double', key: 'contact.formRoomOptionDoubleStandard' },
  { value: 'standard-quad', key: 'contact.formRoomOptionQuadStandard' },
  { value: 'backpack-4', key: 'contact.formRoomOptionBackpack4' },
  { value: 'backpack-6', key: 'contact.formRoomOptionBackpack6' },
  { value: 'sea-suite', key: 'contact.formRoomOptionSeaSuite' },
];
const subjectOptions: Array<{ value: string; key: string }> = [
  { value: 'booking', key: 'contact.formSubjectBooking' },
  { value: 'charging', key: 'contact.formSubjectCharging' },
  { value: 'collab', key: 'contact.formSubjectCollab' },
  { value: 'media', key: 'contact.formSubjectMedia' },
  { value: 'other', key: 'contact.formSubjectOther' },
];

// 用於 client script 的錯誤訊息字典（事先序列化為 JSON，
// 嵌入 <script type="application/json"> 後由 client 端讀取，避免 client 重複載入 i18n 模組）
const clientI18n = {
  errorDict: {
    errorRequired: t('contact.errorRequired'),
    errorEmail: t('contact.errorEmail'),
    errorPhone: t('contact.errorPhone'),
    errorMessageMin: t('contact.errorMessageMin'),
    errorMessageMax: t('contact.errorMessageMax'),
    errorCheckInPast: t('contact.errorCheckInPast'),
    errorCheckOutBeforeIn: t('contact.errorCheckOutBeforeIn'),
    errorGuestsRange: t('contact.errorGuestsRange'),
  },
  successText: t('contact.successMessage'),
  errorText: t('contact.errorMessage'),
  retryText: t('contact.formRetryLabel'),
};
---

<article class="contact" aria-labelledby="contact-page-heading">
  <header class="page-header container-wide">
    <h1 id="contact-page-heading" class="page-title">{t('contact.pageTitle')}</h1>
    <p class="page-lead">{t('contact.pageLead')}</p>
  </header>

  <section class="cta-trio" aria-labelledby="cta-trio-heading">
    <div class="container-wide">
      <SectionHeading id="cta-trio-heading" title={t('contact.ctaTrioHeading')} align="center" variant="ocean" />
      <ul class="trio">
        <li class="trio-card line">
          <span class="badge">L</span>
          <h3>{t('contact.ctaTrioLineTitle')}</h3>
          <p>{t('contact.ctaTrioLineBody')}</p>
          <a class="trio-btn" href={lineUrl} target="_blank" rel="noopener noreferrer">
            {t('common.addLine')}
          </a>
        </li>
        <li class="trio-card phone">
          <span class="badge">☎</span>
          <h3>{t('contact.ctaTrioPhoneTitle')}</h3>
          <p>{t('contact.ctaTrioPhoneBody')}</p>
          <a class="trio-btn" href={`tel:${phoneTel}`}>
            {phone}
          </a>
        </li>
        <li class="trio-card form">
          <span class="badge">@</span>
          <h3>{t('contact.ctaTrioFormTitle')}</h3>
          <p>{t('contact.ctaTrioFormBody')}</p>
          <a class="trio-btn" href="#contact-form">
            {t('contact.formSubmitLabel')}
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="form-section" aria-labelledby="form-section-heading">
    <div class="container-wide form-wrap">
      <SectionHeading
        id="form-section-heading"
        title={t('contact.formHeading')}
        subtitle={t('contact.formLead')}
        variant="ocean"
      />

      <form
        id="contact-form"
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        novalidate
      >
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="from_name" value="Runners House Website" />
        <input
          type="hidden"
          name="subject"
          value={locale === 'en'
            ? '[Runners House] New inquiry from website'
            : '[跑者之家] 官網新詢問'}
        />
        {/* 蜂蜜罐：人類使用者不應填寫，bot 會誤以為要填的欄位；
            tabindex="-1" + aria-hidden 確保鍵盤導覽與 AT 完全跳過 */}
        <input
          type="checkbox"
          name="botcheck"
          class="botcheck"
          tabindex="-1"
          aria-hidden="true"
          autocomplete="off"
        />
        {/*
         * 預留 captcha 欄位（業主未來啟用 hCaptcha / Turnstile 時放上對應 widget）
         * Web3Forms 支援 h-captcha-response 欄位驗證；啟用後須在 Web3Forms 後台啟用 captcha。
         * <div class="h-captcha" data-captcha="true"></div>
         * <script src="https://web3forms.com/client/script.js" async defer></script>
         */}

        <div class="row">
          <label class="field">
            <span class="label-text">
              {t('contact.formNameLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="text"
              name="name"
              required
              minlength="1"
              maxlength="80"
              placeholder={t('contact.formNamePlaceholder')}
              autocomplete="name"
              aria-describedby="err-name"
            />
            <span id="err-name" class="error-msg" role="alert"></span>
          </label>
        </div>

        <div class="row two">
          <label class="field">
            <span class="label-text">
              {t('contact.formEmailLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="email"
              name="email"
              required
              placeholder={t('contact.formEmailPlaceholder')}
              autocomplete="email"
              aria-describedby="err-email"
            />
            <span id="err-email" class="error-msg" role="alert"></span>
          </label>
          <label class="field">
            <span class="label-text">
              {t('contact.formPhoneLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="tel"
              name="phone"
              required
              pattern={phonePattern}
              placeholder={t('contact.formPhonePlaceholder')}
              autocomplete="tel"
              aria-describedby="err-phone"
            />
            <span id="err-phone" class="error-msg" role="alert"></span>
          </label>
        </div>

        <div class="row two">
          <label class="field">
            <span class="label-text">
              {t('contact.formCheckInLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="date"
              name="check_in"
              required
              min={today}
              aria-describedby="err-check_in"
            />
            <span id="err-check_in" class="error-msg" role="alert"></span>
          </label>
          <label class="field">
            <span class="label-text">
              {t('contact.formCheckOutLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="date"
              name="check_out"
              required
              min={today}
              aria-describedby="err-check_out"
            />
            <span id="err-check_out" class="error-msg" role="alert"></span>
          </label>
        </div>

        <div class="row two">
          <label class="field">
            <span class="label-text">
              {t('contact.formGuestsLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <input
              type="number"
              name="guests"
              required
              min="1"
              max="10"
              step="1"
              value="2"
              aria-describedby="err-guests guests-hint"
            />
            <span id="guests-hint" class="hint-text">{t('contact.formGuestsHint')}</span>
            <span id="err-guests" class="error-msg" role="alert"></span>
          </label>
          <label class="field">
            <span class="label-text">
              {t('contact.formRoomLabel')}
              <span class="optional" aria-hidden="true">{t('ui.optional')}</span>
            </span>
            <select name="room_preference" aria-describedby="err-room_preference">
              {roomOptions.map((opt) => (
                <option value={opt.value}>{t(opt.key)}</option>
              ))}
            </select>
            <span id="err-room_preference" class="error-msg" role="alert"></span>
          </label>
        </div>

        <div class="row">
          <label class="field">
            <span class="label-text">
              {t('contact.formSubjectLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <select name="subject_topic" required aria-describedby="err-subject_topic">
              {subjectOptions.map((opt) => (
                <option value={opt.value}>{t(opt.key)}</option>
              ))}
            </select>
            <span id="err-subject_topic" class="error-msg" role="alert"></span>
          </label>
        </div>

        <div class="row">
          <label class="field">
            <span class="label-text">
              {t('contact.formMessageLabel')}
              <span class="req" aria-hidden="true">{t('ui.required')}</span>
            </span>
            <textarea
              name="message"
              required
              minlength="10"
              maxlength="2000"
              rows="6"
              placeholder={t('contact.formMessagePlaceholder')}
              aria-describedby="err-message"
            ></textarea>
            <span id="err-message" class="error-msg" role="alert"></span>
          </label>
        </div>

        <p class="privacy">{t('contact.formPrivacyNote')}</p>

        <button class="submit" type="submit">{t('contact.formSubmitLabel')}</button>

        {/* 結果訊息區：成功或失敗時 inline 顯示，不使用 alert */}
        <div
          id="contact-result"
          class="result"
          role="status"
          aria-live="polite"
          hidden
        ></div>
      </form>
    </div>
  </section>

  <section class="info-section" aria-labelledby="info-section-heading">
    <div class="container-wide">
      <SectionHeading id="info-section-heading" title={t('contact.contactInfoHeading')} variant="ocean" />
      <p class="prefer">{t('contact.contactPreferLine')}</p>
      <dl class="info-grid">
        <div>
          <dt>{t('contact.contactInfoAddress')}</dt>
          <dd>{t('contact.contactInfoAddressValue')}</dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoPhonePrimary')}</dt>
          <dd><a href={`tel:${phoneTel}`}>{phone}</a></dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoPhoneSecondary')}</dt>
          <dd><a href={`tel:${phone2Tel}`}>{phone2}</a></dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoLine')}</dt>
          <dd><a href={lineUrl} target="_blank" rel="noopener noreferrer">{lineId}</a></dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoCheckIn')}</dt>
          <dd>{t('contact.contactInfoCheckInValue')}</dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoOffice')}</dt>
          <dd>{t('contact.contactInfoOfficeValue')}</dd>
        </div>
        <div>
          <dt>{t('contact.contactInfoBookingOpen')}</dt>
          <dd>{t('contact.contactInfoBookingOpenValue')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="map-section" aria-label={t('contact.mapTitle')}>
    <div class="container-wide map-wrap">
      <iframe
        title={t('contact.mapTitle')}
        src={mapEmbedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        sandbox="allow-scripts allow-same-origin allow-popups"
        width="100%"
        height="420"
      ></iframe>
    </div>
  </section>
</article>

{/*
 * Client i18n payload：以 application/json 嵌入頁面，由下方 module script 讀取。
 * 這樣可以保留 i18n 字串於 SSR 階段，又讓 module script 維持「無 attribute」
 * 以利 Astro / Vite 處理 ESM import（contact-validators 才能正確 bundle）。
 */}
<script is:inline type="application/json" id="contact-i18n-payload" set:html={JSON.stringify(clientI18n)}></script>

{/*
 * Client-side 驗證 + AJAX 提交腳本：
 *  - 載入 contact-validators 純函式（與伺服器端共用同一驗證邏輯）
 *  - submit 時 preventDefault → 驗證 → 失敗顯示 inline 錯誤 → 通過則 fetch POST
 *  - 成功 → 顯示綠色成功訊息並 reset 表單；失敗 → 顯示紅色訊息含「重試」按鈕
 *  - check_in change 事件動態調整 check_out 最小值（強制隔日起）
 *
 * 不加任何 attribute（包含 type="module"）以讓 Astro 走預設處理鏈，
 * vite 會把 import 路徑解析、bundle、加 hash，避免 production 找不到 .ts 原始檔。
 */}
<script>
  import { validateContactForm } from '@/lib/contact-validators';

  interface ClientI18n {
    errorDict: Record<string, string>;
    successText: string;
    errorText: string;
    retryText: string;
  }

  function readI18n(): ClientI18n {
    const node = document.getElementById('contact-i18n-payload');
    if (!node) {
      // 若 payload 缺漏，仍提供最基本英文字串以利使用者看到提示
      return {
        errorDict: {},
        successText: 'Got it — we will reply within 24 hours.',
        errorText: 'Submission failed. Please try again.',
        retryText: 'Retry',
      };
    }
    try {
      return JSON.parse(node.textContent ?? '{}');
    } catch {
      // i18n payload 損壞 fallback：必須給有意義字串避免使用者看到空白訊息誤判狀態
      return {
        errorDict: {},
        successText: 'Sent. We will reply soon.',
        errorText: 'Submission failed. Please try again or contact us directly.',
        retryText: 'Retry',
      };
    }
  }

  function setFieldError(
    form: HTMLFormElement,
    i18n: ClientI18n,
    name: string,
    errorKey: string | null,
  ) {
    const input = form.elements.namedItem(name);
    const errSpan = form.querySelector(`#err-${name}`);
    if (!errSpan) return;
    if (errorKey) {
      errSpan.textContent = i18n.errorDict[errorKey] ?? errorKey;
      errSpan.classList.add('show');
      if (input instanceof HTMLElement) {
        input.setAttribute('aria-invalid', 'true');
      }
    } else {
      errSpan.textContent = '';
      errSpan.classList.remove('show');
      if (input instanceof HTMLElement) {
        input.removeAttribute('aria-invalid');
      }
    }
  }

  function clearAllErrors(form: HTMLFormElement) {
    form.querySelectorAll('.error-msg').forEach((el) => {
      el.textContent = '';
      el.classList.remove('show');
    });
    form.querySelectorAll('[aria-invalid="true"]').forEach((el) => {
      el.removeAttribute('aria-invalid');
    });
  }

  function showResult(
    form: HTMLFormElement,
    i18n: ClientI18n,
    type: 'success' | 'error',
    message: string,
  ) {
    const box = form.querySelector('#contact-result');
    if (!(box instanceof HTMLElement)) return;
    box.hidden = false;
    box.className = `result result-${type}`;
    if (type === 'error') {
      box.innerHTML = '';
      const text = document.createElement('span');
      text.textContent = message;
      const retryBtn = document.createElement('button');
      retryBtn.type = 'button';
      retryBtn.className = 'retry-btn';
      retryBtn.textContent = i18n.retryText;
      retryBtn.addEventListener('click', () => {
        box.hidden = true;
        box.textContent = '';
      });
      box.appendChild(text);
      box.appendChild(retryBtn);
    } else {
      box.textContent = message;
    }
  }

  function initContactForm() {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement)) return;
    const i18n = readI18n();

    // check_in 變更時，強制 check_out 最小值為隔日（避免使用者選到同日或更早）
    const checkIn = form.elements.namedItem('check_in');
    const checkOut = form.elements.namedItem('check_out');
    if (checkIn instanceof HTMLInputElement && checkOut instanceof HTMLInputElement) {
      checkIn.addEventListener('change', () => {
        if (!checkIn.value) return;
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(checkIn.value);
        if (!m) return;
        const next = new Date(
          Number(m[1]),
          Number(m[2]) - 1,
          Number(m[3]) + 1,
        );
        const ny = next.getFullYear();
        const nm = String(next.getMonth() + 1).padStart(2, '0');
        const nd = String(next.getDate()).padStart(2, '0');
        checkOut.min = `${ny}-${nm}-${nd}`;
        if (checkOut.value && checkOut.value <= checkIn.value) {
          checkOut.value = `${ny}-${nm}-${nd}`;
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors(form);

      const data = new FormData(form);

      // 蜂蜜罐：被填即視為 bot，靜默丟棄
      if (data.get('botcheck')) {
        return;
      }

      const payload = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        phone: String(data.get('phone') ?? ''),
        checkIn: String(data.get('check_in') ?? ''),
        checkOut: String(data.get('check_out') ?? ''),
        guests: Number(data.get('guests') ?? 0),
        roomPreference: String(data.get('room_preference') ?? ''),
        subject: String(data.get('subject_topic') ?? ''),
        message: String(data.get('message') ?? ''),
      };

      const result = validateContactForm(payload);
      if (!result.ok) {
        const fieldMap: Record<string, string> = {
          name: 'name',
          email: 'email',
          phone: 'phone',
          dateRange: 'check_out',
          guests: 'guests',
          subject: 'subject_topic',
          roomPreference: 'room_preference',
          message: 'message',
        };
        for (const [errKey, fieldName] of Object.entries(fieldMap)) {
          if (result.errors[errKey]) {
            setFieldError(form, i18n, fieldName, result.errors[errKey]);
          }
        }
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus();
        }
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        const json = await res
          .json()
          .catch(() => null) as { success?: boolean; message?: string } | null;
        // 嚴格檢查 success === true，避免 JSON 解析失敗或缺欄位被誤判為成功
        if (!json || json.success !== true) {
          throw new Error(json?.message ?? 'Submission failed');
        }
        showResult(form, i18n, 'success', i18n.successText);
        form.reset();
      } catch (err) {
        console.error('[contact] submit failed:', err);
        showResult(form, i18n, 'error', i18n.errorText);
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>

<style>
  /* === Contact — Editorial v3 === */
  .contact {
    background-color: var(--color-bone-50);
    padding-bottom: 0;
  }
  .page-header {
    padding-block: 7rem 4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
