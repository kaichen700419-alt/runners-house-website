---
/**
 * AboutSections
 *
 * 關於我們頁的所有區塊：
 *  BrandOrigin / HostStory / BrandPhilosophy / Timeline / Sustainability。
 * 採日系侘寂風（timber 主色），左右錯落留白排版。
 */
import { useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const timelineItems = [
  { key: 'about.timeline1972' },
  { key: 'about.timeline1995' },
  { key: 'about.timeline2023' },
  { key: 'about.timeline2024' },
  { key: 'about.timeline2025' },
  { key: 'about.timeline2026' },
];
---

<article class="about" aria-labelledby="about-page-heading">
  <header class="page-header container-wide reveal">
    <div class="chapter-mark">
      <span class="num">I</span>
      <span class="label">{locale === 'en' ? 'CHAPTER · THE STORY' : 'CHAPTER · 米倉故事'}</span>
    </div>
    <h1 id="about-page-heading" class="page-title">{t('about.pageTitle')}</h1>
    <p class="page-lead">{t('about.pageLead')}</p>
    <span class="brand-statement">{t('common.brandStatement')}</span>
  </header>

  <section class="origin" aria-labelledby="about-origin-heading">
    <div class="container-wide grid">
      <div class="visual">
        <ImagePlaceholder locale={locale} alt={t('about.originHeading')} ratio="3:4" variant="timber" />
      </div>
      <div class="content">
        <SectionHeading id="about-origin-heading" title={t('about.originHeading')} variant="wabi" />
        <p>{t('about.originBody')}</p>
        <dl class="meta">
          <div>
            <dt>{t('about.originDetailWhen')}</dt>
            <dd>{t('about.originDetailWhenValue')}</dd>
          </div>
          <div>
            <dt>{t('about.originDetailWhere')}</dt>
            <dd>{t('about.originDetailWhereValue')}</dd>
          </div>
          <div>
            <dt>{t('about.originDetailMaterial')}</dt>
            <dd>{t('about.originDetailMaterialValue')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="host" aria-labelledby="about-host-heading">
    <div class="container-wide grid grid-flip">
      <div class="content">
        <SectionHeading id="about-host-heading" title={t('about.hostHeading')} variant="wabi" />
        <p>{t('about.hostBody')}</p>
        <ul class="bullets">
          <li>{t('about.hostHobby')}</li>
          <li>{t('about.hostBelief')}</li>
        </ul>
      </div>
      <div class="visual">
        <ImagePlaceholder locale={locale} alt={t('about.hostHeading')} ratio="4:3" variant="ocean" />
      </div>
    </div>
  </section>

  <section class="philosophy" aria-labelledby="about-philosophy-heading">
    <div class="container-wide">
      <SectionHeading
        id="about-philosophy-heading"
        title={t('about.philosophyHeading')}
        subtitle={t('about.philosophyBody')}
        align="center"
        variant="wabi"
      />
      <ul class="trio">
        <li><span class="badge">{t('about.runBadge')}</span><p>{t('about.philosophyRun')}</p></li>
        <li><span class="badge">{t('about.stayBadge')}</span><p>{t('about.philosophyStay')}</p></li>
        <li><span class="badge">{t('about.chargeBadge')}</span><p>{t('about.philosophyCharge')}</p></li>
      </ul>
    </div>
  </section>

  <section class="timeline" aria-labelledby="about-timeline-heading">
    <div class="container-wide">
      <SectionHeading id="about-timeline-heading" title={t('about.timelineHeading')} variant="wabi" />
      <ol class="timeline-list">
        {
          timelineItems.map((item) => (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <span class="text">{t(item.key)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sustainability" aria-labelledby="about-sustainability-heading">
    <div class="container-wide">
      <SectionHeading id="about-sustainability-heading" title={t('about.sustainabilityHeading')} variant="wabi" />
      <p class="lead">{t('about.sustainabilityBody')}</p>
      <ul class="commit-list">
        <li>{t('about.sustainabilityNoSingleUse')}</li>
        <li>{t('about.sustainabilityWater')}</li>
        <li>{t('about.sustainabilityEnergy')}</li>
        <li>{t('about.sustainabilityLocal')}</li>
      </ul>
    </div>
  </section>
</article>

<style>
  /* === About — Mineral Coast v4 === */
  .about {
    background-color: var(--color-sand-50);
  }
  .page-header {
    padding-block: 5rem 4rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 1024px) {
    .page-header { padding-block: 6.5rem 5rem; }
  }
  .page-header .chapter-mark {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .page-header .chapter-mark .num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-sun-400);
    letter-spacing: -0.02em;
    line-height: 0.9;
    font-weight: 400;
  }
  .page-header .chapter-mark .label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-weight: 500;
  }
  :lang(en) .page-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .page-lead {
    margin: 0;
    max-width: 38rem;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.85;
    font-weight: 300;
  }
  :lang(en) .page-lead { font-family: var(--font-display-en); }
  .brand-statement {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-sun-500);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    border-top: 1px solid var(--color-sun-400);
    padding-top: 1rem;
    width: fit-content;
  }

  section { padding-block: 4rem; }
  section + section { border-top: 1px solid rgb(213 207 194 / 0.18); }

  .grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 5rem;
    }
    .grid-flip {
      grid-template-columns: 1fr 0.85fr;
    }
  }
  .visual { overflow: hidden; }
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-ink-700);
    font-size: 1rem;
    line-height: 2;
  }
  .content p { margin: 0; max-width: 38rem; }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 1.5rem 0 0;
  }
  .meta div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.5rem;
    border-bottom: 1px solid rgb(213 207 194 / 0.18);
    padding: 1rem 0;
  }
  .meta dt {
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
  }
  .meta dd {
    margin: 0;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  :lang(en) .meta dd { font-family: var(--font-display-en); }

  .bullets {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .bullets li {
    padding: 0.85rem 0 0.85rem 1.5rem;
    position: relative;
    border-bottom: 1px solid rgb(213 207 194 / 0.15);
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-ink-700);
    line-height: 1.7;
  }
  .bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    top: 0.85rem;
    color: var(--color-copper-500);
    font-family: var(--font-mono);
  }

  .philosophy { background-color: var(--color-bone-100); }
  .trio {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .trio { grid-template-columns: repeat(3, 1fr); }
    .trio li + li {
      border-left: 1px solid rgb(213 207 194 / 0.25);
    }
  }
  .trio li {
    padding: 2.5rem 2rem;
    text-align: center;
    color: var(--color-ink-700);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.95;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-copper-500);
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .trio p { margin: 0; max-width: 22rem; }

  .timeline-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-left: 1px solid rgb(213 207 194 / 0.4);
    padding-left: 2.5rem;
    margin-left: 0.4rem;
    max-width: 52rem;
  }
  .timeline-list li {
    position: relative;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.85;
    padding-block: 1.1rem;
    border-bottom: 1px solid rgb(213 207 194 / 0.12);
    letter-spacing: 0.02em;
  }
  .timeline-list li:last-child { border-bottom: none; }
  .timeline-list .dot {
    position: absolute;
    left: -3.05rem;
    top: 1.55rem;
    width: 9px;
    height: 9px;
    background-color: var(--color-copper-500);
    border-radius: 0;
    transform: rotate(45deg);
  }

  .sustainability { background-color: var(--color-bone-100); }
  .lead {
    margin: 0 0 2rem;
    color: var(--color-ink-700);
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    line-height: 2;
    max-width: 46rem;
  }
  .commit-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .commit-list { grid-template-columns: 1fr 1fr; }
  }
  .commit-list li {
    padding: 1.5rem 1.5rem 1.5rem 2.25rem;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.85;
    border-bottom: 1px solid rgb(213 207 194 / 0.18);
    position: relative;
  }
  .commit-list li::before {
    content: '—';
    position: absolute;
    left: 0.85rem;
    top: 1.5rem;
    color: var(--color-copper-500);
    font-family: var(--font-mono);
  }
  @media (min-width: 768px) {
    .commit-list li:nth-child(odd) {
      border-right: 1px solid rgb(213 207 194 / 0.18);
    }
  }
</style>
