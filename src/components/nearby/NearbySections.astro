---
/**
 * NearbySections
 *
 * 周邊景點 + 餐廳頁主體：
 *   1. 「不提供餐點」醒目提醒
 *   2. 景點清單（按距離由近至遠）
 *   3. 餐廳清單（按距離由近至遠）
 *   4. 建議行程（兩日一夜）
 */
import { getCollection } from 'astro:content';
import { useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const attractionsAll = await getCollection('attractions');
const restaurantsAll = await getCollection('restaurants');
// Collection 為空守門：上線後若內容被誤刪會在頁面靜默呈現空白；build 期間 fail-loud 才能即時發現。
if (!attractionsAll.length) {
  throw new Error('[content] attractions collection 為空');
}
if (!restaurantsAll.length) {
  throw new Error('[content] restaurants collection 為空');
}
// 穩定排序：distance 相同時改以 id 字典序當 tiebreaker，避免不同 build 順序不一致。
const attractions = attractionsAll
  .slice()
  .sort(
    (a, b) =>
      a.data.distanceMin - b.data.distanceMin || a.data.id.localeCompare(b.data.id),
  );
const restaurants = restaurantsAll
  .slice()
  .sort(
    (a, b) =>
      a.data.distanceMin - b.data.distanceMin || a.data.id.localeCompare(b.data.id),
  );

const variants = ['ocean', 'sand', 'timber', 'ink'] as const;
---

<article class="nearby" aria-labelledby="nearby-page-heading">
  <header class="page-header container-wide reveal">
    <div class="chapter-mark">
      <span class="num">V</span>
      <span class="label">{locale === 'en' ? 'CHAPTER · WHAT’S NEARBY' : 'CHAPTER · 周邊景點'}</span>
    </div>
    <h1 id="nearby-page-heading" class="page-title">{t('nearby.pageTitle')}</h1>
    <p class="page-lead">{t('nearby.pageLead')}</p>
  </header>

  <section class="no-meals" aria-labelledby="nearby-nomeals-heading">
    <div class="container-wide notice">
      <span class="badge" aria-hidden="true">!</span>
      <div>
        <h2 id="nearby-nomeals-heading" class="notice-title">{t('nearby.noMealsHeading')}</h2>
        <p class="notice-body">{t('nearby.noMealsBody')}</p>
      </div>
    </div>
  </section>

  <section class="spots" aria-labelledby="nearby-spots-heading">
    <div class="container-wide">
      <SectionHeading
        id="nearby-spots-heading"
        title={t('nearby.spotsHeading')}
        subtitle={t('nearby.spotsLead')}
        variant="ocean"
      />
      <ul class="card-grid">
        {
          attractions.map((spot, i) => {
            const name = locale === 'en' ? spot.data.name_en : spot.data.name_zh;
            const desc = locale === 'en' ? spot.data.description_en : spot.data.description_zh;
            return (
              <li class="card">
                <div class="image">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio="4:3"
                    variant={variants[i % variants.length] ?? 'ocean'}
                  />
                </div>
                <div class="body">
                  <span class="distance">{spot.data.distanceMin} {t('nearby.distanceMinUnit')}</span>
                  <h3 class="name">{name}</h3>
                  <p class="desc">{desc}</p>
                  <a class="link" href={spot.data.mapUrl} target="_blank" rel="noopener noreferrer">
                    {t('home.locationMapCta')}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="food" aria-labelledby="nearby-food-heading">
    <div class="container-wide">
      <SectionHeading
        id="nearby-food-heading"
        title={t('nearby.foodHeading')}
        subtitle={t('nearby.foodLead')}
        variant="ocean"
      />
      <ul class="card-grid">
        {
          restaurants.map((r, i) => {
            const name = locale === 'en' ? r.data.name_en : r.data.name_zh;
            const type = locale === 'en' ? r.data.type_en : r.data.type_zh;
            const desc = locale === 'en' ? r.data.description_en : r.data.description_zh;
            return (
              <li class="card">
                <div class="image">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio="4:3"
                    variant={variants[i % variants.length] ?? 'sand'}
                  />
                </div>
                <div class="body">
                  <span class="distance">{r.data.distanceMin} {t('nearby.distanceMinUnit')}</span>
                  <h3 class="name">{name}</h3>
                  <p class="type">{type}</p>
                  <p class="desc">{desc}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="itinerary" aria-labelledby="nearby-itinerary-heading">
    <div class="container-wide">
      <SectionHeading
        id="nearby-itinerary-heading"
        title={t('nearby.itineraryHeading')}
        subtitle={t('nearby.itineraryLead')}
        variant="ocean"
      />
      <ol class="days">
        <li>
          <span class="day-tag">D1</span>
          <h3>{t('nearby.itineraryDay1Title')}</h3>
          <p>{t('nearby.itineraryDay1Body')}</p>
        </li>
        <li>
          <span class="day-tag">D2</span>
          <h3>{t('nearby.itineraryDay2Title')}</h3>
          <p>{t('nearby.itineraryDay2Body')}</p>
        </li>
      </ol>
    </div>
  </section>
</article>

<style>
  /* === Nearby — Mineral Coast v4 === */
  .nearby {
    background-color: var(--color-sand-50);
    padding-bottom: 0;
  }
  .page-header {
    padding-block: 9rem 6rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 1024px) {
    .page-header { padding-block: 12rem 8rem; }
  }
  .page-header .chapter-mark {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .page-header .chapter-mark .num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-sun-400);
    letter-spacing: -0.02em;
    line-height: 0.9;
    font-weight: 400;
  }
  .page-header .chapter-mark .label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-weight: 500;
  }
  :lang(en) .page-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .page-lead {
    margin: 0;
    max-width: 38rem;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.85;
    font-weight: 300;
  }
  :lang(en) .page-lead { font-family: var(--font-display-en); }

  section { padding-block: 6rem; }
  section + section { border-top: 1px solid rgb(213 207 194 / 0.18); }

  .no-meals { padding-block: 4rem; }
  .notice {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.75rem;
    padding: 2.5rem;
    background-color: var(--color-bone-100);
    border: 1px solid rgb(213 207 194 / 0.3);
    border-left: 2px solid var(--color-copper-500);
    align-items: start;
    max-width: 880px;
    margin: 0 auto;
  }
  .badge {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-copper-500);
    color: var(--color-copper-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
  }
  .notice-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .notice-title { font-family: var(--font-display-en); font-style: italic; }
  .notice-body {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.95;
  }

  .card-grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 3rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .card-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .image { overflow: hidden; transition: transform 800ms var(--ease-editorial); }
  .card:hover .image { transform: scale(1.015); }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .distance {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
    text-transform: uppercase;
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .name {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .type {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-style: italic;
  }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.9rem;
    line-height: 1.95;
  }
  .link {
    margin-top: auto;
    align-self: flex-start;
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
    margin-top: 0.5rem;
  }
  .link:hover { color: var(--color-ink-900); }

  .itinerary { background-color: var(--color-bone-100); }
  .days {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .days { grid-template-columns: 1fr 1fr; }
    .days li:first-child {
      border-right: 1px solid rgb(213 207 194 / 0.25);
    }
  }
  .days li {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .day-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
    text-transform: uppercase;
  }
  .days h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .days h3 {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .days p {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.95;
  }
</style>
