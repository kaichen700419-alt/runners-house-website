---
/**
 * Footer 元件
 *
 * 三欄結構：
 *  1. 聯絡資訊（地址 / 電話 / Email / LINE / 營業時間）
 *  2. 快速連結（站內主要頁面）
 *  3. 追蹤與地圖（社群、Google Maps lazy iframe、版權）
 *
 * 所有外部連結皆 rel="noopener noreferrer" target="_blank"。
 * Google Maps iframe 使用 loading="lazy" 與 referrerpolicy 增加效能與隱私。
 */
import { useTranslations } from '@/i18n/utils';
import { NAV_ITEMS, resolveNavHrefs } from '@/lib/navigation';
import { ADDRESS, CONTACT, GEO } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// SSG: 此年份固定於 build time；網站需於每年初 rebuild，
// 或在 Cloudflare Pages 設定 cron build 自動更新（每年 1 月 1 日）。
const currentYear = new Date().getFullYear().toString();

const fullAddress = locale === 'en' ? ADDRESS.fullEn : ADDRESS.fullZh;
const mapQuery = encodeURIComponent(`${GEO.latitude},${GEO.longitude}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${locale === 'en' ? 'en' : 'zh-TW'}&z=13&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const quickLinks = resolveNavHrefs(NAV_ITEMS, locale);
---

<footer class="site-footer" aria-label="site footer">
  <div class="container-wide footer-inner">
    <section class="col" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="col-heading">{t('footer.contactHeading')}</h2>
      <ul class="info-list">
        <li>
          <span class="label">{t('footer.addressLabel')}</span>
          <span>{fullAddress}</span>
        </li>
        <li>
          <span class="label">{t('footer.phoneLabel')}</span>
          <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
        </li>
        <li>
          <span class="label">{t('footer.emailLabel')}</span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        <li>
          <span class="label">{t('footer.lineLabel')}</span>
          <a href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
            {CONTACT.lineId}
          </a>
        </li>
      </ul>
      <h3 class="col-subheading">{t('footer.hoursHeading')}</h3>
      <p class="hours">{t('footer.hoursContent')}</p>
    </section>

    <nav class="col" aria-labelledby="footer-quick-heading">
      <h2 id="footer-quick-heading" class="col-heading">{t('footer.quickLinksHeading')}</h2>
      <ul class="link-list">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{t(link.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="col" aria-labelledby="footer-social-heading">
      <h2 id="footer-social-heading" class="col-heading">{t('footer.socialHeading')}</h2>
      <ul class="social-list">
        <li>
          <a href={CONTACT.facebookUrl} target="_blank" rel="noopener noreferrer">{t('footer.facebook')}</a>
        </li>
        <li>
          <a href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">{t('footer.instagram')}</a>
        </li>
        <li>
          <a href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">{t('footer.line')}</a>
        </li>
        <li>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer">{t('footer.mapHeading')}</a>
        </li>
      </ul>
      <div class="map-frame">
        {/*
          Map iframe 高度策略：
            - 桌面 (≥768px) 設為 300，避免在三欄 footer 中看起來像缺塊
            - 行動 (<768px) 設為 220，比舊版 200 略增但不會壓縮整個 footer
          同時加上 rounded border + 細白框，讓 iframe 看起來像一張卡片
          而非單調的內嵌地圖。實際高度由 CSS 控制（min-height + height: auto），
          width / height 屬性僅作為瀏覽器初始預留空間（CLS 避免）的提示。
        */}
        <iframe
          title={t('footer.mapAria')}
          aria-label={t('footer.mapAria')}
          src={mapEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups"
          width="100%"
          height="300"
        ></iframe>
      </div>
    </section>
  </div>

  <div class="footer-base">
    <div class="container-wide base-inner">
      <p class="copyright">{t('common.copyright', { year: currentYear })}</p>
      <p class="built-with">{t('footer.builtWith')}</p>
    </div>
  </div>
</footer>

<style>
  /* === Editorial Footer ===
     深 ink 底 + 大量留白 + 銅金細線取代色塊；字級小、行距大 */
  .site-footer {
    margin-top: 0;
    background-color: var(--color-ink-950);
    color: var(--color-bone-200);
  }
  .footer-inner {
    display: grid;
    gap: 3.5rem;
    padding-block: 6rem 4rem;
    grid-template-columns: 1fr;
    position: relative;
  }
  /* 頂部 1px 銅金細線：取代厚重色塊邊界 */
  .site-footer::before {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-copper-500) 30%,
      var(--color-copper-500) 70%,
      transparent 100%);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-copper-400);
    margin: 0;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 500;
    /* 標題下方銅金短線 */
    padding-bottom: 1rem;
    position: relative;
  }
  .col-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28px;
    height: 1px;
    background-color: var(--color-copper-500);
  }
  .col-subheading {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-copper-300);
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .info-list, .link-list, .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .label {
    color: var(--color-bone-400);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  a {
    color: var(--color-bone-200);
    text-decoration: none;
    transition: color 280ms var(--ease-editorial);
  }
  a:hover {
    color: var(--color-copper-300);
  }
  .link-list a, .social-list a {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    line-height: 1.7;
  }
  .hours {
    font-size: 0.85rem;
    color: var(--color-bone-300);
    margin: 0;
    line-height: 1.85;
  }
  /* Map 框：1px 銅金細邊、無圓角，呼應藝廊裱框 */
  .map-frame {
    margin-top: 1.25rem;
    border: 1px solid rgb(160 134 96 / 0.35);
    overflow: hidden;
  }
  .map-frame iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 220px;
    /* 灰階柔化，讓地圖視覺退為背景 */
    filter: grayscale(0.6) brightness(0.85) contrast(0.95);
  }
  @media (min-width: 768px) {
    .map-frame iframe {
      height: 280px;
    }
  }
  .footer-base {
    border-top: 1px solid rgb(160 134 96 / 0.18);
    background-color: var(--color-ink-950);
    padding-block: 2rem;
  }
  .base-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-bone-400);
  }
  .copyright {
    margin: 0;
  }
  .built-with {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-bone-300);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1.2fr;
      gap: 5rem;
    }
    .base-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
