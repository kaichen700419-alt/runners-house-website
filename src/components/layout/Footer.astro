---
/**
 * Footer v4 — 海風礦物 Mineral Coast
 *
 * 三欄結構：
 *  1. 聯絡資訊（地址 / 電話 / Email / LINE / 營業時間）
 *  2. 快速連結（站內主要頁面）
 *  3. 追蹤與地圖（社群、Google Maps lazy iframe、版權）
 *
 * 設計：
 *  - 全寬深 charcoal 區塊 + 巨大 Bodoni Italic 「RUNNERS HOUSE」浮水印
 *  - 三欄之間用海洋灰藍細線分隔
 *  - 每欄標題用 mono caps + 下方晨曦橘短線
 *  - 底部「Built by ○○」用 Italic 雜誌式署名
 */
import { useTranslations } from '@/i18n/utils';
import { NAV_ITEMS, resolveNavHrefs } from '@/lib/navigation';
import { ADDRESS, CONTACT, GEO } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear().toString();

const fullAddress = locale === 'en' ? ADDRESS.fullEn : ADDRESS.fullZh;
const mapQuery = encodeURIComponent(`${GEO.latitude},${GEO.longitude}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${locale === 'en' ? 'en' : 'zh-TW'}&z=13&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const quickLinks = resolveNavHrefs(NAV_ITEMS, locale);
---

<footer class="site-footer" aria-label="site footer">
  {/* 巨大浮水印品牌字 */}
  <span class="footer-watermark" aria-hidden="true">
    {locale === 'en' ? 'Runners House' : 'RUNNERS HOUSE'}
  </span>

  <div class="container-wide footer-inner">
    <section class="col" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="col-heading">{t('footer.contactHeading')}</h2>
      <ul class="info-list">
        <li>
          <span class="label">{t('footer.addressLabel')}</span>
          <span>{fullAddress}</span>
        </li>
        <li>
          <span class="label">{t('footer.phoneLabel')}</span>
          <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
        </li>
        <li>
          <span class="label">{t('footer.emailLabel')}</span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        <li>
          <span class="label">{t('footer.lineLabel')}</span>
          <a href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
            {CONTACT.lineId}
          </a>
        </li>
      </ul>
      <h3 class="col-subheading">{t('footer.hoursHeading')}</h3>
      <p class="hours">{t('footer.hoursContent')}</p>
    </section>

    <nav class="col" aria-labelledby="footer-quick-heading">
      <h2 id="footer-quick-heading" class="col-heading">{t('footer.quickLinksHeading')}</h2>
      <ul class="link-list">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{t(link.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="col" aria-labelledby="footer-social-heading">
      <h2 id="footer-social-heading" class="col-heading">{t('footer.socialHeading')}</h2>
      <ul class="social-list">
        <li>
          <a href={CONTACT.facebookUrl} target="_blank" rel="noopener noreferrer">{t('footer.facebook')}</a>
        </li>
        <li>
          <a href={CONTACT.instagramUrl} target="_blank" rel="noopener noreferrer">{t('footer.instagram')}</a>
        </li>
        <li>
          <a href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">{t('footer.line')}</a>
        </li>
        <li>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer">{t('footer.mapHeading')}</a>
        </li>
      </ul>
      <div class="map-frame">
        <iframe
          title={t('footer.mapAria')}
          aria-label={t('footer.mapAria')}
          src={mapEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups"
          width="100%"
          height="280"
        ></iframe>
      </div>
    </section>
  </div>

  <div class="footer-base">
    <div class="container-wide base-inner">
      <p class="copyright">{t('common.copyright', { year: currentYear })}</p>
      <p class="built-with">{t('footer.builtWith')}</p>
    </div>
  </div>
</footer>

<style>
  /* === Editorial Footer v4 ===
     深 ink 底 + 大量留白 + Bodoni Italic 巨字浮水印 + 海洋灰藍細線 */
  .site-footer {
    position: relative;
    margin-top: 0;
    background-color: var(--color-ink-950);
    color: var(--color-sand-200);
    overflow: hidden;
    isolation: isolate;
  }
  /* 頂部 1px 海洋灰藍漸層細線 */
  .site-footer::before {
    content: '';
    display: block;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-sea-500) 30%,
      var(--color-sun-400) 70%,
      transparent 100%);
  }
  /* 巨大品牌浮水印（Bodoni Italic） */
  .footer-watermark {
    position: absolute;
    bottom: -3rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(6rem, 18vw, 16rem);
    letter-spacing: -0.04em;
    color: var(--color-sun-400);
    opacity: 0.05;
    user-select: none;
    pointer-events: none;
    line-height: 0.85;
    white-space: nowrap;
    z-index: 0;
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 4rem;
    padding-block: 7rem 5rem;
    grid-template-columns: 1fr;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-sun-400);
    margin: 0;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    font-weight: 500;
    padding-bottom: 1rem;
    position: relative;
  }
  .col-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28px;
    height: 1px;
    background-color: var(--color-sun-400);
  }
  .col-subheading {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-sun-300);
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .info-list, .link-list, .social-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .label {
    color: var(--color-sand-400);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  a {
    color: var(--color-sand-200);
    text-decoration: none;
    transition: color 280ms var(--ease-editorial);
  }
  a:hover { color: var(--color-sun-300); }
  .link-list a, .social-list a {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }
  :lang(en) .link-list a, :lang(en) .social-list a {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .hours {
    font-size: 0.85rem;
    color: var(--color-sand-300);
    margin: 0;
    line-height: 1.85;
  }
  .map-frame {
    margin-top: 1.25rem;
    border: 1px solid rgb(201 125 93 / 0.3);
    overflow: hidden;
  }
  .map-frame iframe {
    display: block;
    border: 0;
    width: 100%;
    height: 220px;
    filter: grayscale(0.65) brightness(0.82) contrast(0.95);
  }
  @media (min-width: 768px) {
    .map-frame iframe { height: 280px; }
  }
  .footer-base {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgb(201 125 93 / 0.18);
    background-color: var(--color-ink-950);
    padding-block: 2rem;
  }
  .base-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--color-sand-400);
  }
  .copyright { margin: 0; }
  .built-with {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--color-sand-300);
  }
  :lang(en) .built-with { font-family: var(--font-display-en); }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1.2fr;
      gap: 5rem;
    }
    .base-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
