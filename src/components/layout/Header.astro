---
/**
 * Header v4 — 海風礦物 Mineral Coast
 *
 * 精品民宿 sticky header：
 *   - 沙白半透明底 + backdrop-filter 毛玻璃
 *   - 海洋灰藍 monogram 銅金邊（取代填色圓徽）
 *   - 桌機水平導覽：item hover 時下方晨曦橘細線從左到右畫過
 *   - 預訂 CTA 改為文字鏈 + underline-offset 6px（取代藍色按鈕）
 *   - 首頁特化：scroll 之前 header 完全透明，scroll 開始顯示沙白底（編輯感）
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { NAV_ITEMS, resolveNavHrefs } from '@/lib/navigation';
import { SITE } from '@/lib/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  pathname: string;
  locale: Locale;
}

const { pathname, locale } = Astro.props;
const t = useTranslations(locale);
const homeHref = getLocalizedPath('/', locale);
const navItems = resolveNavHrefs(NAV_ITEMS, locale);
---

<a class="skip-link" href="#main-content">{t('common.skipToContent')}</a>

<header class="site-header" aria-label="site header">
  <div class="container-wide header-inner">
    <a class="brand" href={homeHref} aria-label={t('common.siteName')}>
      <span class="brand-mark" aria-hidden="true">{SITE.brandMark}</span>
      <span class="brand-text">
        <span class="brand-name">{t('common.siteName')}</span>
        <span class="brand-tagline">{t('common.tagline')}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === pathname ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-tail">
      <LanguageSwitcher pathname={pathname} locale={locale} />
      <a class="cta-inline" href={getLocalizedPath('/contact', locale)}>
        {t('common.bookInquiry')}
      </a>
      <MobileMenu pathname={pathname} locale={locale} />
    </div>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background-color: var(--color-ink-900);
    color: var(--color-sand-100);
    padding: 0.55rem 1.1rem;
    border-radius: 0;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    transition: top 200ms var(--ease-editorial);
  }
  .skip-link:focus { top: 1rem; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 沙白半透明 + 細海洋灰藍底線（不再用銅金邊，太吵） */
    background-color: rgb(247 244 237 / 0.88);
    backdrop-filter: saturate(140%) blur(18px);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    border-bottom: 1px solid var(--color-divider);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--color-ink-900);
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    background-color: transparent;
    border: 1px solid var(--color-sea-500);
    color: var(--color-sea-500);
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    transition: background-color 320ms var(--ease-editorial), color 320ms var(--ease-editorial);
  }
  .brand:hover .brand-mark {
    background-color: var(--color-sea-500);
    color: var(--color-sand-50);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink-900);
  }
  :lang(en) .brand-name {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.005em;
  }
  .brand-tagline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-sun-500);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-top: 0.2rem;
  }

  .desktop-nav { display: none; }
  .desktop-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .desktop-nav a {
    display: inline-block;
    padding: 0.6rem 0.85rem;
    color: var(--color-ink-700);
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    position: relative;
    transition: color 280ms var(--ease-editorial);
  }
  :lang(en) .desktop-nav a {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.4rem;
    height: 1px;
    background-color: var(--color-sun-400);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 360ms var(--ease-editorial);
  }
  .desktop-nav a:hover { color: var(--color-ink-950); }
  .desktop-nav a:hover::after { transform: scaleX(1); }
  .desktop-nav a[aria-current='page'] { color: var(--color-sea-500); }
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
    background-color: var(--color-sea-500);
  }

  .header-tail {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }
  .cta-inline {
    display: none;
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-sun-400);
    transition: color 280ms var(--ease-editorial), border-color 280ms var(--ease-editorial);
  }
  :lang(en) .cta-inline {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .cta-inline:hover {
    color: var(--color-sun-500);
    border-color: var(--color-sun-500);
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
      flex: 1;
      margin-inline: 1.5rem;
    }
    .desktop-nav ul {
      justify-content: center;
    }
    .cta-inline {
      display: inline-block;
    }
  }
</style>
