---
/**
 * Header 元件
 *
 * 桌面：水平導覽列；行動：漢堡 + 抽屜選單（MobileMenu）。
 * 樣式採 sticky 定位搭配半透明白底與 backdrop-filter 毛玻璃效果，
 * 並無真正的 scroll-driven animation，全程不依賴 JS。
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { NAV_ITEMS, resolveNavHrefs } from '@/lib/navigation';
import { SITE } from '@/lib/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  pathname: string;
  locale: Locale;
}

const { pathname, locale } = Astro.props;
const t = useTranslations(locale);
const homeHref = getLocalizedPath('/', locale);
const navItems = resolveNavHrefs(NAV_ITEMS, locale);
---

<a class="skip-link" href="#main-content">{t('common.skipToContent')}</a>

<header class="site-header" aria-label="site header">
  <div class="container-wide header-inner">
    <a class="brand" href={homeHref} aria-label={t('common.siteName')}>
      <span class="brand-mark" aria-hidden="true">{SITE.brandMark}</span>
      <span class="brand-text">
        <span class="brand-name">{t('common.siteName')}</span>
        <span class="brand-tagline">{t('common.tagline')}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === pathname ? 'page' : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-tail">
      <LanguageSwitcher pathname={pathname} locale={locale} />
      <a class="cta-inline" href={getLocalizedPath('/contact', locale)}>
        {t('common.bookInquiry')}
      </a>
      <MobileMenu pathname={pathname} locale={locale} />
    </div>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background-color: var(--color-ink-900);
    color: var(--color-bone-100);
    padding: 0.55rem 1.1rem;
    border-radius: 2px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    transition: top 200ms var(--ease-editorial);
  }
  .skip-link:focus {
    top: 1rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 精品感：象牙白半透明 + 細銅金底線取代厚重 timber 邊 */
    background-color: rgb(251 248 242 / 0.92);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid rgb(160 134 96 / 0.25);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--color-ink-900);
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    /* 銅金細描邊取代填色圓徽，呼應 Aman 的 monogram */
    background-color: transparent;
    border: 1px solid var(--color-copper-500);
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink-900);
  }
  .brand-tagline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-copper-600);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  .desktop-nav {
    display: none;
  }
  .desktop-nav ul {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .desktop-nav a {
    display: inline-block;
    padding: 0.55rem 0.9rem;
    color: var(--color-ink-700);
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    position: relative;
    transition: color 220ms var(--ease-editorial);
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.35rem;
    height: 1px;
    background-color: var(--color-copper-500);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 320ms var(--ease-editorial);
  }
  .desktop-nav a:hover {
    color: var(--color-ink-950);
  }
  .desktop-nav a:hover::after {
    transform: scaleX(1);
  }
  .desktop-nav a[aria-current='page'] {
    color: var(--color-ink-950);
  }
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
    background-color: var(--color-ink-900);
  }

  .header-tail {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .cta-inline {
    display: none;
    padding: 0.55rem 1.2rem;
    border: 1px solid var(--color-ink-900);
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 280ms var(--ease-editorial),
      color 280ms var(--ease-editorial);
  }
  .cta-inline:hover {
    background-color: var(--color-ink-900);
    color: var(--color-bone-100);
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
      flex: 1;
      margin-inline: 1.5rem;
    }
    .desktop-nav ul {
      justify-content: center;
    }
    .cta-inline {
      display: inline-block;
    }
  }
</style>
