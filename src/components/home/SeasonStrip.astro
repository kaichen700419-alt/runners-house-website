---
/**
 * SeasonStrip — D1 Screen 6「四季敘事」
 *
 * 設計依據：研究報告 D1.Screen 6 + B6 Hoshinoya 季節切換靈感
 *   - 全寬深 charcoal 區塊，模擬 magazine spread
 *   - 四欄春／夏／秋／冬，每欄一個 SVG 線稿主題符號 + 詩意短文
 *   - 文字硬式靠左下，每欄之間用海洋灰藍細線分隔
 *   - 大編號（春01／夏02／秋03／冬04） + Bodoni Moda Italic 季節英文
 *   - 完全用 inline 詩意文案（非 i18n key — 業主可在 about.originBody 邏輯下後續移植）
 */
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// 四季短詩（裝飾性，可後續移到 i18n）
const seasons = locale === 'en'
  ? [
      { en: 'Spring', zh: '春', poem: 'When the Pacific salt drifts through the rice barn windows.', icon: 'spring' },
      { en: 'Summer', zh: '夏', poem: 'Tide arrives at five, the runners arrive at six.', icon: 'summer' },
      { en: 'Autumn', zh: '秋', poem: 'East wind rewrites the coastline before breakfast.', icon: 'autumn' },
      { en: 'Winter', zh: '冬', poem: 'A bowl of moon, a quiet pavement, a long stride.', icon: 'winter' },
    ]
  : [
      { en: 'Spring', zh: '春', poem: '太平洋的鹽穿過米倉的窗。', icon: 'spring' },
      { en: 'Summer', zh: '夏', poem: '潮水五點到，跑者六點到。', icon: 'summer' },
      { en: 'Autumn', zh: '秋', poem: '早餐之前，東風重新描繪海岸線。', icon: 'autumn' },
      { en: 'Winter', zh: '冬', poem: '一碗月亮、一條安靜的路、一個長步。', icon: 'winter' },
    ];
---

<section class="season-strip" aria-labelledby="season-strip-heading">
  {/* 章節 marker */}
  <div class="container-wide chapter-row reveal">
    <div class="chapter-mark on-dark">
      <span class="num">VI</span>
      <span class="label">CHAPTER · {locale === 'en' ? 'FOUR SEASONS, ONE SHORE' : '四季的同一片海'}</span>
    </div>
  </div>

  <div class="container-wide header reveal" data-delay="1">
    <h2 id="season-strip-heading" class="title">
      {locale === 'en' ? 'Four seasons, four ways to live by the sea.' : '四季，四種與海相處的方式。'}
    </h2>
  </div>

  <ul class="strip">
    {
      seasons.map((s, i) => (
        <li class={`cell cell-${s.icon} reveal`} data-delay={i + 1}>
          <div class="cell-inner">
            <span class="cell-num" aria-hidden="true">0{i + 1}</span>
            <svg class="cell-icon" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
              {s.icon === 'spring' && (
                <>
                  <circle cx="30" cy="30" r="6" fill="none" stroke="currentColor" stroke-width="0.8" />
                  <path d="M30 14 C34 22 34 22 30 30 C26 22 26 22 30 14 Z" fill="none" stroke="currentColor" stroke-width="0.8" />
                  <path d="M30 46 C34 38 34 38 30 30 C26 38 26 38 30 46 Z" fill="none" stroke="currentColor" stroke-width="0.8" />
                  <path d="M14 30 C22 26 22 26 30 30 C22 34 22 34 14 30 Z" fill="none" stroke="currentColor" stroke-width="0.8" />
                  <path d="M46 30 C38 26 38 26 30 30 C38 34 38 34 46 30 Z" fill="none" stroke="currentColor" stroke-width="0.8" />
                </>
              )}
              {s.icon === 'summer' && (
                <>
                  <circle cx="30" cy="30" r="9" fill="none" stroke="currentColor" stroke-width="1" />
                  {Array.from({ length: 8 }).map((_, ang) => {
                    const a = (ang / 8) * Math.PI * 2;
                    const x1 = 30 + Math.cos(a) * 14;
                    const y1 = 30 + Math.sin(a) * 14;
                    const x2 = 30 + Math.cos(a) * 22;
                    const y2 = 30 + Math.sin(a) * 22;
                    return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="currentColor" stroke-width="0.8" />;
                  })}
                </>
              )}
              {s.icon === 'autumn' && (
                <>
                  <path d="M10 36 C18 28 22 26 30 30 C38 34 42 32 50 24" fill="none" stroke="currentColor" stroke-width="0.9" />
                  <path d="M10 44 C18 36 22 34 30 38 C38 42 42 40 50 32" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.6" />
                </>
              )}
              {s.icon === 'winter' && (
                <>
                  <path d="M16 30 A14 14 0 1 0 44 30 A12 12 0 1 1 16 30 Z" fill="none" stroke="currentColor" stroke-width="0.9" />
                  <circle cx="44" cy="22" r="0.8" fill="currentColor" />
                  <circle cx="38" cy="14" r="0.6" fill="currentColor" opacity="0.6" />
                </>
              )}
            </svg>
            <h3 class="cell-en" lang="en">{s.en}</h3>
            <span class="cell-zh">{s.zh}</span>
            <p class="cell-poem">{s.poem}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .season-strip {
    background-color: var(--color-ink-950);
    color: var(--color-sand-100);
    padding-block: 8rem 0;
  }
  @media (min-width: 1024px) {
    .season-strip { padding-block: 11rem 0; }
  }

  .chapter-row { margin-bottom: 4rem; }
  .chapter-mark.on-dark .num { color: var(--color-sun-400); }
  .chapter-mark.on-dark .label { color: var(--color-sand-300); }

  .header {
    margin-bottom: 5rem;
    max-width: 56rem;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 3.25rem);
    color: var(--color-sand-100);
    letter-spacing: -0.005em;
    line-height: 1.2;
    font-weight: 500;
    max-width: 38rem;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgb(44 74 82 / 0.6);
  }
  @media (min-width: 768px) {
    .strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .strip { grid-template-columns: repeat(4, 1fr); }
  }
  .cell {
    border-bottom: 1px solid rgb(44 74 82 / 0.6);
    border-right: 1px solid rgb(44 74 82 / 0.6);
    color: var(--color-sand-200);
    transition: background-color 540ms var(--ease-editorial), color 540ms var(--ease-editorial);
  }
  @media (min-width: 768px) {
    .cell:nth-child(2n):not(:nth-child(1)) { border-right: 1px solid rgb(44 74 82 / 0.6); }
  }
  .cell:hover {
    background-color: rgb(44 74 82 / 0.5);
    color: var(--color-sun-300);
  }
  .cell-inner {
    padding: 4rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
  }
  @media (min-width: 1024px) {
    .cell-inner { padding: 5rem 2.5rem 6rem; min-height: 28rem; }
  }
  .cell-num {
    font-family: var(--font-display-en);
    font-size: 1.6rem;
    font-style: italic;
    color: var(--color-sun-400);
    letter-spacing: 0.06em;
  }
  .cell-icon {
    width: 64px;
    height: 64px;
    color: var(--color-sand-300);
    margin-block: 0.5rem 1rem;
    transition: color 540ms var(--ease-editorial), transform 540ms var(--ease-editorial);
  }
  .cell:hover .cell-icon {
    color: var(--color-sun-400);
    transform: rotate(-6deg);
  }
  .cell-en {
    margin: 0;
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(1.85rem, 2.6vw, 2.4rem);
    color: var(--color-sand-100);
    letter-spacing: -0.02em;
    font-weight: 400;
  }
  .cell-zh {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-sun-400);
    letter-spacing: 0.4em;
    margin-top: -0.4rem;
  }
  .cell-poem {
    margin: 1rem 0 0;
    color: var(--color-sand-200);
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.95;
    font-style: italic;
    font-weight: 300;
    flex: 1;
    max-width: 22rem;
  }
  :lang(en) .cell-poem { font-family: var(--font-display-en); }
</style>
