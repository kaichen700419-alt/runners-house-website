---
/**
 * RoomPreview v4 — D1 Screen 5「房型 magazine 展演」
 *
 * 設計依據：研究報告 D1.Screen 5 + B5 Omai Villas 房型分類精緻化
 *   - 拋棄 v3 sticky 兩欄排版
 *   - 改為「橫向 spread」全寬展演：頂部章節 marker + 大標 + 4 張房型卡片
 *   - 卡片 hover：圖右上角顯示「VIEW ROOM →」滑入動畫
 *   - 編號 01–04 + 房名 + meta（坪數／人數／景觀）放在卡片下方左對齊
 *   - 整體無圓角、無 box-shadow（嚴格遵守研究報告 E 禁忌 3）
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allRooms = await getCollection('rooms');
if (!allRooms.length) {
  throw new Error('[content] rooms collection 為空');
}
const previewRooms = allRooms
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug))
  .slice(0, 4);

const placeholderVariants = ['ocean', 'timber', 'sand', 'ink'] as const;
---

<section class="room-preview" aria-labelledby="room-preview-heading">
  <div class="container-wide chapter-row reveal">
    <div class="chapter-mark">
      <span class="num">V</span>
      <span class="label">CHAPTER · {locale === 'en' ? 'WHERE YOU SLEEP' : '住的房間'}</span>
    </div>
  </div>

  <div class="container-wide header reveal" data-delay="1">
    <h2 id="room-preview-heading" class="title">{t('home.roomPreviewHeading')}</h2>
    <div class="lead-row">
      <p class="lead">{t('home.roomPreviewLead')}</p>
      <a class="text-link" href={getLocalizedPath('/rooms', locale)}>
        {t('home.roomPreviewSeeAll')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="container-wide">
    <ul class="cards">
      {
        previewRooms.map((room, idx) => {
          const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
          const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
          const variant = placeholderVariants[idx % placeholderVariants.length] ?? 'ocean';
          const href = getLocalizedPath(`/rooms/${room.data.slug}`, locale);
          const num = String(idx + 1).padStart(2, '0');
          return (
            <li class="card reveal" data-delay={(idx % 4) + 1}>
              <a href={href} class="card-link" aria-label={name}>
                <div class="image-wrap">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio="3:4"
                    variant={variant}
                  />
                  <span class="hover-cta" aria-hidden="true">
                    {locale === 'en' ? 'VIEW ROOM →' : '進入房間 →'}
                  </span>
                </div>
                <div class="card-body">
                  <div class="card-head">
                    <span class="card-num" aria-hidden="true">{num}</span>
                    <h3 class="name">{name}</h3>
                  </div>
                  <p class="meta">
                    <span>{room.data.size}{t('rooms.sizeUnit')}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{room.data.capacity}{t('rooms.capacityUnit')}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{view}</span>
                  </p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .room-preview {
    padding-block: 4rem 4.5rem;
    background-color: var(--color-sand-100);
  }
  @media (min-width: 1024px) {
    .room-preview { padding-block: 5.5rem 6rem; }
  }
  .chapter-row { margin-bottom: 2rem; }
  .header {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4rem);
    color: var(--color-ink-900);
    line-height: 1.1;
    letter-spacing: -0.005em;
    font-weight: 500;
    max-width: 30rem;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .lead-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .lead-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .lead {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
    max-width: 30rem;
  }
  :lang(en) .lead { font-family: var(--font-display-en); }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, 1fr); gap: 3.5rem 2rem; }
  }
  @media (min-width: 1024px) {
    .cards { grid-template-columns: repeat(4, 1fr); gap: 3rem 1.5rem; }
  }
  .card { display: flex; flex-direction: column; }
  .card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    gap: 1.5rem;
  }
  .image-wrap {
    position: relative;
    overflow: hidden;
  }
  .image-wrap > :global(figure) {
    transition: transform 1000ms var(--ease-editorial);
  }
  .card-link:hover .image-wrap > :global(figure) { transform: scale(1.025); }

  .hover-cta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1rem 1.25rem;
    background: linear-gradient(to top, rgba(26, 26, 26, 0.85), rgba(26, 26, 26, 0));
    color: var(--color-sand-100);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-align: center;
    transform: translateY(100%);
    transition: transform 540ms var(--ease-editorial);
  }
  .card-link:hover .hover-cta { transform: translateY(0); }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .card-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .card-num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-sun-400);
    letter-spacing: -0.03em;
    font-weight: 400;
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    color: var(--color-ink-900);
    letter-spacing: 0.01em;
    font-weight: 500;
    line-height: 1.25;
    transition: color 280ms var(--ease-editorial);
  }
  .card-link:hover .name { color: var(--color-sea-500); }
  :lang(en) .name {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .meta {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .dot {
    color: var(--color-sun-400);
    opacity: 0.8;
  }
</style>
