---
/**
 * RoomPreview — 首頁房型快覽（自己設計版）
 *
 * 4 房型 2x2 網格（桌面）/ 1 column（行動）
 * 每張卡片：上方深木色 placeholder + 下方資訊（房名 / 容納 / 坪數 / 詳情按鈕）
 * 完全無：羅馬數字、橘色 hover 線、編號裝飾
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allRooms = await getCollection('rooms');
if (!allRooms.length) {
  throw new Error('[home/RoomPreview] rooms collection 為空');
}
const rooms = allRooms
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug))
  .slice(0, 4);

const peopleLabel = locale === 'en' ? 'guests' : '人';
const sizeLabel = locale === 'en' ? 'm²' : '坪';
const ctaLabel = locale === 'en' ? 'View details' : '查看詳情';
const allRoomsLabel = locale === 'en' ? 'All rooms' : '查看所有房型';
---

<section class="rooms" aria-labelledby="rooms-heading">
  <div class="rooms-inner">
    <header class="rooms-header">
      <p class="eyebrow">{locale === 'en' ? 'Stay' : '房型介紹'}</p>
      <h2 id="rooms-heading" class="heading">{t('home.roomPreviewHeading')}</h2>
    </header>

    <div class="grid">
      {rooms.map((room) => (
        <article class="card">
          <a class="card-link" href={getLocalizedPath(`/rooms/${room.data.slug}`, locale)}>
            <div class="card-image" aria-hidden="true">
              <span class="image-label">{locale === 'en' ? 'PHOTO' : '照片更新中'}</span>
            </div>
            <div class="card-body">
              <h3 class="card-name">{locale === 'en' ? room.data.name_en : room.data.name_zh}</h3>
              <div class="card-meta">
                <span>{room.data.capacity} {peopleLabel}</span>
                <span class="dot" aria-hidden="true">·</span>
                <span>{room.data.size} {sizeLabel}</span>
              </div>
              <span class="cta">{ctaLabel} →</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="all-link-wrap">
      <a class="all-link" href={getLocalizedPath('/rooms', locale)}>
        {allRoomsLabel}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .rooms {
    background-color: #faf6ee;
    padding: 6rem 1.5rem;
  }
  @media (min-width: 768px) {
    .rooms { padding: 8rem 2.5rem; }
  }
  .rooms-inner {
    max-width: 78rem;
    margin: 0 auto;
  }
  .rooms-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #8b6f47;
    font-weight: 500;
  }
  .heading {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    color: #1a1411;
    letter-spacing: 0.04em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  }

  .card {
    background-color: #ffffff;
    border: 1px solid #ebe1ce;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .card:hover {
    border-color: #8b6f47;
    transform: translateY(-4px);
  }
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(135deg, rgba(184, 142, 92, 0.18) 0%, rgba(60, 50, 40, 0.45) 100%),
      linear-gradient(160deg, #2d2520 0%, #1a1411 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .image-label {
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
  }

  .card-body {
    padding: 1.75rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .card-name {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #1a1411;
    letter-spacing: 0.03em;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.875rem;
    color: #6e6c63;
  }
  .card-meta .dot { color: #c5c2b9; }
  .cta {
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.85rem;
    color: #8b6f47;
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
  }

  .all-link-wrap {
    text-align: center;
    margin-top: 4rem;
  }
  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.05rem 2.5rem;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #1a1411;
    background-color: transparent;
    border: 1.5px solid #1a1411;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .all-link:hover {
    background-color: #1a1411;
    color: #faf6ee;
  }
  .arrow { transition: transform 0.3s ease; }
  .all-link:hover .arrow { transform: translateX(4px); }
</style>
