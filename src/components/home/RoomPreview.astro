---
/**
 * RoomPreview 元件 v3 — Editorial Carousel-grid
 *
 * 首頁房型預覽區。
 * 視覺改為 magazine 兩欄橫向排版：
 *   - 左：標題 + lead + see-all CTA（垂直置中）
 *   - 右：房型卡片網格（2x2 或滾動）
 *   - 每張卡片以 minimal 圖 + 襯線 name + 大號編號裝飾
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allRooms = await getCollection('rooms');
if (!allRooms.length) {
  throw new Error('[content] rooms collection 為空');
}
const previewRooms = allRooms
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug))
  .slice(0, 4);

const placeholderVariants = ['ocean', 'timber', 'sand', 'ink'] as const;
---

<section class="room-preview" aria-labelledby="room-preview-heading">
  <div class="container-wide grid">
    <div class="header">
      <span class="rule-gold" aria-hidden="true"></span>
      <h2 id="room-preview-heading" class="title">{t('home.roomPreviewHeading')}</h2>
      <p class="lead">{t('home.roomPreviewLead')}</p>
      <a class="btn-line" href={getLocalizedPath('/rooms', locale)}>
        {t('home.roomPreviewSeeAll')}
      </a>
    </div>
    <ul class="cards">
      {
        previewRooms.map((room, idx) => {
          const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
          const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
          const variant = placeholderVariants[idx % placeholderVariants.length] ?? 'ocean';
          const href = getLocalizedPath(`/rooms/${room.data.slug}`, locale);
          const num = String(idx + 1).padStart(2, '0');
          return (
            <li class="card">
              <a href={href} class="card-link" aria-label={name}>
                <div class="image-wrap">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio="4:3"
                    variant={variant}
                  />
                </div>
                <div class="card-body">
                  <span class="card-num" aria-hidden="true">{num}</span>
                  <h3 class="name">{name}</h3>
                  <p class="meta">
                    <span>{room.data.size}{t('rooms.sizeUnit')}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{room.data.capacity}{t('rooms.capacityUnit')}</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span>{view}</span>
                  </p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .room-preview {
    padding-block: 8rem;
    background-color: var(--color-bone-100);
  }
  .grid {
    display: grid;
    gap: 3.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 0.8fr 1.4fr;
      gap: 4.5rem;
      align-items: start;
    }
  }
  .header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.85rem);
    color: var(--color-ink-900);
    line-height: 1.18;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .lead {
    margin: 0;
    color: var(--color-ink-600);
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
    max-width: 30rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .cards { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; }
  }
  .card { display: flex; flex-direction: column; }
  .card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    gap: 1.25rem;
  }
  .image-wrap {
    overflow: hidden;
    transition: transform 800ms var(--ease-editorial);
  }
  .card-link:hover .image-wrap { transform: scale(1.015); }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.36em;
    color: var(--color-copper-600);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
    transition: color 280ms var(--ease-editorial);
  }
  .card-link:hover .name { color: var(--color-copper-600); }
  :lang(en) .name {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .meta {
    margin: 0;
    color: var(--color-ink-600);
    font-family: var(--font-display);
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .dot {
    color: var(--color-copper-500);
    opacity: 0.7;
  }
</style>
