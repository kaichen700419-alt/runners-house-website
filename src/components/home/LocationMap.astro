---
/**
 * LocationMap v4 — D1 Screen 10「位置與交通」
 *
 * 設計依據：研究報告 D1.Screen 10 + B7 Hotarutei 在地交通文化
 *   - 沙白底 + 大量留白
 *   - 左：經緯度大字 + 在地交通指引（步行/騎車單位）
 *   - 右：Mapbox/Google Maps 嵌入，灰階柔化
 *   - 章節 marker + editorial 標題
 *   - 4 種交通方式改為「文字一行 + 細線分隔」magazine 表格樣式
 */
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import { GEO, CONTACT } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const mapQuery = encodeURIComponent(`${GEO.latitude},${GEO.longitude}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${locale === 'en' ? 'en' : 'zh-TW'}&z=14&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section class="location" id="location" aria-labelledby="location-heading">
  {/* 原「X CHAPTER」羅馬數字裝飾已移除：行動版斷行後只剩孤兒「X」字元（2026-07 健檢發現），
      且業主先前已明確反饋不喜歡章節編號裝飾 */}
  <div class="container-wide header reveal" data-delay="1">
    <h2 id="location-heading" class="title">{t('home.locationHeading')}</h2>
    <p class="lead">{t('home.locationLead')}</p>
  </div>

  <div class="container-wide grid">
    <div class="info reveal" data-delay="2">
      <div class="coord">
        <span class="coord-label">N</span>
        <span class="coord-value">23.32°</span>
      </div>
      <div class="coord">
        <span class="coord-label">E</span>
        <span class="coord-value">121.46°</span>
      </div>
      <p class="address">{t('common.addressFull')}</p>
      <ul class="bullets">
        <li>
          <span class="bullet-mark" aria-hidden="true">↓</span>
          <span>{t('home.locationDriveSouth')}</span>
        </li>
        <li>
          <span class="bullet-mark" aria-hidden="true">↑</span>
          <span>{t('home.locationDriveNorth')}</span>
        </li>
        <li>
          <span class="bullet-mark" aria-hidden="true">P</span>
          <span>{t('home.locationParking')}</span>
        </li>
        <li>
          <span class="bullet-mark" aria-hidden="true">B</span>
          <span>{t('home.locationTransit')}</span>
        </li>
      </ul>
      <a class="btn-line is-sea" href={mapsLink} target="_blank" rel="noopener noreferrer">
        {t('home.locationMapCta')}
      </a>
    </div>
    <div class="map reveal" data-delay="3">
      <iframe
        title={t('footer.mapAria')}
        aria-label={t('footer.mapAria')}
        src={mapEmbedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        sandbox="allow-scripts allow-same-origin allow-popups"
        width="100%"
        height="540"
      ></iframe>
    </div>
  </div>

  {/* === 聯絡 CTA 面板（業主要求：位置與聯絡 CTA 同屏） === */}
  <div class="container-wide cta-row reveal" data-delay="4">
    <div class="cta-panel">
      <div class="cta-info">
        <span class="cta-eyebrow">{locale === 'en' ? 'BOOK & ARRIVE' : '訂房與到訪'}</span>
        <h3 class="cta-title">{t('home.closingHeading')}</h3>
        <p class="cta-lead">{t('home.closingLead')}</p>
        <ul class="cta-meta">
          <li><span class="meta-label">{t('footer.phoneLabel')}</span><a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a></li>
          <li><span class="meta-label">{t('footer.emailLabel')}</span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><span class="meta-label">{t('footer.lineLabel')}</span><span>{CONTACT.lineId}</span></li>
          <li><span class="meta-label">{t('common.checkInWindow').split(' ')[0]}</span><span>{t('common.checkInWindow')}</span></li>
        </ul>
      </div>
      <div class="cta-buttons">
        <a class="cta-big cta-line" href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
          <span class="cta-big-num">01</span>
          <span class="cta-big-text">{t('home.closingCtaLine')}</span>
          <span class="cta-big-arrow" aria-hidden="true">→</span>
        </a>
        <a class="cta-big cta-phone" href={`tel:${CONTACT.phone}`}>
          <span class="cta-big-num">02</span>
          <span class="cta-big-text">{t('home.closingCtaPhone')}</span>
          <span class="cta-big-arrow" aria-hidden="true">→</span>
        </a>
        <a class="cta-big cta-rooms" href={getLocalizedPath('/rooms', locale)}>
          <span class="cta-big-num">03</span>
          <span class="cta-big-text">{t('home.closingCtaRooms')}</span>
          <span class="cta-big-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    padding-block: 4.5rem 5rem;
    background-color: var(--color-sand-50);
    border-top: 1px solid var(--color-divider);
  }
  @media (min-width: 1024px) {
    .location { padding-block: 6rem 7rem; }
  }
  .header {
    margin-bottom: 3rem;
    max-width: 56rem;
  }
  .title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    font-weight: 500;
    line-height: 1.18;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 0;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
    max-width: 32rem;
  }
  :lang(en) .lead { font-family: var(--font-display-en); }
  .grid {
    display: grid;
    gap: 4rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 0.7fr 1.4fr;
      gap: 5rem;
      align-items: start;
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .coord {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-display-en);
  }
  .coord-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    color: var(--color-sun-500);
    text-transform: uppercase;
    width: 1.5rem;
  }
  .coord-value {
    font-style: italic;
    font-size: clamp(2rem, 3vw, 2.8rem);
    color: var(--color-sea-500);
    letter-spacing: -0.03em;
    font-weight: 400;
    line-height: 1;
  }
  .address {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-ink-900);
    line-height: 1.7;
    letter-spacing: 0.02em;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-divider);
  }
  :lang(en) .address { font-family: var(--font-display-en); }
  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .bullets li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.85rem;
    align-items: center;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.85;
    padding-block: 1rem;
    border-top: 1px solid var(--color-divider);
  }
  .bullet-mark {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-sea-500);
    color: var(--color-sea-500);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
  .map {
    border: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .map iframe {
    display: block;
    border: 0;
    width: 100%;
    /* 灰階柔化讓地圖視覺退為背景，不搶走主視覺 */
    filter: grayscale(0.6) brightness(0.96) contrast(0.95);
  }

  /* === 聯絡 CTA 面板 === */
  .cta-row {
    margin-top: 4rem;
  }
  .cta-panel {
    border: 1px solid var(--color-divider);
    background-color: var(--color-sand-100);
    padding: 2.5rem 1.75rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .cta-panel {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
      padding: 3.5rem 3rem;
    }
  }
  .cta-info { display: flex; flex-direction: column; gap: 1rem; }
  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.36em;
    color: var(--color-sun-500);
    text-transform: uppercase;
  }
  .cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.2;
    font-weight: 500;
  }
  :lang(en) .cta-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .cta-lead {
    margin: 0;
    color: var(--color-ink-600);
    font-size: 0.96rem;
    line-height: 1.85;
    max-width: 32rem;
  }
  .cta-meta {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-divider);
  }
  @media (min-width: 540px) {
    .cta-meta { grid-template-columns: 1fr 1fr; }
  }
  .cta-meta li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-divider);
    font-size: 0.92rem;
  }
  @media (min-width: 540px) {
    .cta-meta li:nth-child(2n+1) { padding-right: 1.5rem; }
  }
  .cta-meta a {
    color: var(--color-ink-900);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 280ms var(--ease-editorial);
  }
  .cta-meta a:hover { border-color: var(--color-sun-400); }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }

  /* CTA 三大按鈕 */
  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .cta-big {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-divider);
    text-decoration: none;
    color: var(--color-ink-900);
    transition: color 320ms var(--ease-editorial), padding 320ms var(--ease-editorial);
  }
  .cta-big:last-child { border-bottom: 1px solid var(--color-divider); }
  .cta-big:hover { color: var(--color-sea-500); padding-inline: 0.6rem; }
  .cta-big-num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-sun-400);
    letter-spacing: -0.03em;
    font-weight: 400;
    min-width: 2.5rem;
  }
  .cta-big-text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    letter-spacing: 0.02em;
    font-weight: 500;
  }
  :lang(en) .cta-big-text {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .cta-big-arrow {
    font-size: 1.2rem;
    color: var(--color-sea-500);
    transition: transform 320ms var(--ease-editorial);
  }
  .cta-big:hover .cta-big-arrow { transform: translateX(6px); }
</style>
