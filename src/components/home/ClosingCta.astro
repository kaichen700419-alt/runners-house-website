---
/**
 * ClosingCta v4 — D1 Screen 12「Ready to slow down?」
 *
 * 設計依據：研究報告 D1.Screen 12 + B17 Hotel Garden 矛盾感標語
 *   - 全寬深 charcoal 收尾區塊
 *   - 巨字「Ready to slow down?」（Bodoni Moda Italic）
 *   - 三聯 CTA：LINE / 電話 / 看房型 — 每個一個 SVG icon + 大標 + 副字
 *   - 不再 emoji，不再色塊，僅用線稿與細線
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lineUrl = CONTACT.lineUrl;
const phone = CONTACT.phonePrimary;
const phoneTel = CONTACT.phonePrimaryTel;
---

<section class="closing" aria-labelledby="closing-heading">
  <div class="container-wide chapter-row reveal">
    <div class="chapter-mark on-dark">
      <span class="num">XII</span>
      <span class="label">CHAPTER · {locale === 'en' ? 'COME HOME' : '回到海邊'}</span>
    </div>
  </div>

  <div class="container-wide inner reveal" data-delay="1">
    <h2 id="closing-heading" class="title">{t('home.closingHeading')}</h2>
    <p class="lead">{t('home.closingLead')}</p>
  </div>

  <ul class="ctas reveal" data-delay="2">
    <li>
      <a class="cta-card" href={lineUrl} target="_blank" rel="noopener noreferrer">
        <svg class="cta-icon" viewBox="0 0 60 60" aria-hidden="true">
          <rect x="14" y="14" width="32" height="26" rx="13" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M22 46 L26 40 L18 40 Z" fill="currentColor" />
          <line x1="22" y1="26" x2="22" y2="32" stroke="currentColor" stroke-width="1.2" />
          <line x1="30" y1="26" x2="30" y2="32" stroke="currentColor" stroke-width="1.2" />
          <line x1="38" y1="26" x2="38" y2="32" stroke="currentColor" stroke-width="1.2" />
        </svg>
        <span class="cta-label">{t('home.closingCtaLine')}</span>
        <span class="cta-sub">{locale === 'en' ? 'Fastest reply' : '最快回覆'}</span>
      </a>
    </li>
    <li>
      <a class="cta-card" href={`tel:${phoneTel}`}>
        <svg class="cta-icon" viewBox="0 0 60 60" aria-hidden="true">
          <path d="M16 16 C16 14 18 14 20 14 L24 14 L26 22 L22 26 C26 32 28 34 34 38 L38 34 L46 36 L46 40 C46 42 46 44 44 44 C30 44 16 30 16 16 Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
        <span class="cta-label">{t('home.closingCtaPhone')}</span>
        <span class="cta-sub">{phone}</span>
      </a>
    </li>
    <li>
      <a class="cta-card" href={getLocalizedPath('/rooms', locale)}>
        <svg class="cta-icon" viewBox="0 0 60 60" aria-hidden="true">
          <rect x="14" y="22" width="32" height="22" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M10 26 L30 12 L50 26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <line x1="22" y1="44" x2="22" y2="34" stroke="currentColor" stroke-width="1.2" />
          <line x1="22" y1="34" x2="38" y2="34" stroke="currentColor" stroke-width="1.2" />
          <line x1="38" y1="34" x2="38" y2="44" stroke="currentColor" stroke-width="1.2" />
        </svg>
        <span class="cta-label">{t('home.closingCtaRooms')}</span>
        <span class="cta-sub">{locale === 'en' ? 'See all rooms' : '看完整房型'}</span>
      </a>
    </li>
  </ul>
</section>

<style>
  .closing {
    padding-block: 9rem 11rem;
    background-color: var(--color-ink-950);
    color: var(--color-sand-100);
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .closing { padding-block: 12rem 14rem; }
  }
  .chapter-row { margin-bottom: 5rem; }
  .chapter-mark.on-dark .num { color: var(--color-sun-400); }
  .chapter-mark.on-dark .label { color: var(--color-sand-300); }

  .inner {
    max-width: 56rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 6rem;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.5vw, 5.25rem);
    color: var(--color-sand-100);
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-weight: 500;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .lead {
    margin: 0;
    color: var(--color-sand-300);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
    max-width: 36rem;
  }
  :lang(en) .lead { font-family: var(--font-display-en); }

  .ctas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid rgb(201 125 93 / 0.3);
    border-bottom: 1px solid rgb(201 125 93 / 0.3);
  }
  @media (min-width: 768px) {
    .ctas {
      grid-template-columns: repeat(3, 1fr);
    }
    .ctas li + li {
      border-left: 1px solid rgb(201 125 93 / 0.3);
    }
  }
  .ctas li {
    border-top: 1px solid rgb(201 125 93 / 0.3);
  }
  .ctas li:first-child { border-top: none; }
  @media (min-width: 768px) {
    .ctas li { border-top: none; }
  }
  .cta-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 3.5rem 2.5rem;
    text-decoration: none;
    color: var(--color-sand-100);
    transition: background-color 540ms var(--ease-editorial);
    height: 100%;
  }
  .cta-card:hover {
    background-color: rgb(201 125 93 / 0.06);
  }
  .cta-icon {
    width: 56px;
    height: 56px;
    color: var(--color-sun-400);
    transition: transform 540ms var(--ease-editorial), color 540ms var(--ease-editorial);
  }
  .cta-card:hover .cta-icon {
    transform: translateX(4px);
    color: var(--color-sun-300);
  }
  .cta-label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    color: var(--color-sand-100);
    letter-spacing: 0.01em;
    line-height: 1.2;
    font-weight: 500;
    margin-top: 0.5rem;
  }
  :lang(en) .cta-label {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .cta-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    color: var(--color-sand-400);
    text-transform: uppercase;
  }
</style>
