---
/**
 * ClosingCta — 首頁底部 CTA（自己設計版）
 *
 * 結構：深色背景 + 置中標題 + 三聯按鈕（LINE / 電話 / 房型）
 * 完全無：彩色裝飾、章節編號、複雜佈局
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const heading = t('home.closingCtaHeading');
const subtitle = t('home.closingCtaSubtitle');
const ctaRooms = locale === 'en' ? 'View Rooms' : '查看房型';
const ctaLine = locale === 'en' ? 'Book via LINE' : 'LINE 訂房';
const ctaPhone = locale === 'en' ? 'Call us' : '致電聯絡';
---

<section class="closing" aria-labelledby="closing-heading">
  <div class="closing-inner">
    <h2 id="closing-heading" class="heading">{heading}</h2>
    <p class="subtitle">{subtitle}</p>

    <div class="ctas">
      <a class="cta cta-primary" href={getLocalizedPath('/rooms', locale)}>
        {ctaRooms}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="cta cta-line" href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
        {ctaLine}
      </a>
      <a class="cta cta-phone" href={`tel:${CONTACT.phone}`}>
        {ctaPhone} {CONTACT.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .closing {
    background:
      radial-gradient(ellipse at 50% 30%, rgba(184, 142, 92, 0.18) 0%, transparent 60%),
      linear-gradient(160deg, #2d2520 0%, #1a1411 60%, #1a1411 100%);
    color: #f5efe5;
    padding: 6rem 1.5rem;
  }
  @media (min-width: 768px) {
    .closing { padding: 8rem 2.5rem; }
  }
  .closing-inner {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .heading {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  .subtitle {
    margin: 0;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 300;
    max-width: 36rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.05rem 2.25rem;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-decoration: none;
    border: 1.5px solid transparent;
    border-radius: 2px;
    transition: all 0.3s ease;
    min-width: 11rem;
  }
  .cta-primary {
    background-color: #ffffff;
    color: #1a1411;
    border-color: #ffffff;
  }
  .cta-primary:hover {
    background-color: transparent;
    color: #ffffff;
  }
  .cta-line {
    background-color: #00b900;
    color: #ffffff;
    border-color: #00b900;
  }
  .cta-line:hover {
    background-color: #009900;
    border-color: #009900;
  }
  .cta-phone {
    background-color: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.65);
  }
  .cta-phone:hover {
    background-color: #ffffff;
    color: #1a1411;
    border-color: #ffffff;
  }
  .arrow { transition: transform 0.3s ease; }
  .cta-primary:hover .arrow { transform: translateX(4px); }

  @media (max-width: 640px) {
    .cta { width: 100%; max-width: 280px; }
  }
</style>
