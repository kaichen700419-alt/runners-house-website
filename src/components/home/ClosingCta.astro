---
/**
 * ClosingCta 元件 v3 — Editorial Closing
 *
 * 首頁底部最終 CTA：LINE / 電話 / 看房型。
 * 視覺改為深 ink + 銅金細線 + 三聯極簡選項。
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lineUrl = CONTACT.lineUrl;
const phone = CONTACT.phonePrimary;
const phoneTel = CONTACT.phonePrimaryTel;
---

<section class="closing" aria-labelledby="closing-heading">
  <div class="container-narrow inner">
    <span class="rule-gold rule-gold-center" aria-hidden="true"></span>
    <h2 id="closing-heading" class="title">{t('home.closingHeading')}</h2>
    <p class="lead">{t('home.closingLead')}</p>
    <ul class="ctas">
      <li>
        <a class="cta" href={lineUrl} target="_blank" rel="noopener noreferrer">
          <span class="cta-mark" aria-hidden="true">L</span>
          <span class="cta-label">{t('home.closingCtaLine')}</span>
        </a>
      </li>
      <li>
        <a class="cta" href={`tel:${phoneTel}`}>
          <span class="cta-mark" aria-hidden="true">☎</span>
          <span class="cta-label">{t('home.closingCtaPhone')}</span>
          <span class="cta-sub">{phone}</span>
        </a>
      </li>
      <li>
        <a class="cta" href={getLocalizedPath('/rooms', locale)}>
          <span class="cta-mark" aria-hidden="true">⌂</span>
          <span class="cta-label">{t('home.closingCtaRooms')}</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .closing {
    padding-block: 8rem;
    background-color: var(--color-ink-950);
    color: var(--color-bone-100);
  }
  .inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    color: var(--color-bone-100);
    letter-spacing: 0.02em;
    line-height: 1.18;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .lead {
    margin: 0 0 2rem;
    color: rgb(245 239 230 / 0.72);
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-style: italic;
    font-weight: 300;
    max-width: 36rem;
    line-height: 1.95;
  }
  .ctas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: 100%;
    max-width: 56rem;
    border-top: 1px solid rgb(160 134 96 / 0.3);
  }
  .ctas li {
    border-bottom: 1px solid rgb(160 134 96 / 0.3);
  }
  @media (min-width: 768px) {
    .ctas {
      grid-template-columns: repeat(3, 1fr);
      border-top: none;
    }
    .ctas li {
      border-bottom: none;
      border-right: 1px solid rgb(160 134 96 / 0.3);
    }
    .ctas li:first-child {
      border-left: 1px solid rgb(160 134 96 / 0.3);
    }
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: 2.5rem 1rem;
    text-decoration: none;
    color: var(--color-bone-100);
    transition:
      background-color 320ms var(--ease-editorial),
      color 320ms var(--ease-editorial);
  }
  .cta:hover {
    background-color: rgb(160 134 96 / 0.1);
    color: var(--color-copper-300);
  }
  .cta-mark {
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--color-copper-500);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-copper-300);
    transition: border-color 320ms var(--ease-editorial), color 320ms var(--ease-editorial);
  }
  .cta:hover .cta-mark {
    border-color: var(--color-copper-300);
  }
  .cta-label {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.06em;
    font-weight: 400;
  }
  .cta-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-bone-400);
  }
</style>
