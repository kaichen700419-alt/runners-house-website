---
/**
 * ClosingCta 元件
 *
 * 首頁底部最終三聯 CTA：LINE / 電話 / 看房型。
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lineUrl = CONTACT.lineUrl;
const phone = CONTACT.phonePrimary;
const phoneTel = CONTACT.phonePrimaryTel;
---

<section class="closing">
  <div class="container-wide inner">
    <h2 class="title">{t('home.closingHeading')}</h2>
    <p class="lead">{t('home.closingLead')}</p>
    <div class="ctas">
      <a class="cta cta-line" href={lineUrl} target="_blank" rel="noopener noreferrer">
        <span class="icon" aria-hidden="true">L</span>
        <span class="label">{t('home.closingCtaLine')}</span>
      </a>
      <a class="cta cta-phone" href={`tel:${phoneTel}`}>
        <span class="icon" aria-hidden="true">☎</span>
        <span class="label">{t('home.closingCtaPhone')}</span>
        <span class="phone-num">{phone}</span>
      </a>
      <a class="cta cta-rooms" href={getLocalizedPath('/rooms', locale)}>
        <span class="icon" aria-hidden="true">⌂</span>
        <span class="label">{t('home.closingCtaRooms')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: 5rem;
    background:
      radial-gradient(circle at 20% 0%, var(--color-ocean-700), transparent 50%),
      radial-gradient(circle at 80% 100%, var(--color-timber-800), transparent 50%),
      var(--color-ink-950);
    color: white;
  }
  .inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    color: white;
    line-height: 1.2;
  }
  .lead {
    margin: 0 0 1rem;
    color: rgb(255 255 255 / 0.78);
    font-size: 1rem;
    max-width: 38rem;
    line-height: 1.7;
  }
  .ctas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    width: 100%;
    max-width: 36rem;
  }
  @media (min-width: 768px) {
    .ctas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem 1rem;
    border-radius: 1rem;
    text-decoration: none;
    color: white;
    background-color: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.15);
    backdrop-filter: blur(10px);
    transition:
      transform 220ms var(--ease-snappy),
      background-color 220ms var(--ease-snappy),
      box-shadow 220ms var(--ease-snappy),
      border-color 220ms var(--ease-snappy);
  }
  .cta:hover {
    transform: translateY(-4px);
    background-color: rgb(255 255 255 / 0.14);
    border-color: rgb(255 255 255 / 0.35);
    box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.55);
  }
  .cta:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }
  .cta-line:hover { background-color: rgb(34 197 94 / 0.25); }
  .cta-phone:hover { background-color: rgb(14 165 233 / 0.25); }
  .cta-rooms:hover { background-color: rgb(193 160 112 / 0.25); }
  .icon {
    font-size: 1.5rem;
    line-height: 1;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .label {
    font-weight: 600;
    font-size: 1rem;
  }
  .phone-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.7);
  }
</style>
