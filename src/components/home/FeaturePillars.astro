---
/**
 * FeaturePillars 元件 v3 — Editorial Triptych
 *
 * 首頁三聯：Run / Stay / Charge。
 * 視覺改為「magazine 三聯式」雜誌排版：
 *   - 不再 emoji + 卡片堆疊
 *   - 三欄之間用銅金細直線分隔
 *   - 標題用小寫襯線斜體 + 大號編號
 *   - 描述用襯線體 + 散文行高
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pillars = [
  {
    num: 'I',
    label: 'RUN',
    titleKey: 'home.featureRunTitle',
    descKey: 'home.featureRunDescription',
    ctaKey: 'home.featureRunCta',
    href: '/runners',
  },
  {
    num: 'II',
    label: 'STAY',
    titleKey: 'home.featureStayTitle',
    descKey: 'home.featureStayDescription',
    ctaKey: 'home.featureStayCta',
    href: '/rooms',
  },
  {
    num: 'III',
    label: 'CHARGE',
    titleKey: 'home.featureChargeTitle',
    descKey: 'home.featureChargeDescription',
    ctaKey: 'home.featureChargeCta',
    href: '/charging',
  },
];
---

<section class="features" aria-labelledby="features-heading">
  <div class="container-narrow header">
    <span class="rule-gold rule-gold-center" aria-hidden="true"></span>
    <h2 id="features-heading" class="title">{t('home.featuresHeading')}</h2>
    <p class="lead">{t('home.featuresLead')}</p>
  </div>

  <div class="container-wide">
    <ul class="grid">
      {
        pillars.map((p) => (
          <li class="pillar">
            <span class="num" aria-hidden="true">{p.num}</span>
            <span class="label" aria-hidden="true">{p.label}</span>
            <h3 class="pillar-title">{t(p.titleKey)}</h3>
            <p class="desc">{t(p.descKey)}</p>
            <a class="cta" href={getLocalizedPath(p.href, locale)}>
              {t(p.ctaKey)}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    padding-block: 8rem;
    background-color: var(--color-bone-50);
  }
  .header {
    text-align: center;
    margin-bottom: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    line-height: 1.18;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .lead {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--color-ink-600);
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .pillar + .pillar {
      border-left: 1px solid rgb(160 134 96 / 0.25);
      padding-left: 3rem;
    }
    .pillar:not(:last-child) {
      padding-right: 3rem;
    }
  }
  .pillar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 1rem;
  }
  .num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-copper-500);
    line-height: 1;
    font-weight: 300;
    letter-spacing: 0.04em;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: var(--color-copper-600);
    text-transform: uppercase;
  }
  .pillar-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    line-height: 1.25;
    font-weight: 400;
  }
  :lang(en) .pillar-title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.95;
    flex: 1;
  }
  .cta {
    align-self: flex-start;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink-900);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-copper-500);
    padding-bottom: 0.4rem;
    transition: color 280ms var(--ease-editorial), gap 280ms var(--ease-editorial);
  }
  .cta:hover { color: var(--color-copper-600); gap: 0.95rem; }
  .arrow {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
</style>
