---
/**
 * FeaturePillars — 三大特色（自己設計版）
 *
 * 結構：上方標題置中 + 下方三欄等寬卡片（米色底木金細邊）
 * 每張卡片：標題 + 簡短描述 + Read more
 * 完全無：羅馬數字、SVG icon 線稿、橘色 hover 細線、章節編號
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pillars = [
  {
    title: t('home.featureRunTitle'),
    description: t('home.featureRunDescription'),
    cta: locale === 'en' ? 'Runners' : '查看跑者體驗',
    href: getLocalizedPath('/runners', locale),
  },
  {
    title: t('home.featureStayTitle'),
    description: t('home.featureStayDescription'),
    cta: locale === 'en' ? 'Rooms' : '查看房型',
    href: getLocalizedPath('/rooms', locale),
  },
  {
    title: t('home.featureChargeTitle'),
    description: t('home.featureChargeDescription'),
    cta: locale === 'en' ? 'Charging' : '查看充電服務',
    href: getLocalizedPath('/charging', locale),
  },
];
---

<section class="pillars" aria-labelledby="pillars-heading">
  <div class="pillars-inner">
    <header class="pillars-header">
      <p class="eyebrow">{locale === 'en' ? 'What we offer' : '三大特色'}</p>
      <h2 id="pillars-heading" class="heading">{t('home.pillarsHeading')}</h2>
    </header>

    <div class="grid">
      {pillars.map((p) => (
        <article class="card">
          <h3 class="card-title">{p.title}</h3>
          <p class="card-desc">{p.description}</p>
          <a class="card-link" href={p.href}>
            {p.cta}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars {
    background-color: #f5efe5;
    padding: 6rem 1.5rem;
  }
  @media (min-width: 768px) {
    .pillars { padding: 8rem 2.5rem; }
  }
  .pillars-inner {
    max-width: 78rem;
    margin: 0 auto;
  }
  .pillars-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    font-family: 'Noto Sans TC', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #8b6f47;
    font-weight: 500;
  }
  .heading {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    color: #1a1411;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  .card {
    background-color: #ffffff;
    padding: 2.5rem 2rem;
    border: 1px solid #e8dfce;
    transition: border-color 0.3s ease, transform 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 18rem;
  }
  .card:hover {
    border-color: #8b6f47;
    transform: translateY(-4px);
  }
  .card-title {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: #1a1411;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .card-desc {
    margin: 0;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.95rem;
    line-height: 1.85;
    color: #4a3f33;
    font-weight: 300;
    flex: 1;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: #8b6f47;
    text-decoration: none;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border-bottom: 1px solid transparent;
    padding-bottom: 4px;
    align-self: flex-start;
    transition: border-color 0.2s ease, gap 0.3s ease;
  }
  .card-link:hover {
    border-color: #8b6f47;
    gap: 0.875rem;
  }
</style>
