---
/**
 * FeaturePillars 元件
 *
 * 首頁三聯卡片：Run / Stay / Charge。
 * 三張卡片以 emoji + 標題 + 描述 + 連結組成，採 grid 排版。
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const pillars = [
  {
    icon: '\u{1F3C3}',
    titleKey: 'home.featureRunTitle',
    descKey: 'home.featureRunDescription',
    ctaKey: 'home.featureRunCta',
    href: '/runners',
    accent: 'ocean' as const,
  },
  {
    icon: '\u{1F3E1}',
    titleKey: 'home.featureStayTitle',
    descKey: 'home.featureStayDescription',
    ctaKey: 'home.featureStayCta',
    href: '/rooms',
    accent: 'timber' as const,
  },
  {
    icon: '\u{26A1}',
    titleKey: 'home.featureChargeTitle',
    descKey: 'home.featureChargeDescription',
    ctaKey: 'home.featureChargeCta',
    href: '/charging',
    accent: 'sand' as const,
  },
];
---

<section class="features">
  <div class="container-wide">
    <SectionHeading
      title={t('home.featuresHeading')}
      subtitle={t('home.featuresLead')}
      align="center"
      variant="ocean"
    />
    <ul class="grid">
      {
        pillars.map((p) => (
          <li class={`card accent-${p.accent}`}>
            <span class="icon" aria-hidden="true">{p.icon}</span>
            <h3 class="title">{t(p.titleKey)}</h3>
            <p class="desc">{t(p.descKey)}</p>
            <a class="cta" href={getLocalizedPath(p.href, locale)}>
              {t(p.ctaKey)}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    padding-block: 5rem;
    background-color: var(--color-timber-50);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background-color: white;
    border-radius: 1.25rem;
    border: 1px solid var(--color-timber-200);
    transition: transform 220ms var(--ease-snappy), box-shadow 220ms var(--ease-snappy);
    position: relative;
    overflow: hidden;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    opacity: 0.6;
  }
  .accent-ocean { color: var(--color-ocean-600); }
  .accent-timber { color: var(--color-timber-600); }
  .accent-sand { color: var(--color-sand-600); }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -20px rgb(15 23 42 / 0.18);
  }
  .icon {
    font-size: 2.25rem;
    line-height: 1;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ink-950);
  }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.7;
    flex: 1;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ocean-700);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cta:hover .arrow {
    transform: translateX(3px);
  }
  .arrow {
    transition: transform 200ms var(--ease-snappy);
  }
</style>
