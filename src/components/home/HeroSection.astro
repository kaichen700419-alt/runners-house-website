---
/**
 * HeroSection v5 — 「真正的精品民宿首屏」
 *
 * 業主反饋：v4 的「左大字 + 右火柴人 SVG」看起來像兒童畫、空白幼稚。
 * v5 重做策略（依 Aman / Hoshinoya / The Drake 等真實官網的 hero 做法）：
 *   1. 完全移除火柴人 SVG 場景插畫
 *   2. 改成「左 45% 飽滿文字內容 + 右 55% 大型 Photo Placeholder（80vh 高）」
 *   3. 文字側內容一次到位：
 *      eyebrow（地理座標 + 海岸線編號）
 *      → H1 大標（兩行錯落）
 *      → 一段 60-80 字介紹副文（lead）
 *      → 三聯 CTA（看房型 / LINE 訂房 / 撥電話）
 *      → 規格條（入住時間 / 位置 / 房型數）
 *   4. 圖框側用 ImagePlaceholder（ratio 3:4）佔據 right column 全高
 *   5. 移除桌面 cursor / season kinetic loop 等花俏效果，回歸內容
 *
 * 設計克制度：仍保留 italic 副標、章節編號、scroll cue 等精品細節，
 * 但所有「看起來像兒童畫的元素」全部刪除。
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// 地理座標 + 海岸線編號（呼應 Hotarutei 等精品民宿的「定錨」eyebrow）
const COORD = '23.32°N · 121.46°E';
const KM_LABEL = locale === 'en' ? 'KM 91 · TAITUNG COAST RD' : '台 11 線 · 91K · 台東長濱';

// === Hero 標題切兩行 ===
// 業主反饋「錯落排版很醜」— 改為單一段落自然換行，不強制斷句、無裝飾色塊
const fullTitle: string = t('home.heroTitle');

const tagline: string = t('common.brandStatement');
const subtitle: string = t('home.heroSubtitle');

// hero 圖框的 caption（中文：海邊老米倉外觀；英文 fallback）
const heroPhotoAlt = locale === 'en'
  ? 'The reborn rice barn at sunrise, Changbin coast'
  : '海邊老米倉清晨外觀（主視覺照片）';

// hero 下方規格條：精品民宿常見的「at-a-glance facts」
const facts = locale === 'en'
  ? [
      { label: 'CHECK-IN',    value: '15:00 – 21:00' },
      { label: 'LOCATION',    value: 'KM 91 · Coast Rd' },
      { label: 'ROOMS',       value: '5 Suites' },
      { label: 'CHARGING',    value: 'Tesla Wall' },
    ]
  : [
      { label: 'CHECK-IN',    value: '15:00 – 21:00' },
      { label: 'LOCATION',    value: '台 11 線 · 91K' },
      { label: 'ROOMS',       value: '5 種房型' },
      { label: 'CHARGING',    value: 'Tesla 超充' },
    ];
---

<section class="hero" aria-labelledby="hero-title">
  {/* === 上方頂條：經緯度 / 章節 === */}
  <div class="hero-topbar" aria-hidden="true">
    <span class="topbar-coord">{COORD}</span>
    <span class="topbar-divider"></span>
    <span class="topbar-km">{KM_LABEL}</span>
    <span class="topbar-spacer"></span>
    <span class="topbar-edition">CHAPTER I · {locale === 'en' ? 'A HOUSE BY THE SEA' : '海邊的房子'}</span>
  </div>

  {/* === 主視覺：左字 / 右大圖框 === */}
  <div class="hero-stage container-wide">
    {/* 左欄：飽滿文字內容 */}
    <div class="hero-text">
      {/* eyebrow — 單純文字無裝飾圓點 */}
      <p class="hero-eyebrow">{t('home.heroEyebrow')}</p>

      {/* H1 — 乾淨單一段落，自然換行不強制錯落 */}
      <h1 id="hero-title" class="hero-title">{fullTitle}</h1>

      {/* italic 英文 brand statement */}
      <p class="hero-eng"><em>{tagline}</em></p>

      {/* 副標：60-80 字完整介紹文 */}
      <p class="hero-lead">{subtitle}</p>

      {/* 三聯 CTA：主 CTA（深色填色）+ 兩個次要文字鏈 */}
      <div class="hero-ctas">
        <a class="cta-primary" href={getLocalizedPath('/rooms', locale)}>
          <span>{t('home.heroPrimaryCta')}</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
        <a class="cta-secondary" href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
          {t('common.addLine')}
        </a>
        <a class="cta-secondary" href={`tel:${CONTACT.phone}`}>
          {CONTACT.phoneDisplay}
        </a>
      </div>

      {/* 規格條（at-a-glance） */}
      <dl class="hero-facts" aria-label={locale === 'en' ? 'at a glance' : '關鍵資訊'}>
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    {/* 右欄：大型主視覺 Photo Placeholder */}
    <div class="hero-photo">
      <ImagePlaceholder
        locale={locale}
        alt={heroPhotoAlt}
        ratio="3:4"
        variant="ocean"
      />
      {/* 圖框右下角：精品民宿常見的「PROPERTY · TAITUNG」浮雕浮水印 */}
      <span class="photo-caption" aria-hidden="true">
        <span class="cap-num">N°01</span>
        <span class="cap-text">
          {locale === 'en'
            ? 'Reborn rice barn · Coastal hideaway'
            : '老米倉重生 · 海岸隱逸'}
        </span>
      </span>
    </div>
  </div>

  {/* === 底部 scroll cue === */}
  <div class="scroll-cue" aria-hidden="true">
    <span class="cue-text">SCROLL</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background-color: var(--color-sand-50);
    color: var(--color-ink-900);
    overflow: hidden;
    isolation: isolate;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  /* === 頂條：經緯度 + 章節 === */
  .hero-topbar {
    display: none;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    padding: 0 2.5rem;
    animation: fade-in 1100ms 200ms var(--ease-editorial) both;
  }
  @media (min-width: 1024px) {
    .hero-topbar { display: flex; }
  }
  @media (min-width: 1280px) {
    .hero-topbar { padding: 0 4rem; }
  }
  .topbar-coord, .topbar-km, .topbar-edition { white-space: nowrap; }
  .topbar-divider {
    width: 1px; height: 12px;
    background-color: var(--color-ink-300);
    opacity: 0.5;
  }
  .topbar-spacer { flex: 1; }
  .topbar-edition { color: var(--color-ink-500); }

  /* === Stage：左字 / 右圖 === */
  .hero-stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: 3rem 2rem;
  }
  @media (min-width: 1024px) {
    .hero-stage {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 4rem;
      padding-block: 4rem 3rem;
      min-height: calc(100dvh - 8rem);
    }
  }
  @media (min-width: 1280px) {
    .hero-stage { gap: 5.5rem; }
  }

  /* === 左欄文字 === */
  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    max-width: 38rem;
  }
  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-ink-900);
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.15;
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    /* 統一文字無錯落、無背景塊、無強制裝飾色 */
  }
  :lang(en) .hero-title {
    font-family: var(--font-display-hero);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  @keyframes line-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; } to { opacity: 1; }
  }

  .hero-eng {
    margin: 0.5rem 0 0;
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    color: var(--color-ink-500);
    letter-spacing: 0;
    line-height: 1.55;
    opacity: 0;
    animation: line-fade-up 1100ms 700ms var(--ease-out-expo) forwards;
  }
  .hero-eng em { font-style: italic; }

  .hero-lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.02rem;
    color: var(--color-ink-700);
    line-height: 1.85;
    letter-spacing: 0.015em;
    max-width: 34rem;
    opacity: 0;
    animation: line-fade-up 1100ms 850ms var(--ease-out-expo) forwards;
  }

  /* === CTAs：主深底鈕 + 兩個文字鏈 === */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    align-items: center;
    margin-top: 0.6rem;
    opacity: 0;
    animation: line-fade-up 1100ms 1000ms var(--ease-out-expo) forwards;
  }
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background-color: var(--color-ink-900);
    color: var(--color-sand-50);
    padding: 1.05rem 1.85rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    font-weight: 500;
    text-transform: uppercase;
    transition:
      background-color 360ms var(--ease-editorial),
      gap 360ms var(--ease-editorial);
  }
  :lang(en) .cta-primary {
    font-family: var(--font-display-en);
    font-style: italic;
    letter-spacing: 0.14em;
  }
  .cta-primary:hover {
    background-color: var(--color-sea-500);
    gap: 1.2rem;
  }
  .cta-arrow { font-size: 1rem; }

  .cta-secondary {
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-sun-400);
    padding-bottom: 0.3rem;
    transition: color 280ms var(--ease-editorial), border-color 280ms var(--ease-editorial);
  }
  .cta-secondary:hover {
    color: var(--color-sun-500);
    border-color: var(--color-sun-500);
  }
  :lang(en) .cta-secondary {
    font-family: var(--font-display-en);
    font-style: italic;
  }

  /* === 規格條 === */
  .hero-facts {
    margin: 1.4rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-divider);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.5rem;
    opacity: 0;
    animation: line-fade-up 1100ms 1150ms var(--ease-out-expo) forwards;
  }
  @media (min-width: 540px) {
    .hero-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .fact { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    margin: 0;
  }
  .fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-ink-900);
    letter-spacing: 0.01em;
    font-weight: 500;
    line-height: 1.3;
  }
  :lang(en) .fact dd {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }

  /* === 右欄大圖框 === */
  .hero-photo {
    position: relative;
    width: 100%;
    opacity: 0;
    animation: line-fade-up 1300ms 600ms var(--ease-out-expo) forwards;
    align-self: stretch;
  }
  @media (min-width: 1024px) {
    .hero-photo {
      display: flex;
      align-items: stretch;
      max-height: calc(100dvh - 12rem);
    }
    .hero-photo > :global(figure) {
      flex: 1;
      max-height: 100%;
    }
  }

  .photo-caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    background-color: rgb(247 244 237 / 0.92);
    backdrop-filter: blur(8px);
    padding: 0.7rem 1rem;
    pointer-events: none;
  }
  .photo-caption .cap-num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--color-sun-500);
    letter-spacing: -0.02em;
  }
  .photo-caption .cap-text {
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--color-ink-800);
    letter-spacing: 0.06em;
    line-height: 1.3;
  }
  :lang(en) .photo-caption .cap-text {
    font-family: var(--font-display-en);
    font-style: italic;
  }

  /* === 底部 scroll cue === */
  .scroll-cue {
    position: absolute;
    bottom: 1.2rem;
    right: 1.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .scroll-cue { display: flex; right: 2.5rem; }
  }
  @media (min-width: 1280px) {
    .scroll-cue { right: 4rem; }
  }
  .cue-text {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    transform: rotate(180deg);
    writing-mode: vertical-rl;
  }
  .cue-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(180deg, var(--color-ink-700), transparent);
    animation: cue-pulse 2400ms var(--ease-editorial) infinite;
    transform-origin: top;
  }
  @keyframes cue-pulse {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50% { transform: scaleY(0.4); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title .line, .hero-eng, .hero-lead, .hero-ctas, .hero-facts, .hero-photo, .hero-topbar, .cue-line {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
