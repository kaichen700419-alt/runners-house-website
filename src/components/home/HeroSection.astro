---
/**
 * HeroSection v6 — 「台灣熟悉精緻民宿」
 *
 * 業主明確指令：不再 Aman editorial 風、不要錯落、不要裝飾色塊、不要 SVG 圖示。
 * 採用台灣本土民宿熟悉版型（鹿境 / 緩慢 / 海或文旅）+ 守住質感：
 *   1. 上方主視覺大型橫式照片框（70vh），模擬真實主視覺
 *   2. 下方文字區置中對齊：
 *      eyebrow（地點）
 *      → H1 大標（單一段落，不錯落）
 *      → 副標（中英對照，italic 英文）
 *      → 介紹段落（2-3 行）
 *      → 三聯主按鈕（LINE 訂房 / 致電 / 看房型）
 *      → 底部資訊條（地址 / 電話 / Check-in）
 *   3. 配色：木色 + 灰白 + 自然綠 accent + 墨黑（業主家鄉熟悉感）
 *   4. 字型：思源宋體標題 + 思源黑體內文（不花俏）
 *   5. 完全無：錯落、裝飾橘色塊、SVG 火柴人、kinetic typography
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const fullTitle: string = t('home.heroTitle');
const tagline: string = t('common.brandStatement');
const subtitle: string = t('home.heroSubtitle');

const heroPhotoAlt = locale === 'en'
  ? 'Runners House at sunrise, Changbin Taitung'
  : '跑者之家主視覺：海岸線晨光';

const eyebrowText = locale === 'en' ? 'TAITUNG · CHANGBIN · HIGHWAY 11' : '台東 · 長濱 · 台 11 線 91K';
const ctaPrimary = locale === 'en' ? 'View Rooms' : '查看房型';
const ctaLine = locale === 'en' ? 'Book via LINE' : 'LINE 訂房';
const ctaPhone = locale === 'en' ? 'Call' : '致電';
const checkinLabel = locale === 'en' ? 'Check-in' : '入住時間';
const addressLabel = locale === 'en' ? 'Address' : '地址';
const phoneLabel = locale === 'en' ? 'Phone' : '電話';
const addressValue = locale === 'en'
  ? 'No. 47, Zhuhu Village, Changbin Township, Taitung'
  : '台東縣長濱鄉竹湖村 47 號';
---

<section class="hero" aria-labelledby="hero-title">
  {/* === 上方主視覺大照片區 === */}
  <div class="hero-photo">
    <ImagePlaceholder
      locale={locale}
      alt={heroPhotoAlt}
      ratio="21:9"
      variant="ocean"
    />
  </div>

  {/* === 下方文字內容區（置中對齊） === */}
  <div class="hero-text container-wide">
    <p class="hero-eyebrow">{eyebrowText}</p>

    <h1 id="hero-title" class="hero-title">{fullTitle}</h1>

    <p class="hero-tagline"><em>{tagline}</em></p>

    <p class="hero-subtitle">{subtitle}</p>

    {/* 三聯主按鈕（LINE / 電話 / 看房型） */}
    <div class="hero-ctas">
      <a class="cta cta-primary" href={getLocalizedPath('/rooms', locale)}>
        {ctaPrimary}
      </a>
      <a class="cta cta-line" href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer">
        {ctaLine}
      </a>
      <a class="cta cta-phone" href={`tel:${CONTACT.phone}`}>
        {ctaPhone} {CONTACT.phoneDisplay}
      </a>
    </div>

    {/* 底部資訊條 */}
    <dl class="hero-info">
      <div class="info-item">
        <dt>{checkinLabel}</dt>
        <dd>15:00 – 21:00</dd>
      </div>
      <div class="info-item">
        <dt>{addressLabel}</dt>
        <dd>{addressValue}</dd>
      </div>
      <div class="info-item">
        <dt>{phoneLabel}</dt>
        <dd>{CONTACT.phoneDisplay}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-sand-50);
    padding-bottom: 4rem;
  }

  /* === 上方大照片（橫式 21:9） === */
  .hero-photo {
    width: 100%;
    margin: 0;
  }
  .hero-photo :global(.placeholder) {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
  }

  /* === 下方文字區置中對齊 === */
  .hero-text {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
    max-width: 56rem;
  }

  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-ink-900);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    /* 單一段落，自然換行，無裝飾 */
  }

  .hero-tagline {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--color-ink-700);
    letter-spacing: 0.01em;
  }

  .hero-subtitle {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-ink-700);
    max-width: 42rem;
  }

  /* === 三聯主按鈕 === */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1.5px solid transparent;
    border-radius: 2px;
    transition: all 0.2s ease;
    min-width: 11rem;
  }
  .cta-primary {
    background-color: var(--color-ink-900);
    color: var(--color-sand-50);
    border-color: var(--color-ink-900);
  }
  .cta-primary:hover {
    background-color: var(--color-ink-700);
    border-color: var(--color-ink-700);
  }
  .cta-line {
    background-color: #00b900;
    color: #ffffff;
    border-color: #00b900;
  }
  .cta-line:hover {
    background-color: #009900;
    border-color: #009900;
  }
  .cta-phone {
    background-color: transparent;
    color: var(--color-ink-900);
    border-color: var(--color-ink-900);
  }
  .cta-phone:hover {
    background-color: var(--color-ink-900);
    color: var(--color-sand-50);
  }

  /* === 底部資訊條 === */
  .hero-info {
    margin: 2rem 0 0;
    padding: 1.5rem 2rem;
    background-color: var(--color-sand-100, #efe9e0);
    border-top: 1px solid var(--color-ink-200);
    border-bottom: 1px solid var(--color-ink-200);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-info {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      text-align: left;
    }
  }
  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .info-item dt {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .info-item dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-ink-900);
    font-weight: 500;
  }

  /* === 響應式調整 === */
  @media (max-width: 767px) {
    .hero-text {
      padding-top: 2.5rem;
      gap: 1.1rem;
    }
    .cta {
      min-width: 100%;
      padding: 0.95rem 1.5rem;
    }
    .hero-ctas {
      gap: 0.625rem;
      width: 100%;
    }
  }
</style>
