---
/**
 * HeroSection 元件 v3 — Editorial Hero
 *
 * 設計語言："沉穩 charcoal + 細線海岸線 + 古典襯線標題"
 *   - 全螢幕 100dvh
 *   - 深 ink 漸層背景，無強烈飽和色
 *   - SVG 雙層海岸線細描繪 + 細微星空紋理（0.5px 線條）
 *   - 中文標題用思源宋體大字距開場、副標 italic Cormorant
 *   - CTA 改為極簡線框按鈕（無填色、hover 反白）
 *   - 底部極小 scroll cue 與品牌縮寫，呼應精品民宿首頁
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="hero" aria-labelledby="hero-title">
  {/* 細線海岸線 SVG：兩層柔波 + 微弱地平線，呼應東海岸 */}
  <div class="hero-bg" aria-hidden="true">
    <svg class="coast" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" focusable="false">
      <defs>
        <linearGradient id="hero-vignette" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="rgba(14,13,11,0)" />
          <stop offset="60%" stop-color="rgba(14,13,11,0.15)" />
          <stop offset="100%" stop-color="rgba(14,13,11,0.55)" />
        </linearGradient>
      </defs>
      {/* 微弱地平線 */}
      <line x1="0" y1="540" x2="1600" y2="540" stroke="rgba(200,184,150,0.35)" stroke-width="0.6" />
      {/* 第一層：細線海岸線（前景） */}
      <path
        d="M0,640 C260,612 480,690 720,650 C960,610 1180,706 1440,664 L1600,672 L1600,900 L0,900 Z"
        fill="rgba(14,13,11,0.65)"
        stroke="rgba(200,184,150,0.55)"
        stroke-width="0.7"
      />
      {/* 第二層：更前的海岸線（深 ink） */}
      <path
        d="M0,760 C260,738 520,800 820,770 C1060,748 1260,802 1600,786 L1600,900 L0,900 Z"
        fill="rgba(8,7,6,0.92)"
        stroke="rgba(200,184,150,0.4)"
        stroke-width="0.5"
      />
      {/* 上方 vignette 漸層 */}
      <rect x="0" y="0" width="1600" height="900" fill="url(#hero-vignette)" />
    </svg>
  </div>

  <div class="container-wide hero-inner">
    {/* 銅金細線 + 短英文 eyebrow */}
    <div class="eyebrow-row">
      <span class="rule-h" aria-hidden="true"></span>
      <span class="eyebrow">{t('home.heroEyebrow')}</span>
      <span class="rule-h" aria-hidden="true"></span>
    </div>

    <h1 id="hero-title" class="hero-title">{t('home.heroTitle')}</h1>

    <p class="hero-sub">{t('home.heroSubtitle')}</p>

    <div class="cta-row">
      <a class="btn-line on-dark is-copper" href={getLocalizedPath('/rooms', locale)}>
        {t('home.heroPrimaryCta')}
      </a>
      <a class="btn-line on-dark" href={getLocalizedPath('/about', locale)}>
        {t('home.heroSecondaryCta')}
      </a>
    </div>
  </div>

  {/* 底部極小 scroll cue + 品牌字標 */}
  <div class="hero-foot" aria-hidden="true">
    <span class="brand-mini">RUNNERS HOUSE · EST 2025</span>
    <span class="scroll-cue"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* 沉穩深 ink 底色作為照片缺位時的視覺重量 */
    background-color: var(--color-ink-950);
    color: var(--color-bone-100);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-bg .coast {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: 8rem;
    max-width: 56rem;
  }
  .eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .rule-h {
    display: inline-block;
    width: 36px;
    height: 1px;
    background-color: var(--color-copper-500);
  }
  .hero-inner .eyebrow {
    color: var(--color-copper-300);
    letter-spacing: 0.36em;
    font-size: 0.7rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.85rem, 8.5vw, 6.5rem);
    color: var(--color-bone-100);
    margin: 0 0 2rem;
    line-height: 1.05;
    /* 精品感：寬字距開場後微收斂；中文襯線 letter-spacing 0.06em 留呼吸 */
    letter-spacing: 0.04em;
    font-weight: 400;
    animation: hero-title-fade 1500ms var(--ease-editorial) both;
  }
  :lang(en) .hero-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.005em;
  }
  @keyframes hero-title-fade {
    0% {
      opacity: 0;
      transform: translateY(14px);
      letter-spacing: 0.12em;
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      letter-spacing: 0.04em;
    }
  }
  .hero-sub {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.95;
    color: rgb(245 239 230 / 0.78);
    margin: 0 auto 3rem;
    max-width: 38rem;
    font-style: italic;
    font-weight: 300;
    letter-spacing: 0.02em;
    animation: hero-sub-fade 1700ms 200ms var(--ease-editorial) both;
  }
  @keyframes hero-sub-fade {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .cta-row {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
    animation: hero-sub-fade 1900ms 400ms var(--ease-editorial) both;
  }

  .hero-foot {
    position: absolute;
    bottom: 2.5rem;
    left: 0;
    right: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    pointer-events: none;
  }
  .brand-mini {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    color: var(--color-copper-400);
    text-transform: uppercase;
  }
  .scroll-cue {
    width: 1px;
    height: 38px;
    background: linear-gradient(180deg, var(--color-copper-400), transparent);
    animation: scroll-cue 2400ms var(--ease-editorial) infinite;
    transform-origin: top;
  }
  @keyframes scroll-cue {
    0%, 100% { transform: scaleY(1); opacity: 0.6; }
    50% { transform: scaleY(0.45); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-sub, .cta-row, .scroll-cue {
      animation: none;
    }
  }
</style>
