---
/**
 * HeroSection v4 — D1 第 1 屏「電影開場」
 *
 * 設計依據：研究報告 top-tier-bnb-design-2026.md D1.Screen 1
 *   - 全螢幕 100dvh + 沙白底（不是黑底，避開 cookie-cutter dark hero）
 *   - 中文巨字標題（H1）配 Bodoni Moda italic 大寫副標
 *   - 右下角 SVG 線稿 + 跑者剪影 + 動態浪線（無真實照片，依 D2 策略 1+4）
 *   - 左側：定錨經緯度（GEO） + 季節英文短籤（kinetic typography）
 *   - 底部 scroll cue：「scroll · 滾動」字 + 細線
 *   - hero 標題用「兩行錯落」editorial 排版（依 The Drake / Aman 範式）
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// 海岸線經緯度（呼應研究報告 B7 Hotarutei「地獄谷野猿公苑 遊歩道8分」格式）
const COORD = '23.32°N · 121.46°E';
const KM_LABEL = locale === 'en' ? 'KM 91 · TAITUNG COAST RD' : '台 11 線 · 91K · 台東長濱';

// 季節 kinetic typography 標籤（純視覺裝飾、非翻譯字串）
const seasons = locale === 'en'
  ? ['Spring · Salt', 'Summer · Tide', 'Autumn · Wind', 'Winter · Moon']
  : ['春 · 鹽', '夏 · 潮', '秋 · 風', '冬 · 月'];

/*
 * Hero 標題兩行錯落顯示策略：
 *   - i18n 字串為「跑步就是回家的路」一句，業主已修正不可動其內容
 *   - 視覺上需要兩行錯落 editorial 排版（依研究報告 D1 Screen 1）
 *   - 解法：英文以空白切半，中文以「就是」為支點切半（語意可斷）
 *   - 完全在 component 內 derive，不新增 i18n key
 */
const fullTitle: string = t('home.heroTitle');
let lineA: string;
let lineB: string;
if (locale === 'en') {
  // 英文：取一半空白前後切（粗略平分）
  const words = fullTitle.split(' ');
  const mid = Math.ceil(words.length / 2);
  lineA = words.slice(0, mid).join(' ');
  lineB = words.slice(mid).join(' ');
} else {
  // 中文：尋找「就是」「在」「有」等斷句點，否則對半切
  const breakWords = ['就是', '在', '有', '便'];
  let breakIdx = -1;
  for (const w of breakWords) {
    const i = fullTitle.indexOf(w);
    if (i > 0) { breakIdx = i; break; }
  }
  if (breakIdx > 0) {
    lineA = fullTitle.slice(0, breakIdx);
    lineB = fullTitle.slice(breakIdx);
  } else {
    const half = Math.ceil(fullTitle.length / 2);
    lineA = fullTitle.slice(0, half);
    lineB = fullTitle.slice(half);
  }
}

// 英文 italic tagline — 完全用既有 brandStatement 字串
const tagline: string = t('common.brandStatement');
---

<section class="hero" aria-labelledby="hero-title">
  {/* === 上方頂條：經緯度 / 季節 / 編號 === */}
  <div class="hero-topbar" aria-hidden="true">
    <span class="topbar-coord">{COORD}</span>
    <span class="topbar-divider"></span>
    <span class="topbar-km">{KM_LABEL}</span>
    <span class="topbar-spacer"></span>
    <span class="topbar-edition">CHAPTER I · {locale === 'en' ? 'A HOUSE BY THE SEA' : '海邊的房子'}</span>
  </div>

  {/* === 主視覺中央：左字右畫 === */}
  <div class="hero-stage">
    <div class="hero-typography">
      {/* 中文巨字標題 — 兩行錯落，第二行右縮排 */}
      <h1 id="hero-title" class="hero-title">
        <span class="line line-a">{lineA}</span>
        <span class="line line-b">{lineB}</span>
      </h1>

      {/* 副標：使用既有 brandStatement 字串，不新增 i18n key */}
      <p class="hero-eng">
        <em>{tagline}</em>
      </p>
    </div>

    {/* === 右下角 SVG 線稿：跑者沿海岸線剪影（依 D2 策略 4：手繪線稿）=== */}
    <figure class="hero-illust" aria-hidden="true">
      <svg viewBox="0 0 480 380" preserveAspectRatio="xMidYMax meet" focusable="false">
        <defs>
          <linearGradient id="sky-fade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="rgba(247, 244, 237, 0)" />
            <stop offset="100%" stop-color="rgba(247, 244, 237, 0.85)" />
          </linearGradient>
          <linearGradient id="sun-circle" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="rgba(201, 125, 93, 0.55)" />
            <stop offset="100%" stop-color="rgba(201, 125, 93, 0.0)" />
          </linearGradient>
        </defs>

        {/* 晨曦圓（左上） */}
        <circle cx="120" cy="80" r="56" fill="url(#sun-circle)" />
        <circle cx="120" cy="80" r="56" fill="none" stroke="rgba(201, 125, 93, 0.6)" stroke-width="0.6" />

        {/* 海平線（細線 — 1 條，呼應 Hoshinoya 大量留白） */}
        <line x1="0" y1="200" x2="480" y2="200" stroke="rgba(44, 74, 82, 0.45)" stroke-width="0.6" />
        <line x1="0" y1="206" x2="480" y2="206" stroke="rgba(44, 74, 82, 0.18)" stroke-width="0.4" />

        {/* 海浪柔線（kinetic 動畫） */}
        <path class="wave wave-a"
              d="M0,240 C80,228 160,250 240,238 C320,226 400,250 480,240"
              fill="none" stroke="rgba(44, 74, 82, 0.35)" stroke-width="0.6" />
        <path class="wave wave-b"
              d="M0,260 C100,250 180,272 260,260 C340,248 420,272 480,262"
              fill="none" stroke="rgba(44, 74, 82, 0.22)" stroke-width="0.5" />

        {/* 跑者剪影 — 簡化線稿 stick figure（依 D2 策略 3 AI 線稿風格） */}
        <g transform="translate(330, 190)" class="runner">
          {/* 頭 */}
          <circle cx="0" cy="0" r="6" fill="none" stroke="#1a1a1a" stroke-width="1.2" />
          {/* 身體 */}
          <line x1="0" y1="6" x2="-2" y2="28" stroke="#1a1a1a" stroke-width="1.2" stroke-linecap="round" />
          {/* 前腿 */}
          <line x1="-2" y1="28" x2="10" y2="44" stroke="#1a1a1a" stroke-width="1.2" stroke-linecap="round" />
          {/* 後腿 */}
          <line x1="-2" y1="28" x2="-12" y2="42" stroke="#1a1a1a" stroke-width="1.2" stroke-linecap="round" />
          {/* 前手 */}
          <line x1="0" y1="12" x2="10" y2="20" stroke="#1a1a1a" stroke-width="1.2" stroke-linecap="round" />
          {/* 後手 */}
          <line x1="0" y1="12" x2="-10" y2="22" stroke="#1a1a1a" stroke-width="1.2" stroke-linecap="round" />
        </g>

        {/* 海岸線（前景） */}
        <path d="M0,310 C100,300 200,320 300,310 C380,302 440,320 480,312 L480,380 L0,380 Z"
              fill="rgba(44, 74, 82, 0.12)" />

        {/* 上方淡出遮罩，讓畫面與背景無縫 */}
        <rect x="0" y="0" width="480" height="380" fill="url(#sky-fade)" />
      </svg>
    </figure>
  </div>

  {/* === 左下：季節 kinetic typography（自動輪播） === */}
  <div class="hero-season" aria-hidden="true">
    <span class="season-label">CURRENT MOMENT</span>
    <ul class="season-list">
      {seasons.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  {/* === 中下：CTA 兩鈕 === */}
  <div class="hero-ctas">
    <a class="btn-line is-sea" href={getLocalizedPath('/rooms', locale)}>
      {t('home.heroPrimaryCta')}
    </a>
    <a class="text-link" href={getLocalizedPath('/about', locale)}>
      {t('home.heroSecondaryCta')}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  {/* === 底部 scroll cue === */}
  <div class="scroll-cue" aria-hidden="true">
    <span class="cue-text">SCROLL</span>
    <span class="cue-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background-color: var(--color-sand-50);
    color: var(--color-ink-900);
    overflow: hidden;
    isolation: isolate;
    padding: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero { padding: 2rem 2.5rem; }
  }
  @media (min-width: 1280px) {
    .hero { padding: 2rem 4rem; }
  }

  /* === 頂條：經緯度 + 季節 + 章節 === */
  .hero-topbar {
    display: none;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    color: var(--color-ink-500);
    text-transform: uppercase;
    padding-block: 1rem 0;
    animation: fade-in 1100ms 200ms var(--ease-editorial) both;
  }
  @media (min-width: 1024px) {
    .hero-topbar { display: flex; }
  }
  .topbar-coord, .topbar-km, .topbar-edition {
    white-space: nowrap;
  }
  .topbar-divider {
    width: 1px;
    height: 12px;
    background-color: var(--color-sun-400);
    opacity: 0.6;
  }
  .topbar-spacer { flex: 1; }
  .topbar-edition {
    color: var(--color-sun-500);
  }

  /* === 主視覺：左字右畫 === */
  .hero-stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    padding-block: 4rem 2rem;
  }
  @media (min-width: 1024px) {
    .hero-stage {
      grid-template-columns: 1.3fr 1fr;
      gap: 3rem;
      padding-block: 6rem 4rem;
      align-items: center;
    }
  }

  /* === 中文巨字標題（兩行錯落 editorial）=== */
  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-ink-900);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .hero-title .line {
    display: block;
    font-size: clamp(3rem, 10vw, 8rem);
    /* 為 kinetic 進場：每行從 translateY 24 + opacity 0 動畫進場 */
    opacity: 0;
    transform: translateY(28px);
    animation: line-fade-up 1300ms var(--ease-out-expo) forwards;
  }
  .hero-title .line-a {
    animation-delay: 350ms;
  }
  .hero-title .line-b {
    animation-delay: 600ms;
    /* 第二行右縮排，editorial 雜誌排版 */
    padding-left: 1.4em;
    color: var(--color-sea-500);
  }
  @media (min-width: 768px) {
    .hero-title .line-b { padding-left: 2em; }
  }
  :lang(en) .hero-title {
    font-family: var(--font-display-hero);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  @keyframes line-fade-up {
    0% { opacity: 0; transform: translateY(28px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* === 英文 Italic 副標 === */
  .hero-eng {
    margin: 2rem 0 0;
    font-family: var(--font-display-en);
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    font-style: italic;
    font-weight: 300;
    color: var(--color-ink-500);
    letter-spacing: -0.005em;
    max-width: 40rem;
    line-height: 1.6;
    opacity: 0;
    animation: line-fade-up 1300ms 850ms var(--ease-out-expo) forwards;
  }
  .hero-eng em { font-style: italic; }

  /* === 右側 SVG 線稿插畫 === */
  .hero-illust {
    margin: 2rem 0 0;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 380;
    justify-self: end;
    opacity: 0;
    animation: line-fade-up 1500ms 1000ms var(--ease-out-expo) forwards;
  }
  .hero-illust svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* SVG 浪線動畫：橫向位移製造潮水感 */
  @keyframes wave-shift-a {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-12px); }
  }
  @keyframes wave-shift-b {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(8px); }
  }
  @keyframes runner-bob {
    0%, 100% { transform: translate(330px, 190px); }
    50% { transform: translate(330px, 188px); }
  }
  .hero-illust .wave-a {
    animation: wave-shift-a 6s var(--ease-natural) infinite;
    transform-origin: center;
  }
  .hero-illust .wave-b {
    animation: wave-shift-b 8s var(--ease-natural) infinite;
    transform-origin: center;
  }
  .hero-illust .runner {
    animation: runner-bob 1.4s ease-in-out infinite;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-illust .wave-a,
    .hero-illust .wave-b,
    .hero-illust .runner {
      animation: none;
    }
    .hero-title .line, .hero-eng, .hero-illust, .hero-topbar {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* === 季節 kinetic typography（左下角，自動輪播）=== */
  .hero-season {
    display: none;
    position: absolute;
    bottom: 8rem;
    left: 1.5rem;
    flex-direction: column;
    gap: 0.4rem;
    z-index: 1;
  }
  @media (min-width: 1024px) {
    .hero-season {
      display: flex;
      left: 2.5rem;
      bottom: 9rem;
    }
  }
  @media (min-width: 1280px) {
    .hero-season { left: 4rem; }
  }
  .season-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.36em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .season-list {
    list-style: none;
    margin: 0;
    padding: 0;
    height: 1.6em;
    overflow: hidden;
    position: relative;
  }
  .season-list li {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-ink-900);
    line-height: 1.6;
    letter-spacing: 0.02em;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    animation: season-loop 12s linear infinite;
  }
  :lang(en) .season-list li {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  /* 4 個 season 各延遲 3s，循環顯示 */
  .season-list li:nth-child(1) { animation-delay: 0s; }
  .season-list li:nth-child(2) { animation-delay: 3s; }
  .season-list li:nth-child(3) { animation-delay: 6s; }
  .season-list li:nth-child(4) { animation-delay: 9s; }
  @keyframes season-loop {
    0% { top: 100%; opacity: 0; }
    8% { top: 0; opacity: 1; }
    25% { top: 0; opacity: 1; }
    33% { top: -100%; opacity: 0; }
    100% { top: -100%; opacity: 0; }
  }

  /* === CTA 兩鈕 === */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    align-items: center;
    padding-block: 1rem 2rem;
    opacity: 0;
    animation: line-fade-up 1300ms 1200ms var(--ease-out-expo) forwards;
  }
  @media (min-width: 1024px) {
    .hero-ctas {
      padding-block: 0 2rem;
      max-width: 800px;
    }
  }

  /* === 底部 scroll cue === */
  .scroll-cue {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .scroll-cue {
      display: flex;
      bottom: 2rem;
      right: 2.5rem;
    }
  }
  @media (min-width: 1280px) {
    .scroll-cue { right: 4rem; }
  }
  .cue-text {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    transform: rotate(180deg);
    writing-mode: vertical-rl;
  }
  .cue-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, var(--color-sun-400), transparent);
    animation: cue-pulse 2400ms var(--ease-editorial) infinite;
    transform-origin: top;
  }
  @keyframes cue-pulse {
    0%, 100% { transform: scaleY(1); opacity: 0.5; }
    50% { transform: scaleY(0.4); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-line, .season-list li, .hero-ctas { animation: none; opacity: 1; }
  }
</style>
