---
/**
 * StoryTeaser 元件 v3 — Editorial Story
 *
 * 首頁的品牌故事預告區，引導至 /about 完整故事。
 * 視覺改為精品民宿風：
 *   - 深 charcoal 全寬區塊 + 銅金細線
 *   - 大號浮水印年份「1972」作為背景骨幹
 *   - magazine 雜誌式 split：左大圖 + 右文字塊
 *   - pull-quote 樣式 + italic Cormorant 副題
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="story" aria-labelledby="story-teaser-heading">
  <span class="watermark" aria-hidden="true">1972</span>

  <div class="container-wide grid">
    <div class="visual">
      <ImagePlaceholder
        locale={locale}
        alt={t('home.storyTeaserHeading')}
        ratio="3:4"
        variant="ink"
      />
    </div>
    <div class="content">
      <span class="eyebrow">{t('home.storyTeaserSince')}</span>
      <span class="rule-gold" aria-hidden="true"></span>
      <h2 id="story-teaser-heading" class="title">
        {t('home.storyTeaserHeading')}
      </h2>
      <blockquote class="pull-quote">
        <span class="quote-mark" aria-hidden="true">“</span>
        <p>{t('home.storyTeaserBody')}</p>
      </blockquote>
      <a class="btn-line on-dark" href={getLocalizedPath('/about', locale)}>
        {t('home.storyTeaserCta')}
      </a>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    padding-block: 8rem;
    background-color: var(--color-ink-950);
    color: var(--color-bone-100);
    overflow: hidden;
    isolation: isolate;
  }
  .watermark {
    position: absolute;
    right: -2rem;
    bottom: -4rem;
    font-family: var(--font-display);
    font-size: clamp(12rem, 28vw, 24rem);
    font-weight: 300;
    line-height: 0.85;
    color: var(--color-copper-500);
    opacity: 0.06;
    user-select: none;
    pointer-events: none;
    letter-spacing: -0.03em;
    z-index: 0;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 0.85fr 1fr;
      gap: 5.5rem;
    }
  }
  .visual {
    overflow: hidden;
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.36em;
    color: var(--color-copper-300);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.85rem);
    color: var(--color-bone-100);
    line-height: 1.2;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .pull-quote {
    margin: 0;
    padding-left: 1.75rem;
    border-left: 1px solid var(--color-copper-500);
    position: relative;
  }
  .pull-quote .quote-mark {
    position: absolute;
    left: 0.4rem;
    top: -0.6rem;
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--color-copper-400);
    line-height: 1;
  }
  .pull-quote p {
    margin: 0;
    color: rgb(245 239 230 / 0.82);
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 2;
    font-style: italic;
    font-weight: 300;
    max-width: 38rem;
  }
</style>
