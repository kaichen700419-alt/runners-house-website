---
/**
 * StoryTeaser — 米倉故事預告（自己設計版）
 *
 * 結構：左圖右文 50/50（桌面）/ 圖在上文在下（行動）
 * 深木色 placeholder + 米色文字區
 * 完全無：時間軸、1972 浮水印、引言裝飾、章節 IV
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const eyebrow = locale === 'en' ? 'Our Story' : '品牌故事';
const ctaLabel = locale === 'en' ? 'Read the full story' : '閱讀完整故事';
---

<section class="story" aria-labelledby="story-heading">
  <div class="story-inner">
    <div class="image-wrap" aria-hidden="true">
      <div class="image-placeholder">
        <span class="image-label">{locale === 'en' ? 'PHOTO' : '米倉外觀照片'}</span>
      </div>
    </div>

    <div class="content">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="story-heading" class="heading">{t('home.storyTeaserHeading')}</h2>
      <p class="body">{t('home.storyTeaserBody')}</p>
      <a class="cta" href={getLocalizedPath('/about', locale)}>
        {ctaLabel}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .story {
    background-color: #f5efe5;
    padding: 6rem 1.5rem;
  }
  @media (min-width: 768px) {
    .story { padding: 8rem 2.5rem; }
  }
  .story-inner {
    max-width: 78rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .story-inner {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .image-wrap {
    width: 100%;
  }
  .image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background:
      linear-gradient(135deg, rgba(184, 142, 92, 0.25) 0%, rgba(60, 50, 40, 0.55) 100%),
      linear-gradient(160deg, #2d2520 0%, #1a1411 50%, #251c16 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-label {
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 32rem;
  }
  .eyebrow {
    margin: 0;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #8b6f47;
    font-weight: 500;
  }
  .heading {
    margin: 0;
    font-family: 'Noto Serif TC', Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    color: #1a1411;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }
  .body {
    margin: 0;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 1rem;
    line-height: 1.95;
    color: #4a3f33;
    font-weight: 300;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 0.75rem;
    color: #8b6f47;
    text-decoration: none;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    border-bottom: 1px solid #8b6f47;
    padding-bottom: 6px;
    align-self: flex-start;
    transition: gap 0.3s ease;
  }
  .cta:hover { gap: 1.25rem; }
  .arrow { transition: transform 0.3s ease; }
</style>
