---
/**
 * StoryTeaser 元件
 *
 * 首頁的品牌故事預告區，引導至 /about 完整故事。
 * 視覺強化（v2）：
 *   - 50/50 split + 深色 timber-700~900 背景，與 Hero 區（淺色）形成節奏對比
 *   - 大型「1972」浮水印年份字（半透明 sand 色）作為背景視覺錨點
 *   - 引號裝飾 SVG 提升質感
 *   - CTA hover 上抬 + 陰影加深
 */
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="story" aria-labelledby="story-teaser-heading">
  {/* 1972 浮水印：絕對定位、半透明、不可選取，僅作視覺錨點不影響可讀性 */}
  <span class="watermark" aria-hidden="true">1972</span>

  <div class="container-wide grid">
    <div class="visual">
      <ImagePlaceholder
        locale={locale}
        alt={t('home.storyTeaserHeading')}
        ratio="4:3"
        variant="timber"
      />
      <span class="caption" aria-hidden="true">{t('home.storyTeaserCaption')}</span>
    </div>
    <div class="content">
      <span class="eyebrow">
        <span class="eyebrow-bar"></span>
        {t('home.storyTeaserSince')}
      </span>
      <h2 id="story-teaser-heading" class="title">
        {/* 引號裝飾 SVG：純視覺，aria-hidden 避免螢幕閱讀器讀出引號 */}
        <svg class="quote" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M7.5 5C4.5 5 2 7.5 2 10.5V19h7.5V11.5H5.5C5.7 9 7.4 7.5 9.5 7.5V5h-2zM18.5 5C15.5 5 13 7.5 13 10.5V19h7.5V11.5H16.5C16.7 9 18.4 7.5 20.5 7.5V5h-2z"
            fill="currentColor"
            opacity="0.7"
          />
        </svg>
        {t('home.storyTeaserHeading')}
      </h2>
      <p class="body">{t('home.storyTeaserBody')}</p>
      <a class="cta" href={getLocalizedPath('/about', locale)}>
        {t('home.storyTeaserCta')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    padding-block: 6rem;
    /* 深色 timber 漸層取代原本平淡的 timber-100，與 Hero 與 RoomPreview 的淺色塊形成對比 */
    background:
      linear-gradient(135deg, var(--color-timber-900) 0%, var(--color-timber-700) 100%);
    color: var(--color-timber-50);
    overflow: hidden;
    isolation: isolate;
  }
  /* 浮水印年份：超大 display 字體 + sand 色 + 極低不透明度，僅當作視覺錨點 */
  .watermark {
    position: absolute;
    right: -3rem;
    bottom: -3.5rem;
    font-family: var(--font-display);
    font-size: clamp(10rem, 24vw, 20rem);
    font-weight: 700;
    line-height: 0.85;
    color: var(--color-sand-300);
    opacity: 0.08;
    user-select: none;
    pointer-events: none;
    letter-spacing: -0.04em;
    z-index: 0;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  /* 50/50 split：兩側等比，視覺權重均衡，不再是「圖小文大」的失衡感 */
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
  .visual {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
  }
  /* 圖片下方的 caption 標籤，浮在圖右下，補強年份感 */
  .caption {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    padding: 0.4rem 0.8rem;
    background-color: rgb(0 0 0 / 0.55);
    color: var(--color-sand-200);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-sand-300);
  }
  .eyebrow-bar {
    display: inline-block;
    width: 2.5rem;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-sand-400), var(--color-sand-300));
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    color: var(--color-timber-50);
    line-height: 1.2;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .quote {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    color: var(--color-sand-300);
    margin-top: 0.4rem;
  }
  .body {
    margin: 0;
    color: var(--color-timber-100);
    font-size: 1.05rem;
    line-height: 1.85;
    max-width: 36rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background-color: var(--color-sand-300);
    color: var(--color-timber-950);
    width: fit-content;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 220ms var(--ease-snappy),
      box-shadow 220ms var(--ease-snappy),
      background-color 220ms var(--ease-snappy);
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.45);
  }
  .cta:hover {
    transform: translateY(-2px);
    background-color: var(--color-sand-200);
    box-shadow: 0 12px 26px -10px rgb(0 0 0 / 0.55);
  }
  .cta:focus-visible {
    outline: 2px solid var(--color-sand-200);
    outline-offset: 3px;
  }
</style>
