---
/**
 * NumeralStat — D1 Screen 9 變奏「大數字證明規模感」
 *
 * 設計依據：研究報告 B9 La Fantaisie「63 間房 + 10 間套房」用大數字當設計元素
 *   - 把跑者之家的「3 條跑步路線 + 5 間客房 + 1 間餐廳」改寫為大數字
 *   - 配色：沙白底 + 海洋灰藍編號 + 晨曦橘細裝飾
 *   - 數字用 Bodoni Moda 巨字體，搭配中文襯線小字標註
 *   - 全寬 grid 4 欄；每欄一個大數字，旁邊小字解釋
 */
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stats = locale === 'en'
  ? [
      { num: '5', label: 'Rooms', sub: 'reborn from a 1972 rice barn' },
      { num: '3', label: 'Routes', sub: '5K · 10K · 15K coastal trails' },
      { num: '4', label: 'Wall Connectors', sub: 'Tesla & Type 2 / J1772' },
      { num: '1', label: 'Coastline', sub: '23.32°N · 121.46°E' },
    ]
  : [
      { num: '5', label: '間客房', sub: '由 1972 米倉重生' },
      { num: '3', label: '條跑步路線', sub: '5K · 10K · 15K 海岸線' },
      { num: '4', label: '支充電龍', sub: 'Tesla 與 Type 2 / J1772' },
      { num: '1', label: '片海', sub: '23.32°N · 121.46°E' },
    ];
---

<section class="numeral" aria-labelledby="numeral-heading">
  <div class="container-wide reveal">
    <div class="chapter-mark">
      <span class="num">IX</span>
      <span class="label">CHAPTER · {locale === 'en' ? 'BY THE NUMBERS' : '用數字說'}</span>
    </div>
    <h2 id="numeral-heading" class="title">
      {locale === 'en'
        ? 'A small house, an honest count.'
        : '一棟小房子，一份誠實的清單。'}
    </h2>
  </div>

  <div class="container-wide">
    <ul class="grid">
      {
        stats.map((s, i) => (
          <li class="cell reveal" data-delay={i + 1}>
            <span class="cell-num" aria-hidden="true">{s.num}</span>
            <div class="cell-text">
              <span class="cell-label">{s.label}</span>
              <span class="cell-sub">{s.sub}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .numeral {
    padding-block: 8rem;
    background-color: var(--color-sand-50);
    border-top: 1px solid var(--color-divider);
  }
  @media (min-width: 1024px) {
    .numeral { padding-block: 11rem; }
  }
  .chapter-mark { margin-bottom: 2rem; }
  .title {
    margin: 0 0 5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.3;
    font-weight: 500;
    max-width: 32rem;
    font-style: italic;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-divider);
  }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 3.5rem 1.75rem 3rem;
    border-bottom: 1px solid var(--color-divider);
    border-right: 1px solid var(--color-divider);
    transition: background-color 460ms var(--ease-editorial);
  }
  .cell:last-child { border-right: 1px solid var(--color-divider); }
  @media (min-width: 640px) {
    .cell:nth-child(2n) { border-right: 1px solid var(--color-divider); }
  }
  .cell:hover {
    background-color: var(--color-sand-100);
  }
  .cell-num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(5rem, 11vw, 9rem);
    color: var(--color-sea-500);
    letter-spacing: -0.06em;
    line-height: 0.85;
    transition: color 460ms var(--ease-editorial);
  }
  .cell:hover .cell-num { color: var(--color-sun-400); }
  .cell-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-divider);
  }
  .cell-label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 500;
  }
  :lang(en) .cell-label {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
  }
  .cell-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-500);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.6;
  }
</style>
