---
/**
 * RoomDetail
 *
 * 單一房型詳情頁主體：相簿（CSS scroll snap）+ 規格 + 設施 + 規則 + 訂房 CTA。
 */
import { useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  room: CollectionEntry<'rooms'>;
}

const { locale, room } = Astro.props;
const t = useTranslations(locale);
const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
const beds = locale === 'en' ? room.data.beds_en : room.data.beds_zh;
const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
const desc = locale === 'en' ? room.data.description_en : room.data.description_zh;
const amenities = locale === 'en' ? room.data.amenities_en : room.data.amenities_zh;
const priceNote = locale === 'en' ? room.data.price_note_en : room.data.price_note_zh;
const galleryVariants = ['ocean', 'timber', 'sand', 'ink'] as const;
const lineUrl = t('common.realLineUrl');
const phone = t('common.realPhonePrimary');
---

<article class="room-detail">
  <header class="header container-wide">
    <h1 class="title">{name}</h1>
    <p class="lead">{desc}</p>
    <dl class="overview">
      <div>
        <dt>{t('rooms.sizeLabel')}</dt>
        <dd>{room.data.size}{t('rooms.sizeUnit')}</dd>
      </div>
      <div>
        <dt>{t('rooms.capacityLabel')}</dt>
        <dd>{room.data.capacity}{t('rooms.capacityUnit')}</dd>
      </div>
      <div>
        <dt>{t('rooms.bedLabel')}</dt>
        <dd>{beds}</dd>
      </div>
      <div>
        <dt>{t('rooms.viewLabel')}</dt>
        <dd>{view}</dd>
      </div>
    </dl>
  </header>

  <section class="gallery">
    <div class="container-wide">
      <SectionHeading title={t('rooms.detailGalleryHeading')} variant="wabi" />
      <p class="hint" aria-hidden="true">{t('ui.galleryHint')}</p>
      <ul
        class="snap"
        aria-label={t('ui.galleryAria')}
        role="region"
        tabindex="0"
      >
        {
          room.data.gallery.map((alt, i) => (
            <li>
              <ImagePlaceholder
                locale={locale}
                alt={alt}
                ratio="4:3"
                variant={galleryVariants[i % galleryVariants.length] ?? 'ocean'}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="amenities">
    <div class="container-wide grid">
      <div>
        <SectionHeading title={t('rooms.detailAmenityHeading')} variant="wabi" />
        <ul class="check-list">
          {amenities.map((a) => <li><span class="check" aria-hidden="true">✓</span><span>{a}</span></li>)}
        </ul>
      </div>
      <div>
        <SectionHeading title={t('rooms.detailRulesHeading')} variant="wabi" />
        <ul class="rule-list">
          <li>{t('rooms.detailRule1')}</li>
          <li>{t('rooms.detailRule2')}</li>
          <li>{t('rooms.detailRule3')}</li>
          <li>{t('rooms.detailRule4')}</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container-wide cta-inner">
      <SectionHeading
        title={t('rooms.detailContactHeading')}
        subtitle={t('rooms.detailContactBody')}
        align="center"
        variant="wabi"
      />
      <p class="price-note">{priceNote}</p>
      <div class="cta-row">
        <a class="cta cta-line" href={lineUrl} target="_blank" rel="noopener noreferrer">
          <span class="icon">L</span>
          <span>{t('common.addLine')}</span>
        </a>
        <a class="cta cta-phone" href={`tel:${phone.replace(/\s+/g, '')}`}>
          <span class="icon">☎</span>
          <span>{phone}</span>
        </a>
      </div>
    </div>
  </section>
</article>

<style>
  .room-detail {
    background-color: var(--color-timber-50);
    padding-bottom: 5rem;
  }
  .header {
    padding-block: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: var(--color-ink-950);
    line-height: 1.15;
  }
  .lead {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 1.05rem;
    line-height: 1.85;
    max-width: 48rem;
  }
  .overview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem 1.5rem;
    margin: 0.5rem 0 0;
    padding: 1.25rem;
    border-radius: 1rem;
    background-color: white;
    border: 1px solid var(--color-timber-200);
  }
  @media (min-width: 768px) {
    .overview {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .overview div { display: flex; flex-direction: column; gap: 0.25rem; }
  .overview dt {
    color: var(--color-ink-500);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .overview dd {
    margin: 0;
    color: var(--color-ink-900);
    font-weight: 500;
  }

  .gallery {
    padding-block: 3rem;
  }
  .hint {
    margin: -0.5rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-400);
    letter-spacing: 0.04em;
  }
  .snap {
    list-style: none;
    margin: 0;
    padding: 0 0 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(80%, 1fr);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  @media (min-width: 768px) {
    .snap {
      grid-auto-columns: minmax(45%, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .snap {
      grid-auto-columns: minmax(32%, 1fr);
    }
  }
  .snap li {
    scroll-snap-align: start;
    border-radius: 1rem;
    overflow: hidden;
  }

  .amenities {
    padding-block: 3rem;
    background-color: white;
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 3.5rem;
    }
  }
  .check-list, .rule-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--color-ink-800);
    line-height: 1.7;
  }
  .check-list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.5rem;
    align-items: start;
  }
  .check {
    color: var(--color-ocean-600);
    font-weight: 700;
    line-height: 1.4;
  }
  .rule-list li {
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    background-color: var(--color-timber-50);
    border-left: 3px solid var(--color-timber-500);
  }

  .cta-section {
    padding-block: 4rem;
    background-color: var(--color-ocean-50);
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .price-note {
    margin: 0 0 1.5rem;
    color: var(--color-timber-900);
    font-weight: 500;
    font-size: 1rem;
  }
  .cta-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    width: 100%;
    max-width: 32rem;
  }
  @media (min-width: 640px) {
    .cta-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 1rem 1.25rem;
    border-radius: 0.85rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    color: white;
    transition: transform 200ms var(--ease-snappy);
  }
  .cta-line {
    background-color: #00b900;
  }
  .cta-line:hover {
    background-color: #009900;
    transform: translateY(-1px);
  }
  .cta-phone {
    background-color: var(--color-ocean-700);
  }
  .cta-phone:hover {
    background-color: var(--color-ocean-800);
    transform: translateY(-1px);
  }
  .icon {
    font-family: var(--font-display);
    font-weight: 700;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
