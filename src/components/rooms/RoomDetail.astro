---
/**
 * RoomDetail — Editorial v3
 *
 * 單一房型詳情頁主體：相簿（CSS scroll snap）+ 規格 + 設施 + 規則 + 訂房 CTA。
 * Magazine 雜誌排版：
 *   - 大號 hero 標題 + 銅金細線
 *   - overview 改為大字距列表，無背景色塊
 *   - 設施與規則改為 magazine 雙欄，無厚重底色
 *   - CTA 段以 charcoal 背景區隔
 */
import { useTranslations } from '@/i18n/utils';
import { CONTACT } from '@/lib/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  room: CollectionEntry<'rooms'>;
}

const { locale, room } = Astro.props;
const t = useTranslations(locale);
const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
const beds = locale === 'en' ? room.data.beds_en : room.data.beds_zh;
const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
const desc = locale === 'en' ? room.data.description_en : room.data.description_zh;
const amenities = locale === 'en' ? room.data.amenities_en : room.data.amenities_zh;
const priceNote = locale === 'en' ? room.data.price_note_en : room.data.price_note_zh;
const galleryVariants = ['ocean', 'timber', 'sand', 'ink'] as const;
const lineUrl = CONTACT.lineUrl;
const phone = CONTACT.phonePrimary;
const phoneTel = CONTACT.phonePrimaryTel;
---

<article class="room-detail" aria-labelledby="room-detail-heading">
  <header class="header container-narrow">
    <span class="eyebrow">{t('rooms.breadcrumbLabel')}</span>
    <h1 id="room-detail-heading" class="title">{name}</h1>
    <span class="rule-gold rule-gold-center" aria-hidden="true"></span>
    <p class="lead">{desc}</p>
  </header>

  <section class="overview-section">
    <div class="container-wide">
      <dl class="overview">
        <div>
          <dt>{t('rooms.sizeLabel')}</dt>
          <dd>{room.data.size}{t('rooms.sizeUnit')}</dd>
        </div>
        <div>
          <dt>{t('rooms.capacityLabel')}</dt>
          <dd>{room.data.capacity}{t('rooms.capacityUnit')}</dd>
        </div>
        <div>
          <dt>{t('rooms.bedLabel')}</dt>
          <dd>{beds}</dd>
        </div>
        <div>
          <dt>{t('rooms.viewLabel')}</dt>
          <dd>{view}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="gallery" aria-labelledby="room-detail-gallery-heading">
    <div class="container-wide">
      <SectionHeading id="room-detail-gallery-heading" title={t('rooms.detailGalleryHeading')} variant="wabi" />
      <p class="hint" aria-hidden="true">{t('ui.galleryHint')}</p>
      <ul
        class="snap"
        aria-label={t('ui.galleryAria')}
        role="region"
        tabindex="0"
      >
        {
          room.data.gallery.map((alt, i) => (
            <li>
              <ImagePlaceholder
                locale={locale}
                alt={alt}
                ratio="4:3"
                variant={galleryVariants[i % galleryVariants.length] ?? 'ocean'}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="amenities" aria-labelledby="room-detail-amenities-heading">
    <div class="container-wide grid">
      <div>
        <SectionHeading id="room-detail-amenities-heading" title={t('rooms.detailAmenityHeading')} variant="wabi" />
        <ul class="check-list">
          {amenities.map((a) => (
            <li>
              <span class="check" aria-hidden="true">—</span>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeading title={t('rooms.detailRulesHeading')} variant="wabi" />
        <ol class="rule-list">
          <li>{t('rooms.detailRule1')}</li>
          <li>{t('rooms.detailRule2')}</li>
          <li>{t('rooms.detailRule3')}</li>
          <li>{t('rooms.detailRule4')}</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="cta-section" aria-labelledby="room-detail-cta-heading">
    <div class="container-narrow cta-inner">
      <span class="rule-gold rule-gold-center" aria-hidden="true"></span>
      <h2 id="room-detail-cta-heading" class="cta-title">{t('rooms.detailContactHeading')}</h2>
      <p class="cta-body">{t('rooms.detailContactBody')}</p>
      <p class="price-note">{priceNote}</p>
      <div class="cta-row">
        <a class="btn-line on-dark is-copper" href={lineUrl} target="_blank" rel="noopener noreferrer">
          {t('common.addLine')}
        </a>
        <a class="btn-line on-dark" href={`tel:${phoneTel}`}>
          {phone}
        </a>
      </div>
    </div>
  </section>
</article>

<style>
  .room-detail {
    background-color: var(--color-bone-50);
    padding-bottom: 0;
  }
  .header {
    padding-block: 6rem 4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .header .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.4vw, 4rem);
    color: var(--color-ink-900);
    line-height: 1.1;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .lead {
    margin: 0;
    color: var(--color-ink-600);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 2;
    font-weight: 300;
    max-width: 38rem;
  }

  .overview-section {
    padding-block: 3rem;
    border-top: 1px solid rgb(160 134 96 / 0.2);
    border-bottom: 1px solid rgb(160 134 96 / 0.2);
  }
  .overview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin: 0;
  }
  @media (min-width: 768px) {
    .overview {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .overview div { display: flex; flex-direction: column; gap: 0.5rem; }
  .overview dt {
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
  }
  .overview dd {
    margin: 0;
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: 0.02em;
  }
  :lang(en) .overview dd {
    font-family: var(--font-display-en);
  }

  .gallery {
    padding-block: 6rem;
  }
  .hint {
    margin: -1rem 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-500);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .snap {
    list-style: none;
    margin: 0;
    padding: 0 0 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(82%, 1fr);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  @media (min-width: 768px) {
    .snap { grid-auto-columns: minmax(48%, 1fr); }
  }
  @media (min-width: 1024px) {
    .snap { grid-auto-columns: minmax(34%, 1fr); }
  }
  .snap li {
    scroll-snap-align: start;
    overflow: hidden;
  }

  .amenities {
    padding-block: 6rem;
    background-color: var(--color-bone-100);
  }
  .grid {
    display: grid;
    gap: 4rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
    }
  }
  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    color: var(--color-ink-800);
    line-height: 1.85;
  }
  .check-list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.6rem;
    align-items: start;
    padding-block: 0.85rem;
    border-bottom: 1px solid rgb(160 134 96 / 0.18);
    font-size: 0.95rem;
  }
  .check {
    color: var(--color-copper-500);
    font-weight: 500;
    line-height: 1.4;
    font-family: var(--font-mono);
  }
  .rule-list {
    list-style: none;
    counter-reset: rule;
    margin: 0;
    padding: 0;
  }
  .rule-list li {
    counter-increment: rule;
    padding: 1.1rem 0 1.1rem 3rem;
    border-bottom: 1px solid rgb(160 134 96 / 0.18);
    color: var(--color-ink-700);
    line-height: 1.85;
    position: relative;
    font-size: 0.95rem;
  }
  .rule-list li::before {
    content: counter(rule, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-copper-600);
    letter-spacing: 0.16em;
  }

  .cta-section {
    padding-block: 7rem;
    background-color: var(--color-ink-950);
    color: var(--color-bone-100);
  }
  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }
  .cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.6vw, 2.5rem);
    color: var(--color-bone-100);
    letter-spacing: 0.02em;
    line-height: 1.2;
    font-weight: 400;
  }
  :lang(en) .cta-title {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .cta-body {
    margin: 0;
    color: rgb(245 239 230 / 0.78);
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.95;
    max-width: 36rem;
  }
  .price-note {
    margin: 1rem 0 1.5rem;
    color: var(--color-copper-300);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
