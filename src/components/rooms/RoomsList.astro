---
/**
 * RoomsList
 *
 * 房型列表頁主體：以 Bento Grid 不規則卡片排版呈現所有房型。
 * 第一張卡片（海景套房或第一個 order 的高階房）佔較大比例做視覺重點。
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('rooms');
if (!all.length) {
  throw new Error('[content] rooms collection 為空');
}
// 穩定排序：order 相同時改以 slug 字典序當 tiebreaker，避免 build / runtime 順序漂移。
const rooms = all
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));
const variants = ['ocean', 'timber', 'sand', 'ink', 'ocean'] as const;
---

<section class="rooms-list" aria-labelledby="rooms-list-page-heading">
  <header class="page-header container-wide">
    <h1 id="rooms-list-page-heading" class="page-title">{t('rooms.pageTitle')}</h1>
    <p class="page-lead">{t('rooms.pageLead')}</p>
    <p class="meals-note">{t('common.noMealsNotice')}</p>
  </header>

  <div class="container-wide">
    <SectionHeading title={t('rooms.pageTitle')} variant="wabi" />
    <ul class="bento">
      {
        rooms.map((room, idx) => {
          const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
          const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
          const beds = locale === 'en' ? room.data.beds_en : room.data.beds_zh;
          const desc = locale === 'en' ? room.data.description_en : room.data.description_zh;
          const priceNote = locale === 'en' ? room.data.price_note_en : room.data.price_note_zh;
          const variant = variants[idx % variants.length] ?? 'ocean';
          const href = getLocalizedPath(`/rooms/${room.data.slug}`, locale);
          const isFeatured = idx === 0;
          return (
            <li class:list={['card', isFeatured ? 'featured' : '']}>
              <a class="card-link" href={href} aria-label={name}>
                <div class="image">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio={isFeatured ? '16:9' : '4:3'}
                    variant={variant}
                  />
                </div>
                <div class="body">
                  <h2 class="name">{name}</h2>
                  <dl class="meta">
                    <div>
                      <dt>{t('rooms.sizeLabel')}</dt>
                      <dd>{room.data.size}{t('rooms.sizeUnit')}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.capacityLabel')}</dt>
                      <dd>{room.data.capacity}{t('rooms.capacityUnit')}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.viewLabel')}</dt>
                      <dd>{view}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.bedLabel')}</dt>
                      <dd>{beds}</dd>
                    </div>
                  </dl>
                  {isFeatured ? <p class="desc">{desc}</p> : null}
                  <p class="price">{priceNote}</p>
                  <span class="cta">
                    {t('rooms.seePriceCta')}
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="price-foot">{t('rooms.priceNote')}</p>
  </div>
</section>

<style>
  .rooms-list {
    background-color: var(--color-timber-50);
    padding-bottom: 5rem;
  }
  .page-header {
    padding-block: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    color: var(--color-ink-950);
  }
  .page-lead {
    margin: 0;
    max-width: 38rem;
    color: var(--color-ink-700);
    font-size: 1.05rem;
    line-height: 1.85;
  }
  .meals-note {
    margin: 0;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background-color: var(--color-sand-100);
    color: var(--color-sand-900);
    font-size: 0.88rem;
    font-style: italic;
  }
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .bento .featured {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    .bento .featured {
      grid-column: span 3;
    }
  }
  .card {
    background-color: var(--color-surface);
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--color-timber-200);
    transition: transform 240ms var(--ease-snappy), box-shadow 240ms var(--ease-snappy);
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -22px rgb(15 23 42 / 0.18);
  }
  .featured {
    background-color: var(--color-ocean-50);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .image {
    overflow: hidden;
  }
  .body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--color-ink-950);
  }
  .featured .name {
    font-size: clamp(1.65rem, 2.6vw, 2rem);
  }
  .meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.25rem;
    font-size: 0.85rem;
  }
  .meta div {
    display: flex;
    flex-direction: column;
  }
  .meta dt {
    color: var(--color-ink-500);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta dd {
    margin: 0;
    color: var(--color-ink-800);
    font-weight: 500;
  }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .price {
    margin: 0;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    background-color: var(--color-timber-100);
    color: var(--color-timber-900);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ocean-700);
    font-weight: 600;
  }
  .price-foot {
    margin: 2rem 0 0;
    color: var(--color-ink-500);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
