---
/**
 * RoomsList — Editorial v3
 *
 * 房型列表頁主體：horizontal rows 全寬列。
 * 每一房型一整列：左圖 60% + 右文 40%，文字大量留白、垂直置中。
 * 房型編號（01 / 02 / 03）作為大裝飾元素。
 *
 * 與 v2 差異：
 *   - 拋棄 Bento Grid（過於 crowded）
 *   - 改為 magazine 式雜誌排版，每房型獨佔一列
 *   - 偶數列圖文倒置（zigzag），閱讀節奏更精緻
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('rooms');
if (!all.length) {
  throw new Error('[content] rooms collection 為空');
}
const rooms = all
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));

const HERO_SLUG = 'sea-suite';
const variantBySlug: Record<string, 'ocean' | 'timber' | 'sand' | 'ink'> = {
  'standard-double': 'timber',
  'standard-quad': 'sand',
  'backpack-4': 'ocean',
  'backpack-6': 'timber',
  'sea-suite': 'ink',
};
---

<section class="rooms-list" aria-labelledby="rooms-list-page-heading">
  <header class="page-header container-wide reveal">
    <div class="chapter-mark">
      <span class="num">II</span>
      <span class="label">{locale === 'en' ? 'CHAPTER · WHERE YOU SLEEP' : 'CHAPTER · 住的房間'}</span>
    </div>
    <h1 id="rooms-list-page-heading" class="page-title">{t('rooms.pageTitle')}</h1>
    <p class="page-lead">{t('rooms.pageLead')}</p>
    <span class="brand-statement">{t('rooms.bentoEyebrow')}</span>
    <p class="meals-note">{t('common.noMealsNotice')}</p>
  </header>

  <ul class="rows">
    {
      rooms.map((room, idx) => {
        const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
        const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
        const beds = locale === 'en' ? room.data.beds_en : room.data.beds_zh;
        const desc = locale === 'en' ? room.data.description_en : room.data.description_zh;
        const priceNote = locale === 'en' ? room.data.price_note_en : room.data.price_note_zh;
        const variant = variantBySlug[room.data.slug] ?? 'timber';
        const href = getLocalizedPath(`/rooms/${room.data.slug}`, locale);
        const isFeatured = room.data.slug === HERO_SLUG;
        const num = String(idx + 1).padStart(2, '0');
        const reverse = idx % 2 === 1;
        return (
          <li class:list={['row', isFeatured ? 'featured' : '', reverse ? 'reverse' : '']}>
            <div class="container-wide row-grid">
              <div class="image-col">
                <a class="image-link" href={href} aria-label={name}>
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio={isFeatured ? '16:9' : '4:3'}
                    variant={variant}
                  />
                </a>
              </div>
              <div class="text-col">
                <span class="row-num" aria-hidden="true">{num}</span>
                {isFeatured ? <span class="featured-badge">{t('rooms.featuredBadge')}</span> : null}
                <h2 class="name"><a href={href}>{name}</a></h2>
                <span class="rule-gold" aria-hidden="true"></span>
                <p class="desc">{desc}</p>
                <dl class="meta">
                  <div>
                    <dt>{t('rooms.sizeLabel')}</dt>
                    <dd>{room.data.size}{t('rooms.sizeUnit')}</dd>
                  </div>
                  <div>
                    <dt>{t('rooms.capacityLabel')}</dt>
                    <dd>{room.data.capacity}{t('rooms.capacityUnit')}</dd>
                  </div>
                  <div>
                    <dt>{t('rooms.viewLabel')}</dt>
                    <dd>{view}</dd>
                  </div>
                  <div>
                    <dt>{t('rooms.bedLabel')}</dt>
                    <dd>{beds}</dd>
                  </div>
                </dl>
                <p class="price">{priceNote}</p>
                <a class="btn-line" href={href}>
                  {t('rooms.seePriceCta')}
                </a>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <p class="price-foot container-narrow">{t('rooms.priceNote')}</p>
</section>

<style>
  .rooms-list {
    background-color: var(--color-sand-50);
    padding-bottom: 4rem;
  }
  .page-header {
    padding-block: 5rem 4rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 1024px) {
    .page-header { padding-block: 6.5rem 5rem; }
  }
  .page-header .chapter-mark {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .page-header .chapter-mark .num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-sun-400);
    letter-spacing: -0.02em;
    line-height: 0.9;
    font-weight: 400;
  }
  .page-header .chapter-mark .label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-weight: 500;
  }
  :lang(en) .page-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .page-lead {
    margin: 0;
    max-width: 36rem;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.85;
    font-style: italic;
    font-weight: 300;
  }
  :lang(en) .page-lead { font-family: var(--font-display-en); }
  .brand-statement {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-sun-500);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    border-top: 1px solid var(--color-sun-400);
    padding-top: 1rem;
    width: fit-content;
  }
  .meals-note {
    margin: 1rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--color-sea-500);
    background-color: var(--color-sand-100);
    color: var(--color-ink-700);
    font-size: 0.92rem;
    font-style: italic;
    font-family: var(--font-display);
    max-width: 38rem;
    line-height: 1.7;
  }
  :lang(en) .meals-note { font-family: var(--font-display-en); }

  /* === rows === */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    padding-block: 3rem;
    border-top: 1px solid rgb(213 207 194 / 0.18);
  }
  .row:last-child {
    border-bottom: 1px solid rgb(213 207 194 / 0.18);
  }
  .row.featured {
    background-color: var(--color-bone-100);
  }
  .row-grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .row-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 5rem;
    }
    .row.reverse .row-grid {
      grid-template-columns: 1fr 1.4fr;
    }
    .row.reverse .image-col { order: 2; }
    .row.reverse .text-col { order: 1; }
    .row.featured .row-grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }
  .image-col {
    overflow: hidden;
  }
  .image-link {
    display: block;
    transition: transform 800ms var(--ease-editorial);
  }
  .image-link:hover { transform: scale(1.015); }
  .text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    padding-block: 1rem;
  }
  .row-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-copper-500);
    line-height: 1;
    font-weight: 300;
    letter-spacing: 0.02em;
  }
  .featured-badge {
    position: absolute;
    top: 1rem;
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-copper-600);
    border: 1px solid var(--color-copper-500);
    padding: 0.4rem 0.85rem;
  }
  .name {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    color: var(--color-ink-900);
    line-height: 1.18;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .name {
    font-family: var(--font-display-en);
    font-style: italic;
  }
  .name a {
    color: inherit;
    text-decoration: none;
    transition: color 280ms var(--ease-editorial);
  }
  .name a:hover { color: var(--color-copper-600); }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.98rem;
    line-height: 2;
    max-width: 38rem;
  }
  .meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 2rem;
    font-size: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(213 207 194 / 0.2);
  }
  .meta div { display: flex; flex-direction: column; gap: 0.3rem; }
  .meta dt {
    color: var(--color-copper-600);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .meta dd {
    margin: 0;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .price {
    margin: 0;
    color: var(--color-ink-600);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .price-foot {
    margin: 4rem auto 0;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    text-align: center;
  }
</style>
