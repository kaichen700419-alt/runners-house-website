---
/**
 * RoomsList
 *
 * 房型列表頁主體：以對稱 3-up Bento Grid 呈現。
 * 排版邏輯（桌面 ≥1024px）：
 *   - 第 1 列：標準雙人 / 標準四人 / 4 人背包房（各佔 1 col）
 *   - 第 2 列：6 人背包房（1 col）+ 海景套房（col-span-2 作為 hero room 強調）
 * 行動 / 平板：1~2 col 普通堆疊；hero col-span 僅在 ≥1024px 才生效，
 * 避免在小螢幕產生不對稱排版。
 *
 * 與舊版差異：
 *   - 移除 SectionHeading，避免「麵包屑 / eyebrow / H1」三層重複「房型介紹」
 *   - hero 卡片改以 slug === 'sea-suite' 判定（穩定、不依賴陣列 index 漂移）
 *   - 加入 eyebrow 行 + 房型數量微標示，提供視覺節奏錨點
 */
import { getCollection } from 'astro:content';
import { getLocalizedPath, useTranslations } from '@/i18n/utils';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = await getCollection('rooms');
if (!all.length) {
  throw new Error('[content] rooms collection 為空');
}
// 穩定排序：order 相同時改以 slug 字典序當 tiebreaker，避免 build / runtime 順序漂移。
const rooms = all
  .slice()
  .sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));

// hero 卡片以 slug 鎖定，不再依賴陣列 idx；未來新增 / 重新排序房型也不會誤把背包房變 hero。
const HERO_SLUG = 'sea-suite';
// 卡片色塊 variant 以 slug 對應，順序變動不影響色彩；缺省 fallback 'ocean'。
const variantBySlug: Record<string, 'ocean' | 'timber' | 'sand' | 'ink'> = {
  'standard-double': 'ocean',
  'standard-quad': 'timber',
  'backpack-4': 'sand',
  'backpack-6': 'ink',
  'sea-suite': 'ocean',
};
---

<section class="rooms-list" aria-labelledby="rooms-list-page-heading">
  <header class="page-header container-wide">
    <h1 id="rooms-list-page-heading" class="page-title">{t('rooms.pageTitle')}</h1>
    <p class="page-lead">{t('rooms.pageLead')}</p>
    <p class="meals-note">{t('common.noMealsNotice')}</p>
  </header>

  <div class="container-wide">
    <p class="bento-eyebrow" aria-hidden="true">
      <span class="bar"></span>
      <span class="text">{t('rooms.bentoEyebrow')}</span>
    </p>
    <ul class="bento">
      {
        rooms.map((room) => {
          const name = locale === 'en' ? room.data.name_en : room.data.name_zh;
          const view = locale === 'en' ? room.data.view_en : room.data.view_zh;
          const beds = locale === 'en' ? room.data.beds_en : room.data.beds_zh;
          const desc = locale === 'en' ? room.data.description_en : room.data.description_zh;
          const priceNote = locale === 'en' ? room.data.price_note_en : room.data.price_note_zh;
          const variant = variantBySlug[room.data.slug] ?? 'ocean';
          const href = getLocalizedPath(`/rooms/${room.data.slug}`, locale);
          const isFeatured = room.data.slug === HERO_SLUG;
          return (
            <li class:list={['card', isFeatured ? 'featured' : '']}>
              <a class="card-link" href={href} aria-label={name}>
                <div class="image">
                  <ImagePlaceholder
                    locale={locale}
                    alt={name}
                    ratio={isFeatured ? '16:9' : '4:3'}
                    variant={variant}
                  />
                  {isFeatured ? (
                    <span class="badge">{t('rooms.featuredBadge')}</span>
                  ) : null}
                </div>
                <div class="body">
                  <h2 class="name">{name}</h2>
                  <dl class="meta">
                    <div>
                      <dt>{t('rooms.sizeLabel')}</dt>
                      <dd>{room.data.size}{t('rooms.sizeUnit')}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.capacityLabel')}</dt>
                      <dd>{room.data.capacity}{t('rooms.capacityUnit')}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.viewLabel')}</dt>
                      <dd>{view}</dd>
                    </div>
                    <div>
                      <dt>{t('rooms.bedLabel')}</dt>
                      <dd>{beds}</dd>
                    </div>
                  </dl>
                  {isFeatured ? <p class="desc">{desc}</p> : null}
                  <p class="price">{priceNote}</p>
                  <span class="cta">
                    {t('rooms.seePriceCta')}
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="price-foot">{t('rooms.priceNote')}</p>
  </div>
</section>

<style>
  .rooms-list {
    background-color: var(--color-timber-50);
    padding-bottom: 5rem;
  }
  .page-header {
    padding-block: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    color: var(--color-ink-950);
  }
  .page-lead {
    margin: 0;
    max-width: 38rem;
    color: var(--color-ink-700);
    font-size: 1.05rem;
    line-height: 1.85;
  }
  .meals-note {
    margin: 0;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background-color: var(--color-sand-100);
    color: var(--color-sand-900);
    font-size: 0.88rem;
    font-style: italic;
  }
  /* eyebrow：以細色帶 + 等寬字當作 grid 的視覺節奏錨點，取代原本重複標題的 SectionHeading */
  .bento-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--color-timber-700);
    text-transform: uppercase;
  }
  .bento-eyebrow .bar {
    display: inline-block;
    width: 2.5rem;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-timber-600), var(--color-sand-400));
  }
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    /* hero 房型獨佔 2 col：order=5 排序最後，自然落在第 2 列右側兩格，
       與第 2 列第 1 格（6 人背包房）合計 3 col 完整覆蓋一列，視覺對稱無破洞。 */
    .bento .featured {
      grid-column: span 2;
    }
  }
  .card {
    background-color: var(--color-surface);
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--color-timber-200);
    transition: transform 240ms var(--ease-snappy), box-shadow 240ms var(--ease-snappy);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px -22px rgb(15 23 42 / 0.22);
  }
  .featured {
    background-color: var(--color-ocean-50);
    border-color: var(--color-ocean-200);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .image {
    position: relative;
    overflow: hidden;
  }
  .badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background-color: rgb(255 255 255 / 0.92);
    color: var(--color-ocean-800);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 4px 12px -6px rgb(15 23 42 / 0.18);
  }
  .body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--color-ink-950);
  }
  .featured .name {
    font-size: clamp(1.65rem, 2.6vw, 2rem);
  }
  .meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.25rem;
    font-size: 0.85rem;
  }
  .meta div {
    display: flex;
    flex-direction: column;
  }
  .meta dt {
    color: var(--color-ink-500);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta dd {
    margin: 0;
    color: var(--color-ink-800);
    font-weight: 500;
  }
  .desc {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.95rem;
    line-height: 1.75;
  }
  .price {
    margin: 0;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    background-color: var(--color-timber-100);
    color: var(--color-timber-900);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ocean-700);
    font-weight: 600;
  }
  .price-foot {
    margin: 2rem 0 0;
    color: var(--color-ink-500);
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
