---
/**
 * ChargingSections
 *
 * 特斯拉超充頁主體：付費聲明 → 規格 → 規則 → 位置 → 非住客歡迎。
 * 強調「付費」、「非免費」，避免使用者誤解。
 */
import { useTranslations } from '@/i18n/utils';
import { CONTACT, GEO } from '@/lib/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import type { Locale } from '@/i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const mapQuery = encodeURIComponent(`${GEO.latitude},${GEO.longitude}`);
const mapEmbedSrc = `https://www.google.com/maps?q=${mapQuery}&hl=${locale === 'en' ? 'en' : 'zh-TW'}&z=17&output=embed`;
const lineUrl = CONTACT.lineUrl;
---

<article class="charging" aria-labelledby="charging-page-heading">
  <header class="page-header container-wide reveal">
    <div class="chapter-mark">
      <span class="num">IV</span>
      <span class="label">{locale === 'en' ? 'CHAPTER · TESLA SUPERCHARGE' : 'CHAPTER · 特斯拉超充'}</span>
    </div>
    <h1 id="charging-page-heading" class="page-title">{t('charging.pageTitle')}</h1>
    <p class="page-lead">{t('charging.pageLead')}</p>
    <span class="brand-statement">{t('charging.eyebrow')}</span>
  </header>

  <section class="paid-notice" aria-labelledby="charging-paid-heading">
    <div class="container-wide notice-box">
      <span class="badge" aria-hidden="true">$</span>
      <div>
        <h2 id="charging-paid-heading" class="notice-title">{t('charging.paidNoticeHeading')}</h2>
        <p class="notice-body">{t('charging.paidNoticeBody')}</p>
        <dl class="notice-meta">
          <div>
            <dt>{t('charging.paidPriceTitle')}</dt>
            <dd>{t('charging.paidPriceBody')}</dd>
          </div>
          <div>
            <dt>{t('charging.paidGuestTitle')}</dt>
            <dd>{t('charging.paidGuestBody')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="specs" aria-labelledby="charging-specs-heading">
    <div class="container-wide">
      <SectionHeading id="charging-specs-heading" title={t('charging.specsHeading')} variant="ocean" />
      <ul class="spec-grid">
        <li>
          <h3>{t('charging.specsConnectorTitle')}</h3>
          <p>{t('charging.specsConnectorBody')}</p>
        </li>
        <li>
          <h3>{t('charging.specsPowerTitle')}</h3>
          <p>{t('charging.specsPowerBody')}</p>
        </li>
        <li>
          <h3>{t('charging.specsCompatTitle')}</h3>
          <p>{t('charging.specsCompatBody')}</p>
        </li>
        <li>
          <h3>{t('charging.specsParkingTitle')}</h3>
          <p>{t('charging.specsParkingBody')}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="rules" aria-labelledby="charging-rules-heading">
    <div class="container-wide">
      <SectionHeading id="charging-rules-heading" title={t('charging.rulesHeading')} variant="ocean" />
      <ol class="rules-list">
        <li>{t('charging.ruleReserve')}</li>
        <li>{t('charging.ruleNoOvernight')}</li>
        <li>{t('charging.ruleEtiquette')}</li>
        <li>{t('charging.ruleSafety')}</li>
      </ol>
      <a class="reserve-cta" href={lineUrl} target="_blank" rel="noopener noreferrer">
        {t('common.addLine')} → {t('charging.ruleReserve')}
      </a>
    </div>
  </section>

  <section class="location" aria-labelledby="charging-location-heading">
    <div class="container-wide grid">
      <div class="info">
        <SectionHeading id="charging-location-heading" title={t('charging.locationHeading')} variant="ocean" />
        <p>{t('charging.locationBody')}</p>
        <p class="address">{t('common.addressFull')}</p>
      </div>
      <div class="map">
        <iframe
          title={t('charging.locationHeading')}
          src={mapEmbedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups"
          width="100%"
          height="380"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="non-guest" aria-labelledby="charging-nonguest-heading">
    <div class="container-wide non-guest-inner">
      <div class="visual">
        <ImagePlaceholder locale={locale} alt={t('charging.nonGuestHeading')} ratio="4:3" variant="ocean" />
      </div>
      <div class="content">
        <SectionHeading id="charging-nonguest-heading" title={t('charging.nonGuestHeading')} variant="ocean" />
        <p>{t('charging.nonGuestBody')}</p>
      </div>
    </div>
  </section>
</article>

<style>
  /* === Charging — Mineral Coast v4 === */
  .charging {
    background-color: var(--color-sand-50);
    padding-bottom: 0;
  }
  .page-header {
    padding-block: 5rem 4rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 56rem;
  }
  @media (min-width: 1024px) {
    .page-header { padding-block: 6.5rem 5rem; }
  }
  .page-header .chapter-mark {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .page-header .chapter-mark .num {
    font-family: var(--font-display-en);
    font-style: italic;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-sun-400);
    letter-spacing: -0.02em;
    line-height: 0.9;
    font-weight: 400;
  }
  .page-header .chapter-mark .label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.4em;
    color: var(--color-ink-500);
    text-transform: uppercase;
  }
  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    color: var(--color-ink-900);
    letter-spacing: -0.005em;
    line-height: 1.05;
    font-weight: 500;
  }
  :lang(en) .page-title {
    font-family: var(--font-display-en);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .page-lead {
    margin: 0;
    max-width: 38rem;
    color: var(--color-ink-500);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.85;
    font-weight: 300;
  }
  :lang(en) .page-lead { font-family: var(--font-display-en); }
  .brand-statement {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-sun-500);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    border-top: 1px solid var(--color-sun-400);
    padding-top: 1rem;
    width: fit-content;
  }

  section { padding-block: 5rem; }
  section + section { border-top: 1px solid rgb(213 207 194 / 0.18); }

  .paid-notice { padding-block: 4rem; }
  .notice-box {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 2rem;
    padding: 3rem 2.5rem;
    background-color: var(--color-bone-100);
    border: 1px solid rgb(213 207 194 / 0.3);
    border-left: 2px solid var(--color-copper-500);
    align-items: start;
    max-width: 1024px;
    margin: 0 auto;
  }
  .badge {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-copper-500);
    color: var(--color-copper-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.4rem;
  }
  .notice-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  :lang(en) .notice-title { font-family: var(--font-display-en); font-style: italic; }
  .notice-body {
    margin: 0 0 1.75rem;
    color: var(--color-ink-700);
    font-size: 0.98rem;
    line-height: 1.95;
  }
  .notice-meta {
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .notice-meta { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  }
  .notice-meta div {
    padding-top: 1.25rem;
    border-top: 1px solid rgb(213 207 194 / 0.25);
  }
  .notice-meta dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--color-copper-600);
    margin-bottom: 0.6rem;
  }
  .notice-meta dd {
    margin: 0;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .specs { background-color: var(--color-bone-100); }
  .spec-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border-top: 1px solid rgb(213 207 194 / 0.25);
  }
  @media (min-width: 768px) {
    .spec-grid { grid-template-columns: 1fr 1fr; }
    .spec-grid li:nth-child(odd) {
      border-right: 1px solid rgb(213 207 194 / 0.25);
    }
  }
  .spec-grid li {
    padding: 2rem;
    border-bottom: 1px solid rgb(213 207 194 / 0.25);
  }
  .spec-grid h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--color-copper-600);
    font-weight: 500;
  }
  .spec-grid p {
    margin: 0;
    color: var(--color-ink-800);
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .rules-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    counter-reset: rule;
  }
  .rules-list li {
    counter-increment: rule;
    padding: 1.25rem 0 1.25rem 3rem;
    border-bottom: 1px solid rgb(213 207 194 / 0.18);
    color: var(--color-ink-700);
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.85;
    position: relative;
  }
  .rules-list li::before {
    content: counter(rule, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-copper-600);
    letter-spacing: 0.16em;
  }
  .reserve-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2rem;
    padding: 0.95rem 1.85rem;
    border: 1px solid var(--color-line-brand);
    color: var(--color-line-brand);
    background-color: transparent;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background-color 320ms var(--ease-editorial),
      color 320ms var(--ease-editorial);
  }
  .reserve-cta:hover {
    background-color: var(--color-line-brand);
    color: white;
  }

  .location { background-color: var(--color-bone-100); }
  .grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 0.85fr 1.4fr;
      gap: 4rem;
      align-items: start;
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--color-ink-700);
    font-size: 1rem;
    line-height: 2;
  }
  .info p { margin: 0; }
  .address {
    padding: 1.25rem 0 0;
    border-top: 1px solid rgb(213 207 194 / 0.3);
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.02em;
  }
  .map {
    border: 1px solid rgb(213 207 194 / 0.3);
    overflow: hidden;
  }
  .map iframe {
    display: block;
    border: 0;
    width: 100%;
    filter: grayscale(0.55) brightness(0.96) contrast(0.95);
  }

  .non-guest {
    background-color: var(--color-ink-950);
    color: var(--color-bone-100);
  }
  .non-guest :global(.section-heading .title) {
    color: var(--color-bone-100);
  }
  .non-guest :global(.section-heading .subtitle) {
    color: rgb(244 241 234 / 0.78);
  }
  .non-guest-inner {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .non-guest-inner {
      grid-template-columns: 0.85fr 1fr;
      gap: 5rem;
    }
  }
  .visual { overflow: hidden; }
  .non-guest .content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: rgb(244 241 234 / 0.82);
    font-size: 1rem;
    line-height: 2;
  }
  .non-guest .content p { margin: 0; max-width: 38rem; }
</style>
