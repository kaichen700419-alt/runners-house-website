---
/**
 * 首頁（zh-TW 預設語系）
 *
 * 渲染 BaseLayout + HeroSection，並在頁面層注入 LodgingBusiness JSON-LD。
 * 所有可見字串透過 useTranslations('zh-TW') 從 i18n 字典讀取。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import { useTranslations } from '@/i18n/utils';
import { lodgingBusinessSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const locale = 'zh-TW';
const t = useTranslations(locale);
const canonical = new URL('/', SITE.url).toString();
const ogImage = new URL(SITE.defaultOgImage, SITE.url).toString();
const lodging = lodgingBusinessSchema({
  locale,
  url: canonical,
  description: t('seo.homeDescription'),
  imageUrl: ogImage,
});
---

<BaseLayout
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
  schema={lodging}
>
  <HeroSection locale={locale} />
</BaseLayout>
