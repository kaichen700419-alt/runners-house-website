---
/**
 * 首頁（zh-TW 預設語系）v5 — 內容飽滿的精品民宿首頁
 *
 * 業主強烈反饋：v4 的 12 屏 27000px 超長首頁太誇張、空白幼稚。
 * v5 重做策略：5 屏緊湊版（約 4500-5000px 桌面高），每屏內容飽滿。
 *
 *   Screen 1  HeroSection     — 左字右大圖框 + 完整文案 + 規格條
 *   Screen 2  FeaturePillars  — Run / Stay / Charge 三聯（含小圖框）
 *   Screen 3  RoomPreview     — 4 房型 magazine spread（含圖框）
 *   Screen 4  StoryTeaser     — 米倉故事 + 時間軸 + 大圖框
 *   Screen 5  LocationMap     — 位置與三聯 CTA + 地圖
 *
 * 移除（v4 過於冗長）：RunnerNote、SeasonStrip、NumeralStat、ClosingCta
 * 業主提及 LINE / 電話 / 看房型三聯 CTA 已在 Hero 與 LocationMap 區提供。
 *
 * 注入 LodgingBusiness JSON-LD 至 <head>（保留，SEO 工程師同步在做）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import FeaturePillars from '@/components/home/FeaturePillars.astro';
import RoomPreview from '@/components/home/RoomPreview.astro';
import StoryTeaser from '@/components/home/StoryTeaser.astro';
import LocationMap from '@/components/home/LocationMap.astro';
import { useTranslations } from '@/i18n/utils';
import { lodgingBusinessSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const locale = 'zh-TW';
const t = useTranslations(locale);
const canonical = new URL('/', SITE.url).toString();
const ogImage = new URL(SITE.defaultOgImage, SITE.url).toString();
const lodging = lodgingBusinessSchema({
  locale,
  url: canonical,
  description: t('seo.homeDescription'),
  imageUrl: ogImage,
});
---

<BaseLayout
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
  schema={lodging}
>
  <HeroSection locale={locale} />
  <FeaturePillars locale={locale} />
  <RoomPreview locale={locale} />
  <StoryTeaser locale={locale} />
  <LocationMap locale={locale} />
</BaseLayout>
