---
import '@/styles/global.css';
---

<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>跑者之家 Runners House｜台東長濱海邊民宿</title>
    <meta
      name="description"
      content="位於台東縣長濱鄉、台 11 線 91K 旁的跑者主題民宿，由廢棄米倉重生改建。"
    />
  </head>
  <body class="min-h-dvh">
    <main class="container-wide flex min-h-dvh flex-col items-center justify-center text-center">
      <p class="font-mono text-sm tracking-widest text-ocean-700 uppercase">建置中</p>
      <h1 class="mt-4 font-display text-5xl text-ink-950 md:text-7xl">跑者之家 Runners House</h1>
      <p class="mt-6 max-w-prose text-balance text-ink-700">
