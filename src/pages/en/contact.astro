---
/**
 * Contact page (English)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSections from '@/components/contact/ContactSections.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import FaqJsonLd from '@/components/seo/FaqJsonLd.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/lib/site';

const locale = 'en';
const t = useTranslations(locale);

const breadcrumbItems = [
  { label: t('contact.pageTitle') },
];
const schemaBreadcrumbs = [
  { name: t('ui.breadcrumbHome'), url: new URL('/en', SITE.url).toString() },
  { name: t('contact.pageTitle'), url: new URL('/en/contact', SITE.url).toString() },
];
---

<BaseLayout
  title={t('seo.contactTitle')}
  description={t('seo.contactDescription')}
  breadcrumbs={schemaBreadcrumbs}
>
  <div class="container-wide">
    <Breadcrumbs locale={locale} items={breadcrumbItems} />
  </div>
  <ContactSections locale={locale} />
  {/* FAQ 區塊：JSON-LD + 可見 <details> 同源渲染，確保 schema 與 HTML 完全對齊 */}
  <FaqJsonLd locale={locale} />
</BaseLayout>
