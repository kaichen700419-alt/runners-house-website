---
/**
 * Tesla charging page (English)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChargingSections from '@/components/charging/ChargingSections.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE } from '@/lib/site';

const locale = 'en';
const t = useTranslations(locale);

const breadcrumbItems = [
  { label: t('charging.pageTitle') },
];
const schemaBreadcrumbs = [
  { name: t('ui.breadcrumbHome'), url: new URL('/en', SITE.url).toString() },
  { name: t('charging.pageTitle'), url: new URL('/en/charging', SITE.url).toString() },
];
---

<BaseLayout
  title={t('seo.chargingTitle')}
  description={t('seo.chargingDescription')}
  breadcrumbs={schemaBreadcrumbs}
>
  <div class="container-wide">
    <Breadcrumbs locale={locale} items={breadcrumbItems} />
  </div>
  <ChargingSections locale={locale} />
</BaseLayout>
