---
/**
 * 首頁（en 英文版）
 *
 * 渲染 BaseLayout + HeroSection，並在頁面層注入 LodgingBusiness JSON-LD（en）。
 * 結構與 zh-TW 完全對應；文案來自 i18n 字典 home.* / seo.*。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import { useTranslations } from '@/i18n/utils';
import { lodgingBusinessSchema } from '@/lib/schema';
import { SITE } from '@/lib/site';

const locale = 'en';
const t = useTranslations(locale);
const canonical = new URL('/en', SITE.url).toString();
const ogImage = new URL(SITE.defaultOgImage, SITE.url).toString();
const lodging = lodgingBusinessSchema({
  locale,
  url: canonical,
  description: t('seo.homeDescription'),
  imageUrl: ogImage,
});
---

<BaseLayout
  title={t('seo.homeTitle')}
  description={t('seo.homeDescription')}
  schema={lodging}
>
  <HeroSection locale={locale} />
</BaseLayout>
