---
/**
 * 房型列表頁（zh-TW）
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoomsList from '@/components/rooms/RoomsList.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { useTranslations } from '@/i18n/utils';
import { absoluteUrl } from '@/lib/site';

const locale = 'zh-TW';
const t = useTranslations(locale);

// 麵包屑顯示精簡標籤「房型」而非「房型介紹」，避免與 H1 重複造成三層相同字面。
const breadcrumbItems = [
  { label: t('rooms.breadcrumbLabel') },
];
const schemaBreadcrumbs = [
  { name: t('ui.breadcrumbHome'), url: absoluteUrl('/') },
  { name: t('rooms.pageTitle'), url: absoluteUrl('/rooms') },
];
---

<BaseLayout
  title={t('seo.roomsTitle')}
  description={t('seo.roomsDescription')}
  breadcrumbs={schemaBreadcrumbs}
>
  <div class="container-wide">
    <Breadcrumbs locale={locale} items={breadcrumbItems} />
  </div>
  <RoomsList locale={locale} />
</BaseLayout>
