---
/**
 * 房型詳情頁（zh-TW，動態路由 /rooms/[slug]）
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoomDetail from '@/components/rooms/RoomDetail.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { useTranslations } from '@/i18n/utils';
import { SITE, absoluteUrl } from '@/lib/site';
import { hotelRoomSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const rooms = await getCollection('rooms');
  // slug 重複會導致 Astro 後者覆寫前者，使前面定義的房型詳情頁靜默消失。
  // 在 build 期間 fail-loud，由人工介入處理重命名而非默默吞 bug。
  const seen = new Set<string>();
  for (const room of rooms) {
    if (seen.has(room.data.slug)) {
      throw new Error(`[rooms] slug 重複：${room.data.slug}`);
    }
    seen.add(room.data.slug);
  }
  return rooms.map((room) => ({
    params: { slug: room.data.slug },
    props: { room },
  }));
}

const locale = 'zh-TW';
const t = useTranslations(locale);
const { room } = Astro.props;
const name = room.data.name_zh;

const breadcrumbItems = [
  { label: t('rooms.pageTitle'), href: '/rooms' },
  { label: name },
];
const schemaBreadcrumbs = [
  { name: t('ui.breadcrumbHome'), url: absoluteUrl('/') },
  { name: t('rooms.pageTitle'), url: absoluteUrl('/rooms') },
  { name, url: absoluteUrl(`/rooms/${room.data.slug}`) },
];
const title = t('seo.roomDetailTitleTemplate', { room: name });

// HotelRoom Schema（MiniMax v2 健檢 P0-2 修復 — 房型頁商業價值最高的結構）
const roomSchema = hotelRoomSchema({
  locale,
  slug: room.data.slug,
  name,
  description: room.data.description_zh,
  occupancy: room.data.capacity,
  floorSizeSqm: room.data.size,
  bedType: room.data.beds_zh,
  view: room.data.view_zh,
  amenities: room.data.amenities_zh,
  imageUrl: absoluteUrl(SITE.defaultOgImage),
});
---

<BaseLayout
  title={title}
  description={t('seo.roomDetailDescription')}
  breadcrumbs={schemaBreadcrumbs}
  schema={roomSchema}
>
  <div class="container-wide">
    <Breadcrumbs locale={locale} items={breadcrumbItems} />
  </div>
  <RoomDetail locale={locale} room={room} />
</BaseLayout>
