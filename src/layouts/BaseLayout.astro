---
/**
 * BaseLayout v4 — 海風礦物 Mineral Coast
 *
 * 站內所有頁面的最外層 layout。
 * 職責：
 *  - 組合 SEOHead、JsonLd、Header、Footer、<slot />
 *  - 自動套用語系（依路徑判斷）並設定 <html lang>
 *  - 可選 schema、breadcrumbs，由呼叫端決定要不要塞 LodgingBusiness 等
 *  - 預設一律輸出 WebSite schema
 *  - v4 新增：
 *      1. 注入 IntersectionObserver — 為 .reveal class 加上 .is-in（滾動進場）
 *      2. 注入桌面 custom cursor（依研究報告 C4 規格 / TRUNK Hotel 致敬）
 *  - 字型策略：僅 preconnect 預熱連線（Google Fonts 字型檔 URL 帶 hash，無法穩定 preload）；
 *    字型 CSS 由 global.css @import 載入，display=swap 避免文字隱藏
 */
import '@/styles/global.css';
import SEOHead from '@/components/seo/SEOHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { detectLocale } from '@/i18n/utils';
import {
  breadcrumbSchema,
  websiteSchema,
  type BreadcrumbItem,
  type SchemaObject,
} from '@/lib/schema';

interface Props {
  /** 完整 <title>，含品牌 */
  title: string;
  /** meta description */
  description: string;
  /** 自訂 OG 圖（相對或絕對 URL） */
  image?: string;
  /** 額外 schema 物件（例：lodgingBusinessSchema）。會自動加上 WebSite + Breadcrumb */
  schema?: SchemaObject | ReadonlyArray<SchemaObject>;
  /** 麵包屑陣列；提供時會自動產生 BreadcrumbList JSON-LD */
  breadcrumbs?: ReadonlyArray<BreadcrumbItem>;
  /** robots 指令 */
  robots?: string;
  /** OG 類型 */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  image,
  schema,
  breadcrumbs,
  robots,
  ogType,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale = detectLocale(pathname);
const htmlLang = locale === 'en' ? 'en' : 'zh-Hant-TW';

// 組合所有 JSON-LD schema：WebSite 永遠輸出，Breadcrumb 和額外 schema 視 props 而定
const allSchemas: readonly SchemaObject[] = [
  websiteSchema(locale),
  ...(breadcrumbs?.length ? [breadcrumbSchema(breadcrumbs)] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* 預連線 Google Fonts，加快首屏字型載入 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <SEOHead
      title={title}
      description={description}
      pathname={pathname}
      locale={locale}
      image={image}
      robots={robots}
      ogType={ogType}
    />
    <JsonLd schema={allSchemas} />
  </head>
  <body class="min-h-dvh">
    {/* ========================================================
       * 校稿密碼守門（STAGING GATE）
       *
       * 校稿期間使用，正式上線時可移除整個 #staging-gate + 對應 inline script。
       * 機制：
       *   - localStorage 有 rh-staging-ok=1 → 直接顯示網站
       *   - 沒有 → 顯示全螢幕密碼牆，輸入正確密碼後設旗標 + 重新渲染
       *   - 密碼：runnershouse-preview
       *   - body 預設加 .staging-locked class（CSS 把主內容隱藏），通過後移除
       * ========================================================
     */}
    <div id="staging-gate" role="dialog" aria-label="校稿密碼">
      <div class="sg-card">
        <p class="sg-eyebrow">STAGING · PREVIEW</p>
        <h1 class="sg-title">校稿密碼</h1>
        <p class="sg-hint">本網站目前處於最終校稿階段，僅限授權人員預覽。請輸入校稿密碼後進入。</p>
        <form id="staging-form" autocomplete="off">
          <label for="staging-pass" class="sg-label">校稿密碼</label>
          <input type="password" id="staging-pass" name="staging-pass" required autocomplete="off" />
          <button type="submit" class="sg-submit">進入預覽</button>
          <p class="sg-error" id="staging-error" role="alert" aria-live="polite">密碼錯誤，請重新輸入</p>
        </form>
        <p class="sg-footer">RUNNERS HOUSE · TAITUNG CHANGBIN</p>
      </div>
    </div>

    <Header pathname={pathname} locale={locale} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* 桌面 custom cursor — 細圓圈跟隨滑鼠（hover 連結時放大為 48px 圈）
        手機 / 觸控 / prefers-reduced-motion 不顯示。 */}
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>

    <script is:inline>
      // === STAGING GATE：校稿密碼守門 ===
      // 預設鎖定，通過密碼後設 localStorage 旗標
      (function () {
        const PASSWORD = 'runnershouse-preview';
        const STORAGE_KEY = 'rh-staging-ok';
        const isUnlocked = localStorage.getItem(STORAGE_KEY) === '1';

        function unlock() {
          document.body.classList.remove('staging-locked');
          const gate = document.getElementById('staging-gate');
          if (gate) gate.style.display = 'none';
        }
        function lock() {
          document.body.classList.add('staging-locked');
        }

        if (isUnlocked) {
          unlock();
        } else {
          lock();
          const ready = () => {
            const form = document.getElementById('staging-form');
            const input = document.getElementById('staging-pass');
            const errEl = document.getElementById('staging-error');
            if (!form || !input || !errEl) return;
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              if (input.value === PASSWORD) {
                localStorage.setItem(STORAGE_KEY, '1');
                errEl.classList.remove('show');
                unlock();
              } else {
                errEl.classList.add('show');
                input.value = '';
                input.focus();
              }
            });
            input.focus();
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ready);
          } else {
            ready();
          }
        }
      })();

      // === 0. 標記 has-js — 才啟用 reveal 初始隱藏（noscript / JS 失敗時內容仍可見） ===
      document.documentElement.classList.add('has-js');

      // === 1. IntersectionObserver: 為 .reveal class 在進入視窗時加 .is-in ===
      (function () {
        if (typeof window === 'undefined') return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();

      // === 2. Custom cursor（桌面 + 非觸控） ===
      (function () {
        if (typeof window === 'undefined') return;
        const isCoarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (isCoarse || reduce) return;

        const dot = document.querySelector('.cursor-dot');
        const ring = document.querySelector('.cursor-ring');
        if (!(dot instanceof HTMLElement) || !(ring instanceof HTMLElement)) return;

        dot.classList.add('is-active');
        ring.classList.add('is-active');

        let mx = window.innerWidth / 2;
        let my = window.innerHeight / 2;
        let rx = mx;
        let ry = my;

        window.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
          dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
        });

        function loop() {
          rx += (mx - rx) * 0.18;
          ry += (my - ry) * 0.18;
          ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
          requestAnimationFrame(loop);
        }
        loop();

        // hover 連結 / 按鈕時 ring 放大 + 換色
        const hoverSelectors = 'a, button, .btn-line, [role="button"]';
        document.querySelectorAll(hoverSelectors).forEach((el) => {
          el.addEventListener('mouseenter', () => ring.classList.add('is-hover'));
          el.addEventListener('mouseleave', () => ring.classList.remove('is-hover'));
        });
      })();
    </script>

    <style is:global>
      /* === Custom cursor styles ===
         dot：8px 實心圓點；ring：32px 細圈，hover 連結時放大 48px。
         僅在桌面非觸控啟用（is-active 由 JS 加） */
      .cursor-dot,
      .cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        opacity: 0;
        transition: opacity 320ms ease;
        will-change: transform;
      }
      .cursor-dot {
        width: 6px;
        height: 6px;
        margin-left: -3px;
        margin-top: -3px;
        background-color: var(--color-sun-400);
        border-radius: 50%;
        mix-blend-mode: difference;
      }
      .cursor-ring {
        width: 32px;
        height: 32px;
        margin-left: -16px;
        margin-top: -16px;
        border: 1px solid var(--color-sun-400);
        border-radius: 50%;
        transition:
          width 320ms var(--ease-editorial),
          height 320ms var(--ease-editorial),
          margin 320ms var(--ease-editorial),
          background-color 320ms var(--ease-editorial),
          opacity 320ms ease;
      }
      .cursor-dot.is-active,
      .cursor-ring.is-active {
        opacity: 1;
      }
      .cursor-ring.is-hover {
        width: 56px;
        height: 56px;
        margin-left: -28px;
        margin-top: -28px;
        background-color: rgb(201 125 93 / 0.08);
      }
      @media (max-width: 1023px), (hover: none), (pointer: coarse) {
        .cursor-dot, .cursor-ring { display: none !important; }
      }

      /* ===== Staging Gate（校稿密碼牆） ===== */
      body.staging-locked > *:not(#staging-gate) {
        visibility: hidden !important;
      }
      body.staging-locked {
        overflow: hidden;
      }
      #staging-gate {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        background:
          radial-gradient(ellipse at 30% 20%, rgba(184, 142, 92, 0.4) 0%, transparent 60%),
          radial-gradient(ellipse at 70% 80%, rgba(60, 50, 40, 0.5) 0%, transparent 70%),
          linear-gradient(160deg, #2d2520 0%, #1a1411 50%, #251c16 100%);
        color: #f5efe5;
        padding: 1.5rem;
        font-family: 'Noto Sans TC', system-ui, sans-serif;
      }
      body.staging-locked #staging-gate { display: flex; }

      .sg-card {
        width: 100%;
        max-width: 420px;
        text-align: center;
      }
      .sg-eyebrow {
        margin: 0 0 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.4em;
        color: #b89e75;
        text-transform: uppercase;
      }
      .sg-title {
        margin: 0 0 1rem;
        font-family: 'Noto Serif TC', Georgia, serif;
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        color: #f5efe5;
      }
      .sg-hint {
        margin: 0 auto 2rem;
        max-width: 22rem;
        font-size: 0.9rem;
        line-height: 1.8;
        color: rgba(245, 239, 229, 0.78);
        font-weight: 300;
      }
      .sg-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: rgba(245, 239, 229, 0.65);
        margin-bottom: 0.6rem;
        text-transform: uppercase;
        text-align: left;
      }
      #staging-pass {
        width: 100%;
        padding: 0.875rem 1rem;
        background: transparent;
        border: 1px solid rgba(184, 142, 92, 0.6);
        color: #f5efe5;
        font-size: 1rem;
        font-family: inherit;
        margin-bottom: 1.25rem;
        letter-spacing: 0.05em;
      }
      #staging-pass:focus {
        outline: none;
        border-color: #b89e75;
      }
      .sg-submit {
        width: 100%;
        padding: 0.95rem;
        background: transparent;
        color: #f5efe5;
        border: 1.5px solid #f5efe5;
        font-family: inherit;
        font-size: 0.875rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .sg-submit:hover {
        background: #f5efe5;
        color: #1a1411;
      }
      .sg-error {
        margin: 1rem 0 0;
        font-size: 0.8125rem;
        color: #d4948e;
        display: none;
      }
      .sg-error.show { display: block; }
      .sg-footer {
        margin: 2.5rem 0 0;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: rgba(245, 239, 229, 0.4);
      }
    </style>
  </body>
</html>
