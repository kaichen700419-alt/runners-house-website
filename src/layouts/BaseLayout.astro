---
/**
 * BaseLayout
 *
 * 站內所有頁面的最外層 layout。
 * 職責：
 *  - 組合 SEOHead、JsonLd、Header、Footer、<slot />
 *  - 自動套用語系（依路徑判斷）並設定 <html lang>
 *  - 可選 schema、breadcrumbs，由呼叫端決定要不要塞 LodgingBusiness 等
 *  - 預設一律輸出 WebSite schema
 */
import '@/styles/global.css';
import SEOHead from '@/components/seo/SEOHead.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { detectLocale } from '@/i18n/utils';
import { breadcrumbSchema, websiteSchema, type BreadcrumbItem } from '@/lib/schema';

interface Props {
  /** 完整 <title>，含品牌 */
  title: string;
  /** meta description */
  description: string;
  /** 自訂 OG 圖（相對或絕對 URL） */
  image?: string;
  /** 額外 schema 物件（例：lodgingBusinessSchema）。會自動加上 WebSite + Breadcrumb */
  schema?: Record<string, unknown> | ReadonlyArray<Record<string, unknown>>;
  /** 麵包屑陣列；提供時會自動產生 BreadcrumbList JSON-LD */
  breadcrumbs?: ReadonlyArray<BreadcrumbItem>;
  /** robots 指令 */
  robots?: string;
  /** OG 類型 */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  image,
  schema,
  breadcrumbs,
  robots,
  ogType,
} = Astro.props;

const pathname = Astro.url.pathname;
const locale = detectLocale(pathname);
const htmlLang = locale === 'en' ? 'en' : 'zh-Hant-TW';

// 組合所有 JSON-LD schema：WebSite 永遠輸出，Breadcrumb 和額外 schema 視 props 而定
const allSchemas: Record<string, unknown>[] = [
  websiteSchema(locale),
  ...(breadcrumbs?.length ? [breadcrumbSchema(breadcrumbs)] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead
      title={title}
      description={description}
      pathname={pathname}
      locale={locale}
      image={image}
      robots={robots}
      ogType={ogType}
    />
    <JsonLd schema={allSchemas} />
  </head>
  <body class="min-h-dvh">
    <Header pathname={pathname} locale={locale} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
